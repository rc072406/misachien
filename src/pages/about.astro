---
import BaseLayout from '../layouts/BaseLayout.astro'; 

import aboutImage from '../../public/images/IMG_4434.webp';
import TypeWriter3 from '../components/TypeWriter3.astro';
---

<BaseLayout title="About | Misa Chien">
  <main class="about-container" data-theme="start">
    
    <div class="about-gradient-wrapper">
      <section class="about-hero reveal-on-scroll">
        <span class="subtitle">The Story Behind The Work</span>
        <h1 class="main-title">
          Helping Asians Release <br class="desktop-only" />
          <span class="serif-italic">Scarcity Mindset</span>
        </h1>
      </section>

      <section class="about-content-grid">
        <div class="content-left reveal-on-scroll">
          <div class="about-image-wrapper">
            <div class="accent-border-box"></div>
            <img src={aboutImage.src} alt="Misa Chien portrait" class="visual-canvas-image" />
          </div>

          <div class="editorial-card">
            <p class="quote-text">
              “You are not alone.”
            </p>
            <div class="card-line"></div>
          </div>
        </div>

        <div class="content-right reveal-on-scroll">
          <h2 class="section-heading">Biography</h2>
          <div class="bio-text">
            <p>
              Misa Chien is an authentic leader who is known for inspiring others, and helps people feel less alone and more connected through positivity and transparency.
            </p>
            <p>
              Misa’s engaging and charismatic communication style stems from her experience through multiple forms of communication through being on TV, speaking at renowned institutions (Harvard Business School and The Harvard Club), and gracing the runway for brands such as Neutrogena and Target.
            </p>
            <p>Misa's exceptional leadership and entrepreneurial style have propelled her into high demand as a speaker, podcast host, television personality, and has even earned her the distinction of being ranked as the 23rd most viewed woman on LinkedIn worldwide and #1 most viewed Asian American woman nationwide with 16 million+ views per month.</p>
            <p>Her past speaking clients include Harvard Business School, UCLA, USC, and University of Washington. She has been featured in Inc. Magazine 30 under 30 entrepreneurs, Forbes Women to Watch, LinkedIn Top Voices, and as a serial entrepreneur on the Food Network’s Great Food Truck Race embarrassing herself in front of over 60 million viewers worldwide.</p>
            <p>In terms of her background as an entrepreneur, over the years Misa has founded several companies from food trucks to software that have reached 7 figures in revenue, a milestone that less than 2% of female entrepreneurs are able to achieve.</p>
            <p>As an Asian American female founder for 18+ years, Misa founded and launched The Authentic Asian in October 2023, an AAPI Female Leadership Community, to help AAPI Female Founders and C-Levels feel less alone and more connected.</p>
          </div>

          <div class="philosophies">
            <div class="philosophy-item">
              <span>01 / Core Mission</span>
              <p>Through Neuro-Linguistic Programming (NLP), Misa empowers individuals of Asian descent to dismantle deeply rooted limiting beliefs and immigrant scarcity mindsets. Offered across two specialized tracks, her work guides clients to reclaim their unconscious minds and step into authentic leadership. </p>
            </div>
            <div class="philosophy-item">
              <span>02 / Growth and Rest</span>
              <p>Misa helps entrepreneurs scale from $250k to $1 million through high-impact business strategy and mindset coaching. For C-level executives and late-stage founders, she provides a space to release immigrant scarcity mindsets, step back from burnout, and truly enjoy their hard-earned success.</p>
            </div>
          </div>
        </div>
      </section>
    </div>

    
      <TypeWriter3 client:visible />


  </main>
</BaseLayout>

<style>


  .about-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--white);
  }

  .about-gradient-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(
      to right, 
      #59363A 0%, 
      #59363A 6%, 
      #8A6266 25%,
      #BA9699 38%,
      #DFCDC9 48%,
      #FEF4EF 58%, 
      #FEF4EF 100%
    );
    padding: calc(6rem + 80px) 4rem 6rem 4rem; 
  }

  .about-gradient-wrapper::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    opacity: 0.025; 
    pointer-events: none;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='silk'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23silk)'/%3E%3C/svg%3E");
  }

  .about-hero {
    max-width: 1200px;
    margin: 0 auto 6rem auto;
    color: var(--white);
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7); 
    display: block;
    margin-bottom: 1rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
    color: var(--coral);
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: #DFCDC9; 
  }

  .about-content-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .content-left {
    display: flex;
    flex-direction: column;
    gap: 3.5rem; 
  }

  .about-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    margin-bottom: 1rem;
  }

  .accent-border-box {
    position: absolute;
    inset: 0;
    border: 1px solid var(--white);
    transform: translate(20px, 20px);
    z-index: 1;
    opacity: 0.4;
  }

  .visual-canvas-image {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover; 
    border: 1px solid rgba(255, 255, 255, 0.15);
    z-index: 2;
  }

  .editorial-card {
    background-color: rgba(255, 255, 255, 0.03); 
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem;
    position: relative;
    color: var(--white);
    max-width: 480px;
  }

  .quote-text {
    font-family: 'GF Didot', serif;
    font-size: 1.8rem;
    line-height: 1.5;
    font-weight: 400;
    margin: 0;
  }

  .quote-text em {
    font-style: italic;
    color: #DFCDC9;
  }

  .card-line {
    width: 40px;
    height: 1px;
    background-color: var(--white);
    margin-top: 2rem;
  }

  .content-right {
    color: var(--burgundy); 
  }

  .section-heading {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    margin-top: 0;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  .bio-text p {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .philosophies {
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    border-top: 1px solid rgba(89, 54, 58, 0.15);
    padding-top: 2.5rem;
  }

  .philosophy-item span {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--coral);
    display: block;
    margin-bottom: 0.5rem;
  }

  .philosophy-item p {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.6;
  }


  .desktop-only {
    display: block;
  }

  @media (max-width: 820px) {
    .about-gradient-wrapper {
      background: linear-gradient(
        to bottom, 
        #59363A 0%, 
        #59363A 22%, 
        #8A6266 40%,
        #BA9699 55%,
        #DFCDC9 70%,
        #FEF4EF 85%, 
        #FEF4EF 100%
      );
      padding: calc(5rem + 70px) 1.5rem 5rem 1.5rem;
    }


    .desktop-only {
      display: none;
    }

    .about-hero {
      text-align: center;
      margin-bottom: 4rem;
    }

    .subtitle {
      color: rgba(255, 255, 255, 0.7);
    }

    .main-title {
      font-size: 2.75rem;
    }

    .about-content-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .content-left {
      align-items: center;
    }

    .about-image-wrapper {
      max-width: 420px;
    }

    .accent-border-box {
      transform: translate(12px, 12px); 
      border-color: var(--white);
    }

    .editorial-card {
      padding: 2rem;
      max-width: 420px;
      text-align: center;
    }

    .card-line {
      margin: 2rem auto 0 auto;
    }

    .quote-text {
      font-size: 1.45rem;
    }

    .content-right {
      color: var(--burgundy);
      text-align: center;
    }

    .philosophies {
      text-align: left; 
    }
  }
</style>
