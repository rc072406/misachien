---
// src/pages/about.astro
import Layout from '../layouts/BaseLayout.astro'; 
---

<BaseLayout title="About | Misa Chien">
  <main class="about-container" data-theme="light">
    
    <section class="about-hero reveal-on-scroll">
      <span class="subtitle">The Story Behind The Work</span>
      <h1 class="main-title">
        Helping Asians Release
        <span class="serif-italic">Scarcity Mindset</span>
      </h1>
    </section>

    <section class="about-content-grid">
      
      <div class="content-left reveal-on-scroll">
        <div class="editorial-card">
          <p class="quote-text">
            “UHXUSDGHUDHS
            <em>structure</em> and clarity coming together on a screen.”
          </p>
          <div class="card-line"></div>
        </div>
      </div>

      <div class="content-right reveal-on-scroll">
        <h2 class="section-heading">Biography</h2>
        <div class="bio-text">
          <p>
            Based at the intersection of minimalist design and intentional frontend architecture, 
            I build digital experiences that feel as tangible as physical media. Every project is approached 
            with a deep appreciation for geometric balance, clean layouts, and micro-interactions.
          </p>
          <p>
            By focusing heavily on performance, rendering mechanics, and flawless cross-browser execution, 
            I transform complex codebases into smooth, high-end editorial experiences that captivate users 
            the moment they land above the fold.
          </p>
        </div>

        <div class="philosophies">
          <div class="philosophy-item">
            <span>01 / filler</span>
            <p> Filler</p>
          </div>
          <div class="philosophy-item">
            <span>02 / Filler</span>
            <p>Filler</p>
          </div>
        </div>
      </div>

    </section>
  </main>
</BaseLayout>

<style>
  .about-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: #FEF4EF; 
    color: #59363A; 
    padding: 12rem 4rem 6rem 4rem;
    box-sizing: border-box;
    overflow: hidden;
  }

  
  .about-container::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    opacity: 0.025; 
    pointer-events: none;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='silk'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23silk)'/%3E%3C/svg%3E");
  }

 
  .about-hero {
    max-width: 1200px;
    margin: 0 auto 6rem auto;
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    color: var(--coral, #BA9699);
    display: block;
    margin-bottom: 1rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: var(--coral, #BA9699);
  }

  /* --- Layout Grid --- */
  .about-content-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  /* --- Left Editorial Card --- */
  .editorial-card {
    background-color: rgba(89, 54, 58, 0.03); 
    border: 1px solid rgba(89, 54, 58, 0.08);
    padding: 3rem;
    position: relative;
  }

  .quote-text {
    font-family: 'GF Didot', serif;
    font-size: 1.8rem;
    line-height: 1.5;
    font-weight: 400;
    margin: 0;
  }

  .quote-text em {
    font-style: italic;
    color: var(--coral, #BA9699);
  }

  .card-line {
    width: 40px;
    height: 1px;
    background-color: #59363A;
    margin-top: 2rem;
  }

  /* --- Right Narrative Column --- */
  .section-heading {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    margin-top: 0;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  .bio-text p {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  /* --- Philosophy Section --- */
  .philosophies {
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    border-top: 1px solid rgba(89, 54, 58, 0.15);
    padding-top: 2.5rem;
  }

  .philosophy-item span {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--coral, #BA9699);
    display: block;
    margin-bottom: 0.5rem;
  }

  .philosophy-item p {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.6;
  }

  /* --- Responsive Breakpoints --- */
  @media (max-width: 960px) {
    .about-container {
      padding: 10rem 2rem 4rem 2rem;
    }

    .main-title {
      font-size: 3.25rem;
    }

    .about-content-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .editorial-card {
      padding: 2rem;
    }

    .quote-text {
      font-size: 1.5rem;
    }
  }
</style>
