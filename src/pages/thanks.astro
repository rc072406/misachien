---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Thank You | Contact Misa Chien";
const pageDescription = "Release your scarcity mindset with professional coach Misa Chien. Break through subconscious ceilings, heal emotional loops, and shift from survival to abundance.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="thank-you-section">
    <div class="thank-you-container">
      <h1>Thank You.</h1>
      <p>Talk soon</p>
    <a href="/index" target="_blank" class="cta-link-text">
          <span>Back Home &rarr;</span>
        </a>
    </div>
  </main>
</BaseLayout>

<style>
  :root {
    --text-primary: #59363B;
    --text-muted: #6B4E52;
    --bg-solid-light: #FBF9F6;
    --font-serif: 'Libre Baskerville', serif;
    --font-sans: 'Helvetica Neue', 'Inter', sans-serif;
  }

  .thank-you-section {
    width: 100%;
    background-color: var(--bg-solid-light);
    padding: 10rem 2rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }
.cta-link-text {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-decoration: none;
    color: var(--text-primary);
    background-color: #FFFFFF;
    padding: 1.25rem 2.5rem;
    border: 1px solid #FFFFFF;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .cta-link-text:hover {
    background-color: transparent;
    color: #FFFFFF;
    border-color: #FFFFFF;
  }

  .thank-you-container {
    max-width: 600px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.5px;
  }

  p {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.6;
    font-weight: 400;
    color: var(--text-muted);
    margin: 0;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .thank-you-section {
      padding: 6rem 1.5rem;
      min-height: auto;
    }
  .cta-link-text {
      display: inline-block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    p {
      font-size: 1rem;
    }
  }
</style>
