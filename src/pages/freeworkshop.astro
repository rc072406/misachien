---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
const workshopVideoUrl = import.meta.env.PUBLIC_YOUTUBE_URL || "fallback-url";
---

<BaseLayout title="Free Workshop | Misa Chien">
  <main class="workshop-container" data-theme="start">
    <div class="workshop-gradient-wrapper">
      
      <div class="workshop-grid" id="main-grid">
        
        <section class="workshop-hero reveal-on-scroll">
          <span class="subtitle">Exclusive Training</span>
          <h1 class="main-title">
            Master Your <br class="desktop-only" />
            <span class="serif-italic">Unconscious Mind</span>
          </h1>
          <p class="hero-description">
            Enter your name and email to get instant access to the free workshop and discover how to dismantle deeply rooted limiting beliefs.
          </p>
        </section>

        <section class="form-section reveal-on-scroll" id="opt-in-section">
          <h3 class="form-heading">Access The Workshop</h3>
          <form id="workshop-form" class="optin-form">
            <div class="input-group">
              <label for="fullName">Full Name</label>
              <input type="text" id="fullName" name="fullName" required placeholder="Jane Doe" />
            </div>
            <div class="input-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="jane@example.com" />
            </div>
            <button type="submit" class="btn-filled form-submit-btn"><span>Watch Workshop Now</span></button>
          </form>
        </section>
        
      </div>

      <section class="hidden-content" id="video-section" style="display: none;">
        
        <div class="video-container reveal-on-scroll">
         <iframe 
  src={workshopVideoUrl} 
  title="YouTube video player" 
  frameborder="0" 
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
  referrerpolicy="strict-origin-when-cross-origin"
  allowfullscreen
></iframe>
        </div>

        <section class="funnel-coaching-cta reveal-on-scroll" id="interactive-banner">
          <div class="funnel-visual-accent"></div>
          
          <div class="funnel-content-left">
            <span class="funnel-pre-title">Exclusive Invitation</span>
            <h2 class="funnel-accent-text">Let's Dive Deeper</h2>
          </div>
          
          <div class="funnel-actions-right">
            <p class="funnel-supporting-text">
              If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="dark-highlight">Clarity Call</strong> to map out your blind spots.
            </p>
            <a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="btn-filled banner-btn"><span>Book Your Clarity Call →</span></a>
          </div>
        </section>

      </section>
    </div>
    <TypeWriter3 />
  </main>
</BaseLayout>

<style>
  /* --- Layout & Background --- */
  .workshop-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--white);
  }

  .workshop-gradient-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background: linear-gradient(
      to right, 
      #59363A 0%, 
      #59363A 6%, 
      #8A6266 25%,
      #BA9699 38%,
      #DFCDC9 48%,
      #FEF4EF 58%, 
      #FEF4EF 100%
    );
    padding: calc(6rem + 80px) 4rem 6rem 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* --- Two Column Grid Configuration --- */
  .workshop-grid {
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 6rem;
    align-items: center;
  }

  /* --- Left Side Typography (Light Text) --- */
  .workshop-hero {
    text-align: left;
    color: var(--white);
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    display: block;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 4rem;
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--coral);
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: #DFCDC9; 
  }

  .hero-description {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--white);
    opacity: 0.9;
    max-width: 520px;
  }
.video-container iframe {
  width: 100%;
  height: 100%;
  border: none;
}

  /* --- Right Side Burgundy Form Theme --- */
  .form-section {
    width: 100%;
    padding: 3.5rem 3rem;
    background-color: rgba(89, 54, 58, 0.05); 
    border: 1px solid rgba(89, 54, 58, 0.15);
  }

  .form-heading {
    font-family: 'Tenor Sans', sans-serif;
    color: var(--burgundy);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2rem;
  }

  .optin-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.8rem;
    color: var(--burgundy);
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .input-group input {
    font-family: 'Poppins', sans-serif;
    padding: 1.1rem;
    background: transparent;
    border: 1px solid rgba(89, 54, 58, 0.25);
    color: var(--burgundy);
    font-size: 1rem;
    transition: border-color 0.3s ease;
  }

  .input-group input:focus {
    outline: none;
    border-color: var(--coral);
  }

  .input-group input::placeholder {
    color: rgba(89, 54, 58, 0.4);
  }

  .form-submit-btn {
    margin-top: 1rem;
    width: 100%;
    text-align: center;
    border-color: var(--burgundy) !important;
    color: var(--burgundy) !important;
  }
  .form-submit-btn::before {
    background-color: var(--burgundy) !important;
  }
  .form-submit-btn:hover {
    color: var(--white) !important;
    border-color: var(--burgundy) !important;
  }

  /* --- Video & Funnel Content (Post-Submission) --- */
  .hidden-content {
    width: 100%;
    max-width: 900px;
    margin-top: 2rem;
  }

  .video-container {
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-placeholder {
    text-align: center;
    color: var(--white);
    opacity: 0.6;
  }

  .video-text {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  /* --- UPGRADED FUNNEL CONTAINER --- */
  .funnel-coaching-cta {
    background: linear-gradient(135deg, #3A2023 0%, var(--burgundy) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4.5rem 4rem;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.4);
  }

  .funnel-visual-accent {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(223, 205, 201, 0.08) 0%, rgba(0,0,0,0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .funnel-content-left, .funnel-actions-right {
    position: relative;
    z-index: 2;
  }

  .funnel-pre-title {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--coral);
    margin-bottom: 1rem;
  }

  .funnel-accent-text {
    font-family: 'GF Didot', serif;
    font-style: italic;
    font-size: 2.35rem;
    color: #FEF4EF;
    line-height: 1.3;
    margin: 0;
  }

  .funnel-actions-right {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 4rem;
  }

  .funnel-supporting-text {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .dark-highlight {
    font-weight: 500;
    color: var(--coral);
  }

  .funnel-coaching-cta .btn-filled {
    align-self: flex-start;
    width: auto;
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .funnel-coaching-cta .btn-filled span {
    color: var(--coral);
    transition: color 0.4s ease;
  }

  .funnel-coaching-cta .btn-filled:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
  }

  .funnel-coaching-cta .btn-filled:hover span {
    color: var(--white);
  }

  /* --- Responsive Styles --- */
  @media (max-width: 992px) {
    .workshop-grid {
      gap: 3rem;
    }
    .main-title {
      font-size: 3.2rem;
    }
  }

  @media (max-width: 820px) {
    .workshop-gradient-wrapper {
      background: linear-gradient(
        to bottom, 
        #59363A 0%, 
        #59363A 22%, 
        #8A6266 40%,
        #BA9699 55%,
        #DFCDC9 70%,
        #FEF4EF 85%, 
        #FEF4EF 100%
      );
      padding: calc(5rem + 70px) 1.5rem 5rem 1.5rem;
    }

    .workshop-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .desktop-only {
      display: none;
    }

    .workshop-hero {
      text-align: left;
    }

    .main-title {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .form-section {
      padding: 2.5rem 2rem;
    }

    /* Upgraded Funnel Responsive Code Integration */
    .funnel-coaching-cta {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3.5rem 2rem;
      text-align: left;
    }

    .funnel-accent-text {
      font-size: 1.85rem;
    }

    .funnel-actions-right {
      border-left: none;
      padding-left: 0;
      gap: 1.5rem;
    }
    
    #quiz-intro .btn-filled,
    .funnel-coaching-cta .btn-filled {
      display: block;
      align-self: stretch;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('workshop-form');
    const mainGrid = document.getElementById('main-grid');
    const videoSection = document.getElementById('video-section');

    if (form && mainGrid && videoSection) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();


        mainGrid.style.display = 'none';
        
       
        videoSection.style.display = 'block';
        videoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

        setTimeout(() => {
          const reveals = videoSection.querySelectorAll('.reveal-on-scroll');
          reveals.forEach(el => {
            el.classList.add('is-visible');
          });
        }, 50);
      });
    }
  });
</script>
