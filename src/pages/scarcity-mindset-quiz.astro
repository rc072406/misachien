---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';

const pageTitle = "Scarcity Mindset Quiz: Subconscious Assessment | Misa Chien";
const pageDescription = "Take the 10-question Scarcity Mindset Quiz by Misa Chien. Discover your subconscious blocks, identify survival loops, and assess your alignment with authentic leadership.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;


const quizSchema = {
  "@context": "https://schema.org",
  "@type": "Quiz",
  "name": "Scarcity Mindset Quiz",
  "description": pageDescription,
  "url": canonicalURL,
  "educationalAlignment": {
    "@type": "AlignmentObject",
    "educationalFramework": "Mindset Coaching & Subconscious Reprogramming",
    "targetName": "Self-Awareness & Leadership Growth"
  },
  "author": {
    "@type": "Person",
    "name": "Misa Chien",
    "url": "https://misachien.com"
  },
  "assesses": "Scarcity mindset patterns, limiting behaviors, subconscious boundaries"
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(quizSchema)} />
  <main class="quiz-page-container">
    
    <section id="quiz-intro-section" class="quiz-view-section active" data-theme="start">
  <div id="quiz-intro" class="quiz-screen active">
    <div class="intro-grid reveal-on-scroll">
      
      <div class="intro-content-left">
        <span class="subtitle">DISCOVER YOUR PATTERNS</span>
        <h1 class="intro-title">
          Mindset <br />
          <span class="serif-italic">Assessment</span>
        </h1>
        <h2 class="intro-subtitle-serif">Do you have a scarcity mindset?</h2>
        
        <p class="intro-description">
          Answer honestly. No one's grading you — <br class="desktop-only" />
          except your own nervous system.
        </p>

        <div class="typewriter-box">
          <span class="typewriter-label">Current Assessment:</span>
          <span id="quiz-typewriter" class="typewriter-text"></span>
         
        </div>
      </div>

      <div class="intro-content-right">
        <div class="start-card">
          <div class="card-content">
             <p class="card-hint">Ready to begin your journey toward authentic leadership?</p>
             <button id="start-quiz-btn" class="quiz-action-btn-large">
               <span>Start The Assessment</span>
             </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

    <section id="quiz-gameplay-section" class="quiz-view-section" data-theme="light">
      <div id="quiz-gameplay" class="quiz-screen">
        <div class="quiz-top-bar">
          <span id="question-counter" class="counter-text">QUESTION 1 OF 10</span>
          <div id="progress-dots" class="dots-container"></div>
        </div>

        <div class="question-card-container">
          <div id="question-text-box" class="question-prompt-box"></div>

          <div class="options-wrapper">
            <button class="option-row type-a" data-choice="A">
              <span class="option-badge">A</span>
              <p class="option-text"></p>
            </button>
            <button class="option-row type-b" data-choice="B">
              <span class="option-badge">B</span>
              <p class="option-text"></p>
            </button>
            <button class="option-row type-c" data-choice="C">
              <span class="option-badge">C</span>
              <p class="option-text"></p>
            </button>
          </div>

          <div id="scarcity-feedback-box" class="scarcity-signal-panel">
            <span class="signal-highlight">💡 Scarcity signal:</span>
            <p id="feedback-text" class="signal-desc"></p>
          </div>
        </div>

        <div class="quiz-navigation">
          <button id="next-question-btn" class="quiz-action-btn hidden">
            <span>Next Question</span>
          </button>
        </div>
      </div>
    </section>

    <section id="quiz-results-section" class="quiz-view-section" data-theme="dark">
      <div id="quiz-results" class="quiz-screen">
        <div class="results-inner-container">
          <h2 class="results-title">HOW DID YOU SCORE?</h2>
          <p class="results-meta">Reflect on how many B or C answers you chose.</p>

          <div class="score-tiers-stack">
            <div class="tier-card tier-0-2" data-tier="abundance">
              <div class="tier-score-badge">0–2</div>
              <div class="tier-details">
                <h3>Abundance Oriented</h3>
                <p>You've largely broken free. Stay conscious — it can creep back under stress.</p>
              </div>
            </div>

            <div class="tier-card tier-3-5" data-tier="selective">
              <div class="tier-score-badge">3–5</div>
              <div class="tier-details">
                <h3>Selective Scarcity</h3>
                <p>You have pockets of scarcity thinking. Great self-awareness potential here.</p>
              </div>
            </div>

            <div class="tier-card tier-6-8" data-tier="dominant">
              <div class="tier-score-badge">6–8</div>
              <div class="tier-details">
                <h3>Scarcity Dominant</h3>
                <p>It's running much of your decision-making. This is the work to do.</p>
              </div>
            </div>

            <div class="tier-card tier-9-10" data-tier="survival">
              <div class="tier-score-badge">9–10</div>
              <div class="tier-details">
                <h3>Deep Survival Mode</h3>
                <p>You're still protecting a version of yourself that no longer needs protecting. Healing is possible.</p>
              </div>
            </div>
          </div>

          <p class="verdict-footer">Every point is a doorway, not a verdict.</p>

          <div class="transformation-matrix">
            <div class="matrix-header">BREAKING FREE: FROM SCARCITY TO ABUNDANCE</div>
            <div class="matrix-body">
              <div class="matrix-row">
                <div class="shift-from">"My work speaks for itself"</div>
                <div class="shift-arrow">→</div>
                <div class="shift-to">Make your work visible. Advocate for yourself.</div>
              </div>
              <div class="matrix-row">
                <div class="shift-from">"That coach is too expensive"</div>
                <div class="shift-arrow">→</div>
                <div class="shift-to">Ask: what is NOT investing actually costing me?</div>
              </div>
              <div class="matrix-row">
                <div class="shift-from">"I can't take that risk"</div>
                <div class="shift-arrow">→</div>
                <div class="shift-to">Reframe: what is the cost of NOT taking it?</div>
              </div>
              <div class="matrix-row">
                <div class="shift-from">"There's only one seat for us"</div>
                <div class="shift-arrow">→</div>
                <div class="shift-to">Lift as you climb. Build tables, not queues.</div>
              </div>
              <div class="matrix-row">
                <div class="shift-from">"I must be practical"</div>
                <div class="shift-arrow">→</div>
                <div class="shift-to">Passion and mission are also valid currencies.</div>
              </div>
            </div>
          </div>

        <div class="funnel-coaching-cta">
  <div class="funnel-visual-accent"></div>
  
  <div class="funnel-content-left">
    <span class="funnel-pre-title">THE NEXT SHIFT</span>
    <p class="funnel-accent-text">Ready to Work With Misa?</p>
  </div>
  
  <div class="funnel-actions-right">
    <p class="funnel-supporting-text">
      Awareness is only step one. Break through the invisible ceiling holding your happiness, pricing, team scaling, and operational boundaries back.
    </p>
    <a href="https://ut9kw2xefxf.typeform.com/to/JgPoLbVE" target="_blank" class="btn-filled funnel-cta-button">
      <span>Apply For Growth Alignment →</span>
    </a>
  </div>
</div>
    </section>

  </main>
  <TypeWriter3 />
</BaseLayout>

<script>
  const quizData = [
    {
      question: "You need to park downtown for an important meeting. There's a $9 lot right next to the building. What do you do?",
      choices: {
        A: "Pay the $9 — my time is worth more.",
        B: "Drive around looking for free street parking, even if it takes 20 minutes.",
        C: "Spend 10 minutes on an app finding a $6 spot three blocks away."
      },
      signal: "B & C signal scarcity — you're trading time, stress, and opportunity to save a few dollars."
    },
    {
      question: "A coach who specializes in board placements charges $500/session. You want a board seat. What do you think?",
      choices: {
        A: "That's an investment — a board seat is worth 100x that.",
        B: "That's a lot of money. I can figure it out on my own.",
        C: "Maybe later, when I feel more ready."
      },
      signal: "B & C reflect scarcity — letting a small cost block a large opportunity."
    },
    {
      question: "You are setting pricing configurations for your professional services. You realize your baseline rates are below market standards. You:",
      choices: {
        A: "Raise rates immediately to match output value metrics.",
        B: "Keep rates low because you fear losing existing clients.",
        C: "Offer arbitrary discounts before the prospect even fields pricing questions."
      },
      signal: "B & C reflect low pricing tolerances born from a persistent fear of losing transaction pipelines."
    },
    {
      question: "A critical operations bottleneck emerges. You have capital to outsource it, but you're working 70 hours a week instead. Why?",
      choices: {
        A: "I will hire a specialized expert immediately to trade money for operational focus.",
        B: "No one can duplicate my operational standard, so I have to keep running it.",
        C: "It is safer to conserve liquid capital reserves right now."
      },
      signal: "B & C show tactical labor hoarding caused by mistrusting scale frameworks."
    },
    {
      question: "An industry colleague requests a discovery conversation regarding your operational tool stacks. You feel:",
      choices: {
        A: "Expansive. Strategic resource sharing opens broader industry alignments.",
        B: "Guarded. If they optimize their operations, they could undercut my market share.",
        C: "Neutral, but you intentionally omit critical details to maintain an advantage."
      },
      signal: "B & C flag zero-sum frameworks rooted in the illusion that market opportunities are strictly finite."
    },
    {
      question: "Another Asian American in your industry gets a big feature in a major publication. You feel:",
      choices: {
        A: "Inspired — if they can do it, so can I.",
        B: "A little threatened — there's only so much room for 'us.'",
        C: "Happy for them, but quietly wonder why not me."
      },
      signal: "B signals zero-sum scarcity thinking. C can too, if it comes from comparison rather than aspiration."
    },
    {
      question: "You're offered a leadership role that involves public speaking and high visibility. You think:",
      choices: {
        A: "This is a great chance to grow and be seen.",
        B: "I'm not sure I'm ready — I should wait until I know more.",
        C: "What if I fail publicly? Better to stay in a role I've mastered."
      },
      signal: "B & C reveal scarcity-rooted fear of visibility — a key reason Asian Americans hit the bamboo ceiling."
    },
    {
      question: "You want to switch to a more fulfilling career. Your income would temporarily drop 20%. You:",
      choices: {
        A: "Make a plan and go for it — a 20% dip is temporary.",
        B: "It's too risky — what if it doesn't work out?",
        C: "Feel guilty — my parents sacrificed so much for my stability."
      },
      signal: "B & C are scarcity patterns — risk aversion and survivor's guilt keeping you from your own life."
    },
    {
      question: "You hate your job and dread going in every day. A friend recommends a program by a successful career coach that could change everything — but it costs $4,000. You:",
      choices: {
        A: "Invest in it. Staying miserable costs more than $4K.",
        B: "It's too expensive. I'll figure it out on my own.",
        C: "I'll wait and see if things get better on their own."
      },
      signal: "B & C are scarcity patterns — putting a price tag on your happiness and betting on a future that never changes itself."
    },
    {
      question: "Your business just crossed $100K. You're maxed out on capacity. What do you do?",
      choices: {
        A: "Hire a VA or delegate — my time is worth more than what it costs.",
        B: "Keep doing the same thing. I don't want to spend money on hiring.",
        C: "Think about hiring a VA but keep putting it off — it feels like a big expense."
      },
      signal: "B & C are scarcity in action — refusing to invest in growth keeps you at the same ceiling."
    }
  ];

  let currentQuestionIndex = 0;
  let scarcityScore = 0;

  const introSection = document.getElementById('quiz-intro-section');
  const gameplaySection = document.getElementById('quiz-gameplay-section');
  const resultsSection = document.getElementById('quiz-results-section');

  const introScreen = document.getElementById('quiz-intro');
  const gameplayScreen = document.getElementById('quiz-gameplay');
  const resultsScreen = document.getElementById('quiz-results');
  
  const startBtn = document.getElementById('start-quiz-btn');
  const nextBtn = document.getElementById('next-question-btn');
  const counterText = document.getElementById('question-counter');
  const progressDotsContainer = document.getElementById('progress-dots');
  const questionTextBox = document.getElementById('question-text-box');
  const feedbackBox = document.getElementById('scarcity-feedback-box');
  const feedbackText = document.getElementById('feedback-text');
  const optionButtons = document.querySelectorAll('.option-row');

  function syncNavbarTheme(targetTheme) {
    const navbar = document.querySelector('.navbar');
    if (!navbar) return;
    navbar.classList.remove('navbar--start', 'navbar--light', 'navbar--dark');
    navbar.classList.add(`navbar--${targetTheme}`);
  }

  startBtn?.addEventListener('click', () => {
    introSection?.classList.remove('active');
    introScreen?.classList.remove('active');
    
    gameplaySection?.classList.add('active');
    gameplayScreen?.classList.add('active');
    
    syncNavbarTheme('light');
    window.scrollTo({ top: 0 });

    buildProgressDots();
    loadQuestion(currentQuestionIndex);
  });

  function buildProgressDots() {
    if (!progressDotsContainer) return;
    progressDotsContainer.innerHTML = '';
    quizData.forEach((_, index) => {
      const dot = document.createElement('span');
      dot.className = `progress-dot ${index === 0 ? 'active' : ''}`;
      progressDotsContainer.appendChild(dot);
    });
  }

  function loadQuestion(index) {
    if (index >= quizData.length) {
      showResults();
      return;
    }

    feedbackBox?.classList.remove('visible');
    nextBtn?.classList.add('hidden');

    const currentData = quizData[index];
    if (counterText) counterText.textContent = `QUESTION ${index + 1} OF ${quizData.length}`;
    if (questionTextBox) questionTextBox.textContent = currentData.question;

    optionButtons.forEach(btn => {
      btn.classList.remove('selected', 'disabled');
      const choiceAttr = btn.getAttribute('data-choice');
      const textNode = btn.querySelector('.option-text');
      if (textNode && choiceAttr) {
        textNode.textContent = currentData.choices[choiceAttr];
      }
    });

    const dots = document.querySelectorAll('.progress-dot');
    dots.forEach((dot, dIdx) => {
      if (dIdx <= index) dot.classList.add('active');
      else dot.classList.remove('active');
    });
  }

  optionButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      if (button.classList.contains('disabled')) return;

      const selectedChoice = button.getAttribute('data-choice');
      button.classList.add('selected');
      
      optionButtons.forEach(btn => btn.classList.add('disabled'));

      if (selectedChoice === 'B' || selectedChoice === 'C') {
        scarcityScore++;
      }

      if (feedbackText && feedbackBox) {
        feedbackText.textContent = quizData[currentQuestionIndex].signal;
        feedbackBox.classList.add('visible');
      }

      nextBtn?.classList.remove('hidden');
    });
  });

  nextBtn?.addEventListener('click', () => {
    currentQuestionIndex++;
    loadQuestion(currentQuestionIndex);
  });

  function showResults() {
    gameplaySection?.classList.remove('active');
    gameplayScreen?.classList.remove('active');
    
    resultsSection?.classList.add('active');
    resultsScreen?.classList.add('active');

    syncNavbarTheme('dark');
    window.scrollTo({ top: 0 });

    let targetedTier = 'abundance';
    if (scarcityScore >= 3 && scarcityScore <= 5) targetedTier = 'selective';
    else if (scarcityScore >= 6 && scarcityScore <= 8) targetedTier = 'dominant';
    else if (scarcityScore >= 9) targetedTier = 'survival';

    const cards = document.querySelectorAll('.tier-card');
    cards.forEach(card => {
      if (card.getAttribute('data-tier') === targetedTier) {
        card.classList.add('highlighted');
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        card.classList.add('dimmed');
      }
    });
  }

const phrases = ["10 questions.", "No need to count.", "Score at the end."];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const typingSpeed = 100;
  const deletingSpeed = 50;
  const pauseTime = 2000;

  function type() {
    const currentPhrase = phrases[phraseIndex];
    const displayTarget = document.getElementById("quiz-typewriter");
    
    if (isDeleting) {
      displayTarget.textContent = currentPhrase.substring(charIndex, 0);
      charIndex--;
    } else {
      displayTarget.textContent = currentPhrase.substring(0, charIndex);
      charIndex++;
    }

    if (!isDeleting && charIndex > currentPhrase.length) {
      isDeleting = true;
      setTimeout(type, pauseTime);
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      setTimeout(type, 500);
    } else {
      setTimeout(type, isDeleting ? deletingSpeed : typingSpeed);
    }
  }

 
  document.addEventListener('DOMContentLoaded', () => {
    if (document.getElementById("quiz-typewriter")) {
      type();
    }
  });
</script>

<style>

  :root {
    --bg-canvas: #FBF9F6;      
    --text-main: #1A1A1A;      
    --text-muted: #5E5A56;     
    --luxury-gold: #8C7E6D;    
    --ui-border: #EAE5E0;      
    
    --font-serif: 'Libre Baskerville', serif;
    --font-sans: 'Inter', 'Helvetica Neue', sans-serif;
  }

  .quiz-page-container {
    width: 100%;
    max-width: 100vw;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--bg-canvas);
    color: var(--text-main);
    overflow-x: hidden;
  }


  .quiz-view-section {
    display: none;
    width: 100%;
  }
  .quiz-view-section.active {
    display: block;
  }

  .quiz-screen {
    max-width: 1200px;
    margin: 0 auto;
    padding: 10rem 4rem 6rem 4rem;
    box-sizing: border-box;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    color: var(--luxury-gold);
    display: block;
    margin-bottom: 1.5rem;
  }

  .intro-title {
    font-family: var(--font-serif);
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0 0 1.5rem 0;
    letter-spacing: -1px;
  }

  .serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: none;
    color: var(--luxury-gold);
    letter-spacing: 0;
  }

  .intro-subtitle-serif {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .intro-description {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0 0 3.5rem 0;
  }


  .quiz-meta-ribbon {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: transparent;
    border-left: 2px solid var(--luxury-gold);
    padding: 0.5rem 0 0.5rem 1.5rem;
  }

  .ribbon-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ribbon-num {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--text-main);
    font-weight: bold;
  }

  .ribbon-txt {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  .ribbon-divider {
    width: 1px;
    height: 25px;
    background-color: var(--ui-border);
  }


  .start-card {
    border: 1px solid var(--ui-border);
    background: #FFFFFF;
    padding: 3.5rem;
    box-sizing: border-box;
  }

  .card-hint {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-main);
    margin-bottom: 2.5rem;
  }

  .quiz-action-btn-large {
    width: 100%;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: none;
    background-color: var(--text-main);
    color: #FFFFFF;
    padding: 1.25rem 2rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
    border-radius: 0 !important;
  }

  .quiz-action-btn-large:hover {
    opacity: 0.9;
  }


  #quiz-gameplay-section .quiz-screen {
    max-width: 800px;
    padding-top: 8rem;
  }

  .quiz-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ui-border);
    padding-bottom: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .counter-text {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--luxury-gold);
  }

  .dots-container {
    display: flex;
    gap: 0.4rem;
  }

  .progress-dot {
    width: 6px;
    height: 6px;
    background-color: #E2DDD5;
    transition: background-color 0.3s ease;
  }

  .progress-dot.active {
    background-color: var(--text-main);
  }

  .question-prompt-box {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1.5;
    color: var(--text-main);
    margin-bottom: 3rem;
  }

  .options-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .option-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    padding: 1.25rem 1.75rem;
    background-color: #FFFFFF;
    border: 1px solid var(--ui-border);
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
    border-radius: 0 !important;
  }

  .option-row:hover:not(.disabled) {
    border-color: var(--text-main);
  }

  .option-badge {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: bold;
    width: 24px;
    height: 24px;
    border: 1px solid var(--ui-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .option-text {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
    color: var(--text-main);
  }


  .option-row.selected {
    background-color: var(--text-main);
    border-color: var(--text-main);
  }
  .option-row.selected .option-text {
    color: #FFFFFF;
  }
  .option-row.selected .option-badge {
    background-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    border-color: transparent;
  }

  .option-row.disabled {
    cursor: default;
  }


  .scarcity-signal-panel {
    display: none;
    margin-top: 2.5rem;
    background-color: #F6F3EE;
    border-left: 2px solid var(--luxury-gold);
    padding: 1.5rem 2rem;
  }
  .scarcity-signal-panel.visible {
    display: block;
  }

  .signal-highlight {
    font-family: var(--font-sans);
    font-weight: bold;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
