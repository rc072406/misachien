---
import BaseLayout from '../layouts/BaseLayout.astro'; 
import aboutImage from '../../public/images/misachien.webp';

const pageTitle = "About Misa Chien | Founder of The Authentic Asian";
const pageDescription = "Meet Misa Chien, a serial entrepreneur, speaker, and founder of The Authentic Asian. Ranked the #1 most viewed Asian American woman nationwide on LinkedIn.";

const shareImageURL = new URL(aboutImage.src, Astro.site ?? Astro.url).href;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Misa Chien",
  "url": "https://misachien.com",
  "image": shareImageURL,
  "jobTitle": "Founder & Executive Coach",
  "description": pageDescription,
  "knowsAbout": [
    "Entrepreneurship",
    "AAPI Leadership",
    "Executive Coaching",
    "Mindset Coaching"
  ],
  "founder": [
    {
      "@type": "Organization",
      "name": "The Authentic Asian",
      "foundingDate": "2023-10",
      "url": "https://theauthenticasian.com"
    },
    {
      "@type": "Organization",
      "name": "Nom Nom Truck",
      "url": "https://misachien.com/what-happened-to-nom-nom-truck"
    }
  ],
  "sameAs": [
    "https://www.linkedin.com/in/misachien"
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={aboutImage.src}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  
  <main class="about-container">
    
    <section class="about-hero">
      <span class="subtitle">The Story Behind The Work</span>
      <h1 class="main-title">
        Helping Asians Release <br class="desktop-only" />
        <span class="serif-italic">Scarcity Mindset</span>
      </h1>
    </section>

    <section class="about-content-grid">
      <div class="content-left">
        <div class="about-image-wrapper">
          <img src={aboutImage.src} alt="Misa Chien portrait" class="visual-portrait" />
        </div>

        <div class="editorial-card">
          <p class="quote-text">
            “Embrace the journey, honor the process, and let the darts of your endeavors shape a path towards success.”
          </p>
        </div>
      </div>

      <div class="content-right">
        <h2 class="section-heading">Biography</h2>
        
        <div class="bio-text">
          <p>
            Misa Chien is an authentic leader who is known for inspiring others, and helps people feel less alone and more connected through positivity and transparency.
          </p>
          <p>
            Misa’s engaging and charismatic communication style stems from her experience through multiple forms of communication through being on TV, speaking at renowned institutions (Harvard Business School and The Harvard Club), and gracing the runway for brands such as Neutrogena and Target.
          </p>
          <p>
            Misa's exceptional leadership and entrepreneurial style have propelled her into high demand as a speaker, podcast host, television personality, and has even earned her the distinction of being ranked as the 23rd most viewed woman on LinkedIn worldwide and #1 most viewed Asian American woman nationwide with 16 million+ views per month.
          </p>
          <p>
            Her past speaking clients include Harvard Business School, UCLA, USC, and University of Washington. She has been featured in Inc. Magazine 30 under 30 entrepreneurs, Forbes Women to Watch, LinkedIn Top Voices, and as a serial entrepreneur on the Food Network’s Great Food Truck Race embarrassing herself in front of over 60 million viewers worldwide.
          </p>
          <p>
            In terms of her background as an entrepreneur, over the years Misa has founded several companies from food trucks to software that have reached 7 figures in revenue, a milestone that less than 2% of female entrepreneurs are able to achieve.
          </p>
          <p>
            As an Asian American female founder for 18+ years, Misa founded and launched The Authentic Asian in October 2023, an AAPI Female Leadership Community, to help AAPI Female Founders and C-Levels feel less alone and more connected.
          </p>
        </div>
      </div>
    </section>

    <section class="philosophies-fullwidth">
      <div class="philosophies-inner">
        <div class="philosophy-item">
          <h3 class="philosophy-title">Core Mission</h3>
          <p>Through helping clients speak to their unconscious mind, Misa empowers individuals of Asian descent to dismantle deeply rooted limiting beliefs and immigrant scarcity mindsets. Offered across two specialized tracks, her work guides clients to reclaim their unconscious minds and step into authentic leadership.</p>
        </div>
        
        <div class="philosophy-item">
          <h3 class="philosophy-title">Growth and Rest</h3>
          <p>Misa helps entrepreneurs scale from $250k to $1 million through high-impact business strategy and mindset coaching. For C-level executives and late-stage founders, she provides a space to release immigrant scarcity mindsets, step back from burnout, and truly enjoy their hard-earned success.</p>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :root {
    --bg-solid-light: #FBF9F6;   
    --text-primary: #59363B;    
    --text-muted: #6B4E52;        
    --accent-gold: #E7765D;      
    --text-serif: #8C7E6D;
    
    --font-serif: 'Libre Baskerville', serif;
    --font-sans: 'Helvetica Neue', 'Inter', sans-serif;
  }
  
  html, body {
    background-color: var(--bg-solid-light);
    margin: 0;
    padding: 0;
  }

  .about-container {
    width: 100%;
    min-height: 100vh;
    background-color: var(--bg-solid-light);
    color: var(--text-primary);
    padding: 10rem 2rem 0 2rem; 
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .about-hero {
    max-width: 1200px;
    margin: 0 auto 5rem auto;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-family: var(--font-serif);
    font-size: 3.8rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  .serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: none; 
    color: var(--text-serif);
    letter-spacing: 0;
  }

  .about-content-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .content-left {
    display: flex;
    flex-direction: column;
    gap: 4rem; 
  }

  .about-image-wrapper {
    position: relative;
    width: 100%;
  }

  .visual-portrait {
    width: 100%;
    height: auto;
    object-fit: cover; 
    display: block;
  }

  .editorial-card {
    border-left: 2px solid var(--accent-gold);
    padding: 0.5rem 0 0.5rem 2rem;
    max-width: 480px;
  }

  .quote-text {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    line-height: 1.6;
    font-weight: 400;
    color: var(--text-muted);
    margin: 0;
  }

  .content-right {
    display: flex;
    flex-direction: column;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-top: 0;
    margin-bottom: 2rem;
  }

  .bio-text p {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 1.8rem;
    color: var(--text-muted);
  }

  .philosophies-fullwidth {
    position: relative;
    box-sizing: border-box;
    background-color: #59363B;
    padding: 6rem 2rem 10rem 2rem; 
    margin-top: 6rem;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
  }

  .philosophies-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }

  .philosophy-title {
    font-family: var(--font-serif); 
    font-weight: 400;
    font-size: 1.8rem;
    color: #FBF9F6; 
    margin-top: 0;
    margin-bottom: 1.2rem;
  }

  .philosophy-item p {
    font-family: var(--font-sans); 
    font-weight: 400;
    font-size: 1.05rem;
    line-height: 1.8;
    color: #E2D9DA; 
    margin: 0;
  }

  .desktop-only {
    display: block;
  }

  @media (max-width: 900px) {
    .about-container {
      padding: 8rem 1.5rem 0 1.5rem; /* Removed bottom padding causing the gap */
    }
    
    .philosophies-fullwidth {
      padding: 4rem 1.5rem;
      margin-top: 4rem;
    }
    
    .philosophies-inner {
      grid-template-columns: 1fr; 
      gap: 3.5rem;
    }
    
    .philosophy-title {
      font-size: 1.6rem;
    }

    .desktop-only {
      display: none;
    }

    .main-title {
      font-size: 2.8rem;
    }

    .about-content-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .section-heading {
      font-size: 1.75rem;
    }
  }
</style>
