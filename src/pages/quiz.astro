---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
---

<BaseLayout title="Scarcity Mindset Quiz | Misa Chien">
  <main class="quiz-page-container">
    
    <div id="quiz-intro" class="quiz-screen active" data-theme="start">
      <div class="coaching-hero-gradient">
        <section class="coaching-hero">
          <span class="subtitle">Do you have a scarcity mindset?</span>
          <h1 class="main-title">
            QUIZ <span class="serif-italic">TIME</span>
          </h1>
          <p class="hero-intro">
            Answer honestly. No one's grading you — <br class="desktop-only" />
            except your own nervous system.
          </p>
          
          <div class="intro-meta-pill">
            <span>10 questions</span>
            <span class="dot-separator">•</span>
            <span>No need to count</span>
            <span class="dot-separator">•</span>
            <span>Score at the end</span>
          </div>

          <div class="cta-wrapper">
            <button id="start-quiz-btn" class="btn-filled">
              <span>Start The Assessment</span>
            </button>
          </div>
        </section>
      </div>
    </div>

    <div id="quiz-gameplay" class="quiz-screen" data-theme="light">
      <section class="methodology-section">
        <div class="quiz-header-bar">
          <div class="quiz-header-top">
            <span id="question-counter" class="counter-text">QUESTION 1 OF 10</span>
            <div class="header-dots-container" id="header-dots-container"></div>
          </div>
          <div class="progress-bar-track">
            <div id="progress-bar-fill" class="progress-bar-fill"></div>
          </div>
        </div>

        <div class="question-card-container">
          <div class="question-box-wrapper">
            <h2 id="question-text-box" class="section-heading"></h2>
          </div>
          
          <div class="options-wrapper" id="options-container"></div>

          <div id="scarcity-feedback-box" class="scarcity-signal-panel">
            <span class="signal-highlight">💡 Scarcity signal:</span>
            <p id="feedback-text" class="signal-desc"></p>
          </div>
        </div>

        <div class="quiz-navigation">
          <button id="next-question-btn" class="btn-filled hidden">
            <span>Next Question</span>
          </button>
        </div>
      </section>
    </div>

    <div id="quiz-results" class="quiz-screen" data-theme="dark">
      <section class="tracks-section">
        <div class="tracks-container">
          
          <div class="tracks-header">
            <h2 class="tracks-main-heading">HOW DID YOU <span class="serif-italic">SCORE?</span></h2>
            <p class="results-meta">Count how many B or C answers you chose.</p>
          </div>

          <div class="tracks-grid visual-tiers-grid">
            
            <div class="track-card tier-card" id="tier-abundance" data-tier="abundance">
              <div class="track-left-badge tier-abundance-badge">0–2</div>
              <div class="track-meta">
                <h3 class="track-title">Abundance Oriented</h3>
                <p class="track-desc">
                  You've largely broken free. Stay conscious — it can creep back under stress.
                </p>
              </div>
            </div>

            <div class="track-card tier-card" id="tier-selective" data-tier="selective">
              <div class="track-left-badge tier-selective-badge">3–5</div>
              <div class="track-meta">
                <h3 class="track-title">Selective Scarcity</h3>
                <p class="track-desc">
                  You have pockets of scarcity thinking. Great self-awareness potential here.
                </p>
              </div>
            </div>

            <div class="track-card tier-card" id="tier-dominant" data-tier="dominant">
              <div class="track-left-badge tier-dominant-badge">6–8</div>
              <div class="track-meta">
                <h3 class="track-title">Scarcity Dominant</h3>
                <p class="track-desc">
                  It's running much of your decision-making. This is the work to do.
                </p>
              </div>
            </div>

            <div class="track-card tier-card" id="tier-survival" data-tier="survival">
              <div class="track-left-badge tier-survival-badge">9–10</div>
              <div class="track-meta">
                <h3 class="track-title">Deep Survival Mode</h3>
                <p class="track-desc">
                  You're still protecting a version of yourself that no longer needs protecting. Healing is possible.
                </p>
              </div>
            </div>

          </div>

          <p class="verdict-footer">Every point is a doorway, not a verdict.</p>

          <div class="matrix-anchor-wrapper">
            <div class="transformation-matrix">
              <div class="matrix-header">BREAKING FREE: FROM SCARCITY TO ABUNDANCE</div>
              <div class="matrix-labels-row">
                <span class="matrix-label-text">SHIFT FROM</span>
                <span class="matrix-label-text">TO →</span>
              </div>
              <div class="matrix-body">
                <div class="matrix-row trigger-row">
                  <div class="shift-from-box">"My work speaks for itself"</div>
                  <div class="shift-arrow">→</div>
                  <div class="shift-to-box">Make your work visible. Advocate for yourself.</div>
                </div>
                <div class="matrix-row trigger-row">
                  <div class="shift-from-box">"That coach is too expensive"</div>
                  <div class="shift-arrow">→</div>
                  <div class="shift-to-box">Ask: what is NOT investing actually costing me?</div>
                </div>
                <div class="matrix-row trigger-row">
                  <div class="shift-from-box">"I can't take that risk"</div>
                  <div class="shift-arrow">→</div>
                  <div class="shift-to-box">Reframe: what is the cost of NOT taking it?</div>
                </div>
                <div class="matrix-row trigger-row">
                  <div class="shift-from-box">"There's only one seat for us"</div>
                  <div class="shift-arrow">→</div>
                  <div class="shift-to-box">Lift as you climb. Build tables, not queues.</div>
                </div>
                <div class="matrix-row trigger-row">
                  <div class="shift-from-box">"I must be practical"</div>
                  <div class="shift-arrow">→</div>
                  <div class="shift-to-box">Passion and mission are also valid currencies.</div>
                </div>
              </div>
            </div>
          </div>

          <div class="funnel-coaching-cta">
            <p class="funnel-accent-text">Ready to reprogram your unconscious frameworks?</p>
            <a href={`${import.meta.env.BASE_URL}/coaching`} class="btn-filled">
              <span>Yes I am</span>
            </a>
          </div>

        </div>
      </section>
    </div>

  </main>
  <TypeWriter3 />
</BaseLayout>

<script>
  const quizData = [
    {
      question: "You need to park downtown for an important meeting. There's a $9 lot right next to the building. What do you do?",
      choices: {
        A: "Pay the $9 — my time is worth more.",
        B: "Drive around looking for free street parking, even if it takes 20 minutes.",
        C: "Spend 10 minutes on an app finding a $6 spot three blocks away."
      },
      signal: "B & C signal scarcity — you're trading time, stress, and opportunity to save a few dollars."
    },
    {
      question: "A coach who specializes in board placements charges $500/session. You want a board seat. What do you think?",
      choices: {
        A: "That's an investment — a board seat is worth 100x that.",
        B: "That's a lot of money. I can figure it out on my own.",
        C: "Maybe later, when I feel more ready."
      },
      signal: "B & C reflect scarcity — letting a small cost block a large opportunity."
    },
    {
      question: "You are setting pricing configurations for your professional services. You realize your baseline rates are below market standards. You:",
      choices: {
        A: "Raise rates immediately to match output value metrics.",
        B: "Keep rates low because you fear losing existing clients.",
        C: "Offer arbitrary discounts before the prospect even fields pricing questions."
      },
      signal: "B & C reflect low pricing tolerances born from a persistent fear of losing transaction pipelines."
    },
    {
      question: "A critical operations bottleneck emerges. You have capital to outsource it, but you're working 70 hours a week instead. Why?",
      choices: {
        A: "I will hire a specialized expert immediately to trade money for operational focus.",
        B: "No one can duplicate my operational standard, so I have to keep running it.",
        C: "It is safer to conserve liquid capital reserves right now."
      },
      signal: "B & C show tactical labor hoarding caused by mistrusting scale frameworks."
    },
    {
      question: "An industry colleague requests a discovery conversation regarding your operational tool stacks. You feel:",
      choices: {
        A: "Expansive. Strategic resource sharing opens broader industry alignments.",
        B: "Guarded. If they optimize their operations, they could undercut my market share.",
        C: "Neutral, but you intentionally omit critical details to maintain an advantage."
      },
      signal: "B & C flag zero-sum frameworks rooted in the illusion that market opportunities are strictly finite."
    },
    {
      question: "Another Asian American in your industry gets a big feature in a major publication. You feel:",
      choices: {
        A: "Inspired — if they can do it, so can I.",
        B: "A little threatened — there's only so much room for 'us.'",
        C: "Happy for them, but quietly wonder why not me."
      },
      signal: "B signals zero-sum scarcity thinking. C can too, if it comes from comparison rather than aspiration."
    },
    {
      question: "You're offered a leadership role that involves public speaking and high visibility. You think:",
      choices: {
        A: "This is a great chance to grow and be seen.",
        B: "I'm not sure I'm ready — I should wait until I know more.",
        C: "What if I fail publicly? Better to stay in a role I've mastered."
      },
      signal: "B & C reveal scarcity-rooted fear of visibility — a key reason Asian Americans hit the bamboo ceiling."
    },
    {
      question: "You want to switch to a more fulfilling career. Your income would temporarily drop 20%. You:",
      choices: {
        A: "Make a plan and go for it — a 20% dip is temporary.",
        B: "It's too risky — what if it doesn't work out?",
        C: "Feel guilty — my parents sacrificed so much for my stability."
      },
      signal: "B & C are scarcity patterns — risk aversion and survivor's guilt keeping you from your own life."
    },
    {
      question: "You hate your job and dread going in every day. A friend recommends a program by a successful career coach that could change everything — but it costs $4,000. You:",
      choices: {
        A: "Invest in it. Staying miserable costs more than $4K.",
        B: "It's too expensive. I'll figure it out on my own.",
        C: "I'll wait and see if things get better on their own."
      },
      signal: "B & C are scarcity patterns — putting a price tag on your happiness and betting on a future that never changes itself."
    },
    {
      question: "Your business just crossed $100K. You're maxed out on capacity. What do you do?",
      choices: {
        A: "Hire a VA or delegate — my time is worth more than what it costs.",
        B: "Keep doing the same thing. I don't want to spend money on hiring.",
        C: "Think about hiring a VA but keep putting it off — it feels like a big expense."
      },
      signal: "B & C are scarcity in action — refusing to invest in growth keeps you at the same ceiling."
    }
  ];

  let currentQuestionIndex = 0;
  let scarcityScore = 0;

  const introScreen = document.getElementById('quiz-intro');
  const gameplayScreen = document.getElementById('quiz-gameplay');
  const resultsScreen = document.getElementById('quiz-results');
  const startBtn = document.getElementById('start-quiz-btn');
  const nextBtn = document.getElementById('next-question-btn');
  const counterText = document.getElementById('question-counter');
  const progressBarFill = document.getElementById('progress-bar-fill');
  const questionTextBox = document.getElementById('question-text-box');
  const optionsContainer = document.getElementById('options-container');
  const feedbackBox = document.getElementById('scarcity-feedback-box');
  const feedbackText = document.getElementById('feedback-text');
  const dotsContainer = document.getElementById('header-dots-container');

  function initDots() {
    if (!dotsContainer) return;
    dotsContainer.innerHTML = '';
    for (let i = 0; i < quizData.length; i++) {
      const dot = document.createElement('div');
      dot.className = 'header-dot';
      dotsContainer.appendChild(dot);
    }
  }

  function updateDots(index) {
    const dots = document.querySelectorAll('.header-dot');
    dots.forEach((dot, i) => {
      if (i <= index) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
  }

  startBtn?.addEventListener('click', () => {
    introScreen?.classList.remove('active');
    gameplayScreen?.classList.add('active');
    initDots();
    loadQuestion(currentQuestionIndex);
  });

  function loadQuestion(index) {
    if (index >= quizData.length) {
      showResults();
      return;
    }

    if (feedbackBox) feedbackBox.style.display = 'none';
    nextBtn?.classList.add('hidden');

    const currentData = quizData[index];
    if (counterText) counterText.textContent = `QUESTION ${index + 1} OF ${quizData.length}`;
    if (questionTextBox) questionTextBox.textContent = currentData.question;
    
    updateDots(index);

    if (progressBarFill) {
      const percentage = ((index) / quizData.length) * 100;
      progressBarFill.style.width = `${percentage}%`;
    }

    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      Object.entries(currentData.choices).forEach(([choiceKey, choiceValue]) => {
        const row = document.createElement('button');
        row.className = `option-row variant-${choiceKey.toLowerCase()}`;
        row.setAttribute('data-choice', choiceKey);
        
        let badgeClass = 'badge-a';
        if (choiceKey === 'B') badgeClass = 'badge-b';
        if (choiceKey === 'C') badgeClass = 'badge-c';

        row.innerHTML = `
          <span class="option-badge ${badgeClass}">${choiceKey}</span>
          <p class="option-text">${choiceValue}</p>
        `;
        row.addEventListener('click', () => selectChoice(row, choiceKey));
        optionsContainer.appendChild(row);
      });
    }
  }

  function selectChoice(selectedRow, choiceKey) {
    const allRows = document.querySelectorAll('.option-row');
    if (allRows[0].classList.contains('disabled')) return;

    selectedRow.classList.add('selected');
    allRows.forEach(row => row.classList.add('disabled'));

    if (choiceKey === 'B' || choiceKey === 'C') {
      scarcityScore++;
    }

    if (feedbackText && feedbackBox) {
      feedbackText.textContent = quizData[currentQuestionIndex].signal;
      feedbackBox.style.display = 'flex';
    }

    nextBtn?.classList.remove('hidden');
  }

  nextBtn?.addEventListener('click', () => {
    currentQuestionIndex++;
    loadQuestion(currentQuestionIndex);
  });

  function showResults() {
    if (progressBarFill) {
      progressBarFill.style.width = '100%';
    }

    gameplayScreen?.classList.remove('active');
    resultsScreen?.classList.add('active');

    let targetedTier = 'abundance';
    if (scarcityScore >= 3 && scarcityScore <= 5) targetedTier = 'selective';
    else if (scarcityScore >= 6 && scarcityScore <= 8) targetedTier = 'dominant';
    else if (scarcityScore >= 9) targetedTier = 'survival';

    const cards = document.querySelectorAll('.tier-card');
    cards.forEach(card => {
      if (card.getAttribute('data-tier') === targetedTier) {
        card.classList.add('highlighted');
      } else {
        card.classList.add('dimmed');
      }
    });
  }
</script>

<style>
  .quiz-page-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--white);
  }

  .coaching-hero-gradient {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(
      to right, 
      #59363A 0%, 
      #59363A 6%, 
      #8A6266 25%,
      #BA9699 38%,
      #DFCDC9 48%,
      #FEF4EF 58%, 
      #FEF4EF 100%
    );
    padding: calc(7rem + 80px) 4rem 8rem 4rem; 
    box-sizing: border-box;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .coaching-hero-gradient::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    opacity: 0.025; 
    pointer-events: none;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='silk'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23silk)'/%3E%3C/svg%3E");
  }

  .coaching-hero {
    max-width: 1200px;
    margin: 0 auto;
    color: var(--white);
    width: 100%;
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8); 
    display: block;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--coral);
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: #DFCDC9; 
  }

  .hero-intro {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.8;
    max-width: 600px;
    color: var(--white);
    opacity: 0.9;
    margin-bottom: 3.5rem;
  }

  .intro-meta-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    background-color: rgba(89, 54, 58, 0.9);
    padding: 1rem 2rem;
    color: var(--white);
    font-family: 'Poppins', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 1px;
    margin-bottom: 4rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .dot-separator {
    color: var(--coral);
    font-weight: 600;
  }

  .btn-filled {
    display: inline-block;
    background-color: var(--coral);
    color: var(--white);
    padding: 1.25rem 3.5rem;
    text-decoration: none;
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.9rem;
    border: 1px solid var(--coral);
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .btn-filled:hover {
    background-color: var(--burgundy);
    border-color: var(--burgundy);
  }

  .quiz-screen {
    display: none;
  }

  .quiz-screen.active {
    display: block;
  }

  .methodology-section {
    width: 100%;
    background-color: #3d2326; 
    padding: 4rem;
    box-sizing: border-box;
    min-height: 100vh;
  }

  .quiz-header-bar {
    max-width: 1000px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quiz-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .counter-text {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #baa1a3;
    display: block;
  }

  .header-dots-container {
    display: flex;
    gap: 0.5rem;
  }

  .header-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    transition: background-color 0.3s ease;
  }

  .header-dot.active {
    background-color: #df9e93;
  }

  .progress-bar-track {
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .progress-bar-fill {
    width: 0%;
    height: 100%;
    background-color: #df9e93;
  }

  .question-card-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .question-box-wrapper {
    background-color: #e4beba;
    border-left: 6px solid #d4958c;
    padding: 3rem;
    margin-bottom: 2rem;
  }

  .methodology-section .section-heading {
    color: #2b1719;
    font-size: 1.8rem;
    line-height: 1.5;
    text-transform: none;
    font-family: 'Tenor Sans', sans-serif;
    font-weight: 500;
    margin: 0;
  }

  .options-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .option-row {
    background-color: var(--white);
    border: none;
    display: flex;
    align-items: center;
    padding: 0;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: background-color 0.25s ease;
  }

  .option-row:not(.disabled):hover {
    background-color: #fff9f8;
  }

  .option-badge {
    width: 55px;
    height: 70px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Tenor Sans', sans-serif;
    font-weight: 600;
    color: var(--white);
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .badge-a { background-color: #346145; }
  .badge-b { background-color: #96352f; }
  .badge-c { background-color: #8c4f23; }

  .option-text {
    padding: 1.25rem 2rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: #2b1719;
    line-height: 1.5;
    margin: 0;
  }

  .option-row.selected {
    background-color: #fff1f0;
    outline: 2px solid #d4958c;
  }

  .option-row.disabled:not(.selected) {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .scarcity-signal-panel {
    display: none;
    background-color: #e4beba;
    border-left: 4px solid #d4958c;
    padding: 1rem 2rem;
    margin-bottom: 2rem;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #402528;
    align-items: center;
    flex-direction: row;
    gap: 0.5rem;
  }

  .signal-highlight {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: #402528;
    white-space: nowrap;
  }

  .signal-desc {
    font-weight: 400;
    margin: 0;
    display: inline;
  }

  .quiz-navigation {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end;
  }

  .btn-filled.hidden {
    display: none;
  }

  .tracks-section {
    width: 100%;
    background-color: #331d20;
    padding: 6rem 4rem;
    box-sizing: border-box;
    color: var(--white);
  }

  .tracks-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .tracks-header {
    text-align: left;
    margin-bottom: 3rem;
  }

  .tracks-main-heading {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 2.8rem;
    color: #e2b6b1;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    letter-spacing: 2px;
  }

  .results-meta {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-style: italic;
    font-size: 1.15rem;
    color: #bfa5a7;
    margin: 0;
  }

  .tracks-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .track-card {
    background-color: #42282b;
    border: none;
    padding: 0;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 0;
    transition: opacity 0.4s ease;
  }

  .track-left-badge {
    width: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Tenor Sans', sans-serif;
