---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
import MediaKit from '../components/MediaKit.astro';
import forbesLogo from '../../public/images/forbes.webp';
import incLogo from '../../public/images/incmagazine.webp';
import bloombergLogo from '../../public/images/bloomberg.webp';
import NYTLogo from '../../public/images/nytimes.webp';
---

<BaseLayout title="Work | Misa Chien">
  <main class="work-container">
    
    <div class="work-hero-gradient" data-theme="start">
      <section class="work-hero reveal-on-scroll">
        <span class="subtitle">My Company</span>
        <h1 class="main-title">
          UPLIFTING OTHERS <br class="desktop-only" />
          <span class="serif-italic">Impactful Connection</span>
        </h1>
        <p class="hero-intro">
         The Authentic Asian is a private network built to help Asian American Female Executives and Entrepreneurs feel less alone and more connected. We are the only organization specifically designed to help uplift Asian American female leaders, whether they are on their journey towards breaking the ceiling, an extraordinary leader who just needs support, or a trailblazer who would like to give back and uplift others. 
        </p>
      </section>
    </div>
<section class="ticker-section" data-theme="light">
      <div class="ticker-wrapper">
        <div class="ticker-track">
          <div class="ticker-item"><img src={forbesLogo.src} alt="Forbes Logo" class="logo-img logo-forbes" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>
          <div class="ticker-item"><img src={incLogo.src} alt="Inc. Magazine Logo" class="logo-img logo-inc" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>
          <div class="ticker-item"><img src={bloombergLogo.src} alt="Bloomberg Logo" class="logo-img logo-bloomberg" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>
          <div class="ticker-item"><img src={NYTLogo.src} alt="The New York Times Logo" class="logo-img logo-nyt" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>

          <div class="ticker-item"><img src={forbesLogo.src} alt="Forbes Logo" class="logo-img logo-forbes" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>
          <div class="ticker-item"><img src={incLogo.src} alt="Inc. Magazine Logo" class="logo-img logo-inc" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>
          <div class="ticker-item"><img src={bloombergLogo.src} alt="Bloomberg Logo" class="logo-img logo-bloomberg" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>
          <div class="ticker-item"><img src={NYTLogo.src} alt="The New York Times Logo" class="logo-img logo-nyt" /></div>
          <div class="ticker-item"><span class="ticker-sparkle">✦</span></div>
        </div>
      </div>
    </section>

  <section class="venture-section nomnom-section" data-theme="light">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">01 / LEARNING FROM FAILURES</span>
          <h2 class="venture-title">Ever wondered what happened to Nom Nom Truck?</h2>
          <div class="venture-divider"></div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
           Over 4 years, Nom Nom Truck was featured everywhere from The NY Times to Sunset Magazine, and was even featured on the Food Network, for the reality TV show The Great Food Truck Race. Despite this success, Misa had to close Nom Nom Truck in 2013, due to issues with her business partner. Read the article to learn more. 
          <p class="venture-details">
            <strong>Article Focus:</strong> 3 Ways Nom Nom Truck Failed as a Business
          </p>
          <a href="" target="_blank" rel="noopener noreferrer" class="venture-link link--light">
            <span>Read More</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
    

    <section class="venture-section authentic-asian-section" data-theme="dark">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">02 / LEADERSHIP ECOSYSTEM</span>
          <h2 class="venture-title">The Authentic <br /><em>Asian.</em></h2>
          <div class="venture-divider"></div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
           The Authentic Asian, founded in 2023, is a private community for accomplished Asian female leaders—executives, entrepreneurs, and changemakers—who seek meaningful connection over transactional networking. We create intentional spaces where you can be fully seen, share openly, and grow alongside leaders who understand the unique intersection of ambition, culture, and identity.
          </p>
          <p class="venture-details">
            <strong>Focus:</strong> Collaborative, Supportive, Success through connection.
          </p>
          <a href="https://theauthenticasian.com/" target="_blank" rel="noopener noreferrer" class="venture-link link--dark">
            <span>Explore The Community</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
<MediaKit    />
<TypeWriter3   />

  </main>
</BaseLayout>

<style>
  .work-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--white);
  }


  .work-hero-gradient {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(
      to right, 
      #59363A 0%, 
      #59363A 6%, 
      #8A6266 25%,
      #BA9699 38%,
      #DFCDC9 48%,
      #FEF4EF 58%, 
      #FEF4EF 100%
    );
    padding: calc(7rem + 80px) 4rem 8rem 4rem; 
    box-sizing: border-box;
  }

  .work-hero-gradient::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    opacity: 0.025; 
    pointer-events: none;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='silk'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23silk)'/%3E%3C/svg%3E");
  }

  .work-hero {
    max-width: 1200px;
    margin: 0 auto;
    color: var(--white);
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7); 
    display: block;
    margin-bottom: 1rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--coral);
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: #DFCDC9; 
  }

  .hero-intro {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.15rem;
    line-height: 1.8;
    max-width: 600px;
    color: var(--white);
    opacity: 0.9;
  }



  .venture-section {
    width: 100%;
    padding: 10rem 4rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .venture-grid {
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .venture-meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .venture-number {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .venture-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 3rem;
    line-height: 1.2;
    text-transform: uppercase;
    margin: 0;
  }

  .venture-divider {
    width: 60px;
    height: 1px;
  }

  .venture-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .venture-description {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    line-height: 1.8;
    font-weight: 300;
  }

  .venture-details {
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 300;
  }

  .venture-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-decoration: none;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .venture-link .arrow {
    transition: transform 0.3s ease;
  }

  .venture-link:hover .arrow {
    transform: translateX(6px);
  }

  /* ---  (Cream Section) --- */
  .nomnom-section {
    background-color: #FEF4EF; 
  }

  .nomnom-section .venture-number {
    color: var(--coral);
  }

  .nomnom-section .venture-title {
    color: var(--burgundy);
  }

  .nomnom-section .venture-divider {
    background-color: rgba(89, 54, 58, 0.2);
  }

  .nomnom-section .venture-content {
    color: var(--burgundy);
  }

  .nomnom-section .venture-description {
    opacity: 0.9;
  }

  .nomnom-section .venture-details strong {
    color: var(--coral);
  }

  .link--light {
    color: var(--burgundy);
    border-color: rgba(89, 54, 58, 0.3);
  }

  .link--light:hover {
    color: var(--coral);
    border-color: var(--coral);
  }

  

  /* --- VENTURE TWO: THE AUTHENTIC ASIAN (Burgundy Section) --- */
  .authentic-asian-section {
    background-color: var(--burgundy); 
  }

  .authentic-asian-section .venture-number {
    color: var(--coral);
  }

  .authentic-asian-section .venture-title {
    color: var(--white);
  }

  .authentic-asian-section .venture-title em {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none;
    color: #DFCDC9;
  }

  .authentic-asian-section .venture-divider {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .authentic-asian-section .venture-content {
    color: var(--white);
  }

  .authentic-asian-section .venture-description {
    opacity: 0.85;
  }

  .authentic-asian-section .venture-details strong {
    color: var(--coral);
  }

  .link--dark {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .link--dark:hover {
    color: var(--coral);
    border-color: var(--coral);
  }
/* --- TICKER IMAGE STYLES --- */
  .ticker-section {
    background-color: var(--white);
    padding: 2.5rem 0;
    width: 100%;
    overflow: hidden;
    border-bottom: 1px solid rgba(89, 54, 58, 0.05);
  }

  .ticker-wrapper {
    width: 100%;
    overflow: hidden;
    display: flex;
  }

  .ticker-track {
    display: flex;
    align-items: center;
    gap: 5rem; 
    width: max-content;
    animation: scrollTicker 30s linear infinite;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  .ticker-item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .ticker-sparkle {
    color: #DFCDC9;
    font-size: 0.9rem;
  }

  /* Core image adjustments to prevent color bleeding and sizing distortions */
  .logo-img {
    height: auto;
    display: block;
    object-fit: contain;

    opacity: 0.85; 
    filter: grayscale(100%); 
  }

 
  .logo-forbes {
    width: 130px;
  }

  .logo-inc {
    width: 75px;
  }

  .logo-bloomberg {
    width: 140px;
  }

  .logo-nyt {
    width: 180px;
  }

  @keyframes scrollTicker {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }




  /* --- RESPONSIVE WORKFLOWS (Breakpoint Adaptive) --- */
  .desktop-only {
    display: block;
  }

  @media (max-width: 820px) {
    .work-hero-gradient {
      background: linear-gradient(
        to bottom, 
        #59363A 0%, 
        #59363A 22%, 
        #8A6266 40%,
        #BA9699 55%,
        #DFCDC9 70%,
        #FEF4EF 85%, 
        #FEF4EF 100%
      );
      padding: calc(5rem + 70px) 1.5rem 6rem 1.5rem;
    }

    .desktop-only {
      display: none;
    }

    .work-hero {
      text-align: left; 
    }

    .main-title {
      font-size: 2.75rem;
    }

    .hero-intro {
      margin: 0; 
      font-size: 1.05rem;
      color: var(--burgundy);
    }

    .venture-section {
      padding: 6rem 1.5rem;
    }

    .venture-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: left; 
    }

    .venture-meta {
      align-items: flex-start; 
    }

    .venture-title {
      font-size: 2.25rem;
    }

    .venture-link {
      align-self: flex-start; 
    }
.ticker-section {
      padding: 1.75rem 0;
    }

    .ticker-track {
      gap: 3rem;
    }

 
    .logo-forbes {
      width: 95px;
    }

    .logo-inc {
      width: 55px;
    }

    .logo-bloomberg {
      width: 105px;
    }

    .logo-nyt {
      width: 130px;
    }
  }
  
</style>
