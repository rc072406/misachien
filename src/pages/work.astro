---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
---

<BaseLayout title="Work | Misa Chien">
  <main class="work-container">
    
    <div class="work-hero-gradient" data-theme="start">
      <section class="work-hero reveal-on-scroll">
        <span class="subtitle">My Companies</span>
        <h1 class="main-title">
          Building Systems. <br class="desktop-only" />
          <span class="serif-italic">Elevating Voices.</span>
        </h1>
        <p class="hero-intro">
          A portfolio of intentional disruption—spanning automated seven-figure software ecosystems and deep-impact cultural leadership spaces.
        </p>
      </section>
    </div>

    <section class="venture-section autopilot-section" data-theme="light">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">01 / SAAS ECOSYSTEM</span>
          <h2 class="venture-title">Autopilot Reviews</h2>
          <div class="venture-divider"></div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
            A high-growth customer reputation and software platform engineered to streamline business operations and scale client acquisition. Reaching 7-figures in revenue, Autopilot Reviews stands as a benchmark for automated efficiency, proving that high-level operational strategy can operate seamlessly in the background while business founders reclaim their time.
          </p>
          <p class="venture-details">
            <strong>Focus:</strong> Automated Scalability, High-Impact B2B Strategy, 7-Figure Systems Architecture.
          </p>
          <a href="https://autopilotreviews.co/" target="_blank" rel="noopener noreferrer" class="venture-link link--light">
            <span>Visit Autopilot Reviews</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="venture-section authentic-asian-section" data-theme="dark">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">02 / LEADERSHIP ECOSYSTEM</span>
          <h2 class="venture-title">The Authentic <br /><em>Asian.</em></h2>
          <div class="venture-divider"></div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
            Founded in October 2023, The Authentic Asian is a premium, specialized AAPI Female Leadership Community. This ecosystem provides a transformative sanctuary for high-achieving corporate executives, C-level leaders, and late-stage founders to dismantle deeply rooted scarcity mindsets, combat systemic burnout, and safely align with their raw, authentic power.
          </p>
          <p class="venture-details">
            <strong>Focus:</strong> Collaborative, Supportive, Success through connection.
          </p>
          <a href="https://theauthenticasian.com/" target="_blank" rel="noopener noreferrer" class="venture-link link--dark">
            <span>Explore The Community</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
<TypeWriter3   </>

  </main>
</BaseLayout>

<style>
  .work-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--white);
  }


  .work-hero-gradient {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(
      to right, 
      #59363A 0%, 
      #59363A 6%, 
      #8A6266 25%,
      #BA9699 38%,
      #DFCDC9 48%,
      #FEF4EF 58%, 
      #FEF4EF 100%
    );
    padding: calc(7rem + 80px) 4rem 8rem 4rem; 
    box-sizing: border-box;
  }

  .work-hero-gradient::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    opacity: 0.025; 
    pointer-events: none;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='silk'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23silk)'/%3E%3C/svg%3E");
  }

  .work-hero {
    max-width: 1200px;
    margin: 0 auto;
    color: var(--white);
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7); 
    display: block;
    margin-bottom: 1rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--coral);
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: #DFCDC9; 
  }

  .hero-intro {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.15rem;
    line-height: 1.8;
    max-width: 600px;
    color: var(--white);
    opacity: 0.9;
  }



  .venture-section {
    width: 100%;
    padding: 10rem 4rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .venture-grid {
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .venture-meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .venture-number {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .venture-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 3rem;
    line-height: 1.2;
    text-transform: uppercase;
    margin: 0;
  }

  .venture-divider {
    width: 60px;
    height: 1px;
  }

  .venture-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .venture-description {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    line-height: 1.8;
    font-weight: 300;
  }

  .venture-details {
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 300;
  }

  .venture-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-decoration: none;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .venture-link .arrow {
    transition: transform 0.3s ease;
  }

  .venture-link:hover .arrow {
    transform: translateX(6px);
  }


  /* --- VENTURE ONE: AUTOPILOT REVIEWS (Cream Section) --- */
  .autopilot-section {
    background-color: #FEF4EF; /* Requested color */
  }

  .autopilot-section .venture-number {
    color: var(--coral);
  }

  .autopilot-section .venture-title {
    color: var(--burgundy);
  }

  .autopilot-section .venture-divider {
    background-color: rgba(89, 54, 58, 0.2);
  }

  .autopilot-section .venture-content {
    color: var(--burgundy);
  }

  .autopilot-section .venture-description {
    opacity: 0.9;
  }

  .autopilot-section .venture-details strong {
    color: var(--coral);
  }

  .link--light {
    color: var(--burgundy);
    border-color: rgba(89, 54, 58, 0.3);
  }

  .link--light:hover {
    color: var(--coral);
    border-color: var(--coral);
  }


  /* --- VENTURE TWO: THE AUTHENTIC ASIAN (Burgundy Section) --- */
  .authentic-asian-section {
    background-color: var(--burgundy); /* Requested color */
  }

  .authentic-asian-section .venture-number {
    color: var(--coral);
  }

  .authentic-asian-section .venture-title {
    color: var(--white);
  }

  .authentic-asian-section .venture-title em {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none;
    color: #DFCDC9;
  }

  .authentic-asian-section .venture-divider {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .authentic-asian-section .venture-content {
    color: var(--white);
  }

  .authentic-asian-section .venture-description {
    opacity: 0.85;
  }

  .authentic-asian-section .venture-details strong {
    color: var(--coral);
  }

  .link--dark {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .link--dark:hover {
    color: var(--coral);
    border-color: var(--coral);
  }


  /* --- RESPONSIVE WORKFLOWS (Breakpoint Adaptive) --- */
  .desktop-only {
    display: block;
  }

  @media (max-width: 820px) {
    .work-hero-gradient {
      background: linear-gradient(
        to bottom, 
        #59363A 0%, 
        #59363A 22%, 
        #8A6266 40%,
        #BA9699 55%,
        #DFCDC9 70%,
        #FEF4EF 85%, 
        #FEF4EF 100%
      );
      padding: calc(5rem + 70px) 1.5rem 6rem 1.5rem;
    }

    .desktop-only {
      display: none;
    }

    .work-hero {
      text-align: center;
    }

    .main-title {
      font-size: 2.75rem;
    }

    .hero-intro {
      margin: 0 auto;
      font-size: 1.05rem;
    }

    .venture-section {
      padding: 6rem 1.5rem;
    }

    .venture-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .venture-meta {
      align-items: center;
    }

    .venture-title {
      font-size: 2.25rem;
    }

    .venture-link {
      align-self: center;
    }
  }
</style>
