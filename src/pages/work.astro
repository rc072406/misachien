---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaKit from '../components/MediaKit.astro';
import nomnomImage from '../../public/images/misatruck.webp'; 
import authenticAsianImage from '../../public/images/TAA.webp'; 
import brandVideo from '../../public/videos/misabrandvid (1).mp4';

const pageTitle = "Work & Ventures: Speaking, Coaching & Ecosystems | Misa Chien";
const pageDescription = "Explore the professional ecosystem of Misa Chien. From scaling impactful communities like The Authentic Asian to professional keynote speaking, subconscious mindset coaching, and strategic brand partnerships.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const workSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalURL}#webpage`,
      "url": canonicalURL,
      "name": pageTitle,
      "description": pageDescription,
      "about": {
        "@type": "Person",
        "@id": `${Astro.site ?? "https://misachien.com"}/#person`,
        "name": "Misa Chien",
        "url": "https://misachien.com",
        "jobTitle": "Founder & Executive Coach",
        "knowsAbout": [
          "Public Speaking",
          "Subconscious Reprogramming",
          "Strategic Partnerships",
          "Brand Modeling",
          "AAPI Executive Leadership"
        ]
      }
    },
    {
      "@type": "Organization",
      "name": "The Authentic Asian",
      "url": "https://theauthenticasian.com",
      "founder": {
        "@id": `${Astro.site ?? "https://misachien.com"}/#person`
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(workSchema)} />
  

  <main class="work-container">
    
    <div class="work-hero-wrapper">
      <video muted loop playsinline autoplay class="hero-video-bg">
        <source src={brandVideo} type="video/mp4" />
      </video>
    </div>

    <section class="methodology-section">
      <div class="methodology-grid">
        <div class="methodology-left">
          <span class="section-label">Misa's Ecosystems</span>
          <h2 class="section-heading">Ventures and Partnerships</h2>
        </div>
        
        <div class="methodology-right">
          <p class="philosophy-text">
           From weathering the ultimate highs and lows with Nom Nom Truck to commanding stages as a prolific speaker and founding <em>The Authentic Asian</em>, Misa’s journey is a masterclass in resilience. Today, she builds ecosystems that empower leaders to redefine success, heal internal ceilings, and step into true, unshakeable authority.</p>
        </div>
      </div>
    </section>

    <section class="venture-section nomnom-section" data-theme="light">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">01 / LEARNING FROM FAILURES</span>
          <h2 class="venture-title">What happened to Nom Nom Truck?</h2>
          <div class="venture-divider"></div>
          <div class="venture-image-container">
            <img src={nomnomImage.src} alt="Nom Nom Truck Food Network History" class="venture-img" />
          </div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
            Over 4 years, Nom Nom Truck was featured everywhere from The NY Times to Sunset Magazine, and was even featured on the Food Network, for the reality TV show The Great Food Truck Race. Despite this success, Misa had to close Nom Nom Truck in 2013, due to issues with her business partner. Read the article to learn more.
          </p>
          <p class="venture-details">
            <strong>Article Focus:</strong> 3 Ways Nom Nom Truck Failed as a Business
          </p>
          <a href="/what-happened-to-nom-nom-truck" rel="noopener noreferrer" class="venture-link link--light">
            <span>Read More</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
    
    <section class="venture-section authentic-asian-section" data-theme="dark">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">02 / LEADERSHIP ECOSYSTEM</span>
          <h2 class="venture-title">The Authentic <br />Asian.</h2>
          <div class="venture-divider"></div>
          <div class="venture-image-container">
            <img src={authenticAsianImage.src} alt="The Authentic Asian Leadership Community" class="venture-img" />
          </div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
            The Authentic Asian, founded in 2023, is a private community for accomplished Asian female leaders—executives, entrepreneurs, and changemakers—who seek meaningful connection over transactional networking. We create intentional spaces where you can be fully seen, share openly, and grow alongside leaders who understand the unique intersection of ambition, culture, and identity.
          </p>
          <p class="venture-details">
            <strong>Focus:</strong> Collaborative, Supportive, Success through connection.
          </p>
          <a href="https://theauthenticasian.com/" target="_blank" rel="noopener noreferrer" class="venture-link link--dark">
            <span>Explore The Community</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <MediaKit client:visible />

    <a href="mailto:bernadine@theauthenticasian.com" id="floating-apply-btn" class="floating-btn">
      WANT TO PARTNER WITH MISA? <span class="arrow">→</span>
    </a>
  </main>
</BaseLayout>

<style>
  :root {
    --bg-solid-light: #FBF9F6;  
    --bg-solid-dark: #59363B;     
    --text-primary: #59363B;    
    --text-muted: #6B4E52;      
    --accent-gold: #E7765D;     
    --border-color: rgba(89, 54, 59, 0.15);
    --text-serif: #8C7E6D; 
    
    --font-serif: 'Libre Baskerville', Georgia, serif;
    --font-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .work-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--bg-solid-light);
   padding-top: var(--nav-height);
  }

  .work-hero-wrapper {
    position: relative;
    width: 100%;
   height: calc(90vh - var(--nav-height));
    overflow: hidden;
    background-color: #000;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-video-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .venture-section {
    width: 100%;
    padding: 5rem 4rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    border-bottom: 1px solid var(--border-color);
  }

  .venture-grid {
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 7rem;
    align-items: center;
  }

  .venture-meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .venture-number {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .venture-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .venture-image-container {
    width: 100%;
    margin-top: 1.5rem; 
    margin-bottom: 0.5rem;
    overflow: hidden;
  }

  .venture-image-container img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .venture-divider {
    width: 40px;
    height: 2px;
    background-color: var(--accent-gold);
  }

  .venture-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .venture-description {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .venture-details {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .venture-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-decoration: none;
    padding: 1rem 2rem;
    border: 1px solid transparent;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .venture-link .arrow {
    transition: transform 0.3s ease;
  }

  .venture-link:hover .arrow {
    transform: translateX(5px);
  }

  .nomnom-section {
    background-color: var(--bg-solid-light); 
  }

  .nomnom-section .venture-number {
    color: var(--accent-gold);
  }

  .nomnom-section .venture-title {
    color: var(--text-primary);
  }

  .nomnom-section .venture-content {
    color: var(--text-muted);
  }

  .nomnom-section .venture-details strong {
    color: var(--text-primary);
  }

  .link--light {
    color: #FFFFFF;
    background-color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .link--light:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .authentic-asian-section {
    background-color: var(--bg-solid-dark); 
    border-bottom: none;
  }

  .authentic-asian-section .venture-number {
    color: var(--accent-gold);
  }

  .authentic-asian-section .venture-title {
    color: #FFFFFF;
  }

  .authentic-asian-section .venture-content {
    color: #E2D9DA; 
  }

  .authentic-asian-section .venture-details strong {
    color: #FFFFFF;
  }

  .link--dark {
    color: var(--text-primary);
    background-color: #FFFFFF;
    border-color: #FFFFFF;
  }

  .link--dark:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
    color: #FFFFFF;
  }

  .floating-btn {
    position: fixed;
    bottom: 2.5rem;
    right: 2.5rem;
    background-color: var(--accent-gold); 
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1.25rem 2.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 999;
    box-shadow: 0 15px 45px rgba(89, 54, 59, 0.12); 
    border: 1px solid var(--accent-gold);
    border-radius: 0 !important;
    
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease, background-color 0.3s ease;
  }

  .floating-btn.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .floating-btn:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .floating-btn .arrow {
    transition: transform 0.3s ease;
  }

  .floating-btn:hover .arrow {
    transform: translateX(4px);
  }

  .methodology-section {
    width: 100%;
    background-color: white; 
    padding: 5rem 4rem;
    box-sizing: border-box;
    border-bottom: 1px solid #EAE5E0;
  }

  .methodology-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 1rem;
  }

  .methodology-left .section-heading {
    font-family: var(--font-serif);
    color: var(--text-primary);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }

  .methodology-right {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    color: var(--text-muted);
  }

  .philosophy-text {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.8;
    font-weight: 500;
    margin: 0;
  }

  @media (max-width: 992px) {
    .venture-grid {
      gap: 4rem;
    }
  }

  @media (max-width: 900px) {
    .work-hero-wrapper {
      height: 50vh;
    }

    .methodology-section {
      padding: 5rem 1.5rem;
    }

    .methodology-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .methodology-left .section-heading {
      font-size: 1.8rem;
    }

    .venture-section {
      padding: 3rem 1.5rem;
    }

    .venture-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .venture-title {
      font-size: 2.25rem;
    }
    
    .venture-link {
      display: inline-flex; 
      align-self: flex-start;
      width: auto; 
      text-align: left;
    }

    .floating-btn {
      bottom: 1.5rem;
      right: 1.5rem;
      left: 1.5rem;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const heroSection = document.querySelector('.work-hero-wrapper');
    const heroVideo = document.querySelector('.hero-video-bg') as HTMLVideoElement;
    const floatingBtn = document.getElementById('floating-apply-btn');
    const footer = document.querySelector('footer') || document.querySelector('.authentic-asian-section'); 


    if (heroVideo) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      }, { threshold: 0.1 });

      videoObserver.observe(heroVideo);
    }

    
    if (floatingBtn) {
      let isHeroVisible = true;
      let isFooterVisible = false;

      const updateButtonVisibility = () => {
        if (!isHeroVisible && !isFooterVisible) {
          floatingBtn.classList.add('is-visible');
        } else {
          floatingBtn.classList.remove('is-visible');
        }
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.target === heroSection) {
            isHeroVisible = entry.isIntersecting;
          }
          if (entry.target === footer) {
            isFooterVisible = entry.isIntersecting;
          }
        });
        
        updateButtonVisibility();
      }, {
        threshold: 0 
      });

      if (heroSection) observer.observe(heroSection);
      if (footer) observer.observe(footer);
    }
  });
</script>
