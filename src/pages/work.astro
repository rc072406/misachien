---
import BaseLayout from '../layouts/BaseLayout.astro';

import MediaKit from '../components/MediaKit.astro';
import defaultShareImage from '../../public/images/misachien.webp'; 
import heroImage from '../../public/images/GL5A4634.webp'; 
const pageTitle = "Work & Ventures: Speaking, Coaching & Ecosystems | Misa Chien";
const pageDescription = "Explore the professional ecosystem of Misa Chien. From scaling impactful communities like The Authentic Asian to professional keynote speaking, subconscious mindset coaching, and strategic brand partnerships.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const shareImageURL = new URL(defaultShareImage.src, Astro.site ?? Astro.url).href;

const workSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalURL}#webpage`,
      "url": canonicalURL,
      "name": pageTitle,
      "description": pageDescription,
      "about": {
        "@type": "Person",
        "@id": `${Astro.site ?? "https://misachien.com"}/#person`,
        "name": "Misa Chien",
        "url": "https://misachien.com",
        "image": shareImageURL,
        "jobTitle": "Founder & Executive Coach",
        "knowsAbout": [
          "Public Speaking",
          "Subconscious Reprogramming",
          "Strategic Partnerships",
          "Brand Modeling",
          "AAPI Executive Leadership"
        ]
      }
    },
    {
      "@type": "Organization",
      "name": "The Authentic Asian",
      "url": "https://theauthenticasian.com",
      "founder": {
        "@id": `${Astro.site ?? "https://misachien.com"}/#person`
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={defaultShareImage.src}>
  <script type="application/ld+json" set:html={JSON.stringify(workSchema)} />
  
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <main class="work-container">
    
    <div class="work-hero-wrapper" data-theme="start">
      <section class="work-hero reveal-on-scroll">
        <span class="subtitle">MISA'S ECOSYSTEMS</span>
        <h1 class="main-title">
          VENTURES<br class="desktop-only" />
          <span class="serif-italic">And Partnerships</span>
        </h1>
        <p class="hero-intro">
         From weathering the ultimate highs and lows with Nom Nom Truck to commanding stages as a prolific speaker and founding <em>The Authentic Asian</em>, Misa’s journey is a masterclass in resilience. Today, she builds ecosystems that empower leaders to redefine success, heal internal ceilings, and step into true, unshakeable authority.
        </p>
<div class="hero-image-container">
    <img src={heroImage.src} alt="Misa Chien Unconscious Mind Coaching" class="hero-img" />
  </div>
      </section>
    </div>

    <section class="venture-section nomnom-section" data-theme="light">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">01 / LEARNING FROM FAILURES</span>
          <h2 class="venture-title">What happened to Nom Nom Truck?</h2>
          <div class="venture-divider"></div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
            Over 4 years, Nom Nom Truck was featured everywhere from The NY Times to Sunset Magazine, and was even featured on the Food Network, for the reality TV show The Great Food Truck Race. Despite this success, Misa had to close Nom Nom Truck in 2013, due to issues with her business partner. Read the article to learn more.
          </p>
          <p class="venture-details">
            <strong>Article Focus:</strong> 3 Ways Nom Nom Truck Failed as a Business
          </p>
          <a href="/what-happened-to-nom-nom-truck" rel="noopener noreferrer" class="venture-link link--light">
            <span>Read More</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
    
    <section class="venture-section authentic-asian-section" data-theme="dark">
      <div class="venture-grid reveal-on-scroll">
        <div class="venture-meta">
          <span class="venture-number">02 / LEADERSHIP ECOSYSTEM</span>
          <h2 class="venture-title">The Authentic <br /><span class="serif-italic-title">Asian.</span></h2>
          <div class="venture-divider"></div>
        </div>
        
        <div class="venture-content">
          <p class="venture-description">
            The Authentic Asian, founded in 2023, is a private community for accomplished Asian female leaders—executives, entrepreneurs, and changemakers—who seek meaningful connection over transactional networking. We create intentional spaces where you can be fully seen, share openly, and grow alongside leaders who understand the unique intersection of ambition, culture, and identity.
          </p>
          <p class="venture-details">
            <strong>Focus:</strong> Collaborative, Supportive, Success through connection.
          </p>
          <a href="https://theauthenticasian.com/" target="_blank" rel="noopener noreferrer" class="venture-link link--dark">
            <span>Explore The Community</span>
            <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <MediaKit client:visible />


    <a href="mailto:bernadine@theauthenticasian.com" id="floating-apply-btn" class="floating-btn">
      WANT TO PARTNER WITH MISA? <span class="arrow">→</span>
    </a>
  </main>
</BaseLayout>

<style>
  :root {
    --bg-solid-light: #FBF9F6;  
    --bg-solid-dark: #59363B;     
    --text-primary: #59363B;    
    --text-muted: #6B4E52;      
    --accent-gold: #E7765D;     
    --border-color: rgba(89, 54, 59, 0.15);
    --text-serif: #8C7E6D; 
    
    --font-serif: 'Libre Baskerville', Georgia, serif;
    --font-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .work-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--bg-solid-light);
  }

  .work-hero-wrapper {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--bg-solid-light);
    border-bottom: 1px solid var(--border-color);
    padding: calc(9rem + 80px) 4rem 9rem 4rem; 
  }

 max-width: 1200px;
  margin: 0 auto;
  color: var(--text-primary);
  display: grid;
  grid-template-columns: 1.2fr 1fr; 
  gap: 4rem;
  align-items: center;
}

.hero-image-container {
  width: 100%;
  display: flex;
  justify-content: flex-end;
}

.hero-img {
  width: 100%;
  max-width: 500px; 
  height: auto;
  object-fit: cover;
}

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--text-primary);
  }

  .serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none; 
    color: var(--text-serif);
    letter-spacing: 0;
  }

  .hero-intro {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 650px;
    color: var(--text-muted);
  }

  .venture-section {
    width: 100%;
    padding: 11rem 4rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    border-bottom: 1px solid var(--border-color);
  }

  .venture-grid {
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 7rem;
    align-items: start;
  }

  .venture-meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .venture-number {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .venture-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .venture-divider {
    width: 40px;
    height: 2px;
    background-color: var(--accent-gold);
  }

  .venture-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .venture-description {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .venture-details {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .venture-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-decoration: none;
    padding: 1rem 2rem;
    border: 1px solid transparent;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .venture-link .arrow {
    transition: transform 0.3s ease;
  }

  .venture-link:hover .arrow {
    transform: translateX(5px);
  }


  .nomnom-section {
    background-color: #FFFFFF; 
  }

  .nomnom-section .venture-number {
    color: var(--accent-gold);
  }

  .nomnom-section .venture-title {
    color: var(--text-primary);
  }

  .nomnom-section .venture-content {
    color: var(--text-muted);
  }

  .nomnom-section .venture-details strong {
    color: var(--text-primary);
  }

  .link--light {
    color: #FFFFFF;
    background-color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .link--light:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
  }


  .authentic-asian-section {
    background-color: var(--bg-solid-dark); 
    border-bottom: none;
  }

  .authentic-asian-section .venture-number {
    color: var(--accent-gold);
  }

  .authentic-asian-section .venture-title {
    color: #FFFFFF;
  }

  .serif-italic-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: var(--accent-gold);
  }

  .authentic-asian-section .venture-content {
    color: #E2D9DA; 
  }

  .authentic-asian-section .venture-details strong {
    color: #FFFFFF;
  }

  .link--dark {
    color: var(--text-primary);
    background-color: #FFFFFF;
    border-color: #FFFFFF;
  }

  .link--dark:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
    color: #FFFFFF;
  }


  .floating-btn {
    position: fixed;
    bottom: 2.5rem;
    right: 2.5rem;
    background-color: var(--accent-gold); 
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1.25rem 2.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 999;
    box-shadow: 0 15px 45px rgba(89, 54, 59, 0.12); 
    border: 1px solid var(--accent-gold);
    border-radius: 0 !important;
    
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease, background-color 0.3s ease;
  }

  .floating-btn.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .floating-btn:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .floating-btn .arrow {
    transition: transform 0.3s ease;
  }

  .floating-btn:hover .arrow {
    transform: translateX(4px);
  }

  .desktop-only {
    display: block;
  }

  @media (max-width: 992px) {
    .venture-grid {
      gap: 4rem;
    }
    .main-title {
      font-size: 3.25rem;
    }
  }

  @media (max-width: 820px) {
    .work-hero-wrapper {
      padding: calc(6rem + 70px) 1.5rem 6rem 1.5rem;
    }
.work-hero {
    grid-template-columns: 1fr; 
    gap: 3rem;
  }

  .hero-image-container {
    justify-content: center; 
  }

    .desktop-only {
      display: none;
    }

    .main-title {
      font-size: 2.5rem;
    }

    .hero-intro {
      font-size: 1.05rem;
    }

    .venture-section {
      padding: 7rem 1.5rem;
    }

    .venture-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .venture-title {
      font-size: 2.25rem;
    }
    
    .venture-link {
      display: inline-flex; 
    align-self: flex-start;
    width: auto; 
    text-align: left;
  
    }

    .floating-btn {
      bottom: 1.5rem;
      right: 1.5rem;
      left: 1.5rem;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const heroSection = document.querySelector('.work-hero-wrapper');
    const floatingBtn = document.getElementById('floating-apply-btn');

    if (heroSection && floatingBtn) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            floatingBtn.classList.remove('is-visible');
          } else {
            floatingBtn.classList.add('is-visible');
          }
        });
      }, {
        threshold: 0 
      });

      observer.observe(heroSection);
    }
  });
</script>
