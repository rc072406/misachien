---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
---

<BaseLayout title="Contact | Misa Chien">
  <main class="contact-container" data-theme="start">
    
    <div class="contact-gradient-wrapper">
      <section class="contact-hero reveal-on-scroll">
        <span class="subtitle">Get In Touch</span>
        <h1 class="main-title">
          Let's Create <br class="desktop-only" />
          <span class="serif-italic">Meaningful Connections</span>
        </h1>
      </section>

      <section class="contact-content-grid">
        <div class="content-left reveal-on-scroll">
          <div class="editorial-info-card">
            <h2 class="section-heading">Reach Out</h2>
            <p class="contact-desc">
              Whether you are looking to scale your business, release limiting beliefs, or invite Misa to speak at your next event, we would love to hear from you.
            </p>
            
            <div class="contact-details">
              <div class="detail-item">
                <span>General Inquiries</span>
                <p>hello@misachien.com</p>
              </div>
              <div class="detail-item">
                <span>Speaking & Press</span>
                <p>press@misachien.com</p>
              </div>
            </div>

            <div class="card-line"></div>
          </div>
        </div>

        <div class="content-right reveal-on-scroll">
          <div class="form-container">
            <form action="https://api.web3forms.com/submit" method="POST" class="web3form">
              
              <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
              <input type="checkbox" name="botcheck" class="honeypot" style="display: none;" />
              <input type="hidden" name="redirect" value="https://misachien.com/thanks" />

              <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required placeholder="Your name" />
              </div>

              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required placeholder="your.email@example.com" />
              </div>

              <div class="form-group">
                <label for="subject">Inquiry Type</label>
                <div class="select-wrapper">
                  <select id="subject" name="subject" required>
                    <option value="" disabled selected>Select an option</option>
                    <option value="Mindset & Business Coaching">Mindset & Business Coaching</option>
                    <option value="Speaking Engagements">Speaking Engagements</option>
                    <option value="Media & Press">Media & Press</option>
                    <option value="General Connection">General Connection</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="message">Your Message</label>
                <textarea id="message" name="message" rows="6" required placeholder="How can Misa support your journey?"></textarea>
              </div>

              <button type="submit" class="btn-filled">
                <span>Send Message</span>
              </button>

            </form>
          </div>
        </div>
      </section>

    </div>
  <TypeWriter3   />

  </main>
</BaseLayout>

<style>
  .contact-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--white);
  }

  .contact-gradient-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(
      to right, 
      #59363A 0%, 
      #59363A 6%, 
      #8A6266 25%,
      #BA9699 38%,
      #DFCDC9 48%,
      #FEF4EF 58%, 
      #FEF4EF 100%
    );
    padding: calc(6rem + 80px) 4rem 6rem 4rem; 
  }

  .contact-gradient-wrapper::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    opacity: 0.025; 
    pointer-events: none;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='silk'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23silk)'/%3E%3C/svg%3E");
  }

  .contact-hero {
    max-width: 1200px;
    margin: 0 auto 6rem auto;
    color: var(--white);
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7); 
    display: block;
    margin-bottom: 1rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
    color: var(--coral);
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: #DFCDC9; 
  }

  .contact-content-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .content-left {
    display: flex;
    flex-direction: column;
    gap: 3.5rem; 
  }

  .editorial-info-card {
    background-color: rgba(255, 255, 255, 0.03); 
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3.5rem;
    position: relative;
    color: var(--white);
  }

  .editorial-info-card .section-heading {
    color: var(--white);
    margin-bottom: 1.5rem;
  }

  .contact-desc {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail-item span {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--coral);
    display: block;
    margin-bottom: 0.25rem;
  }

  .detail-item p {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 1.2rem;
    letter-spacing: 0.5px;
  }

  .card-line {
    width: 40px;
    height: 1px;
    background-color: var(--white);
    margin-top: 3rem;
  }

  .content-right {
    color: var(--burgundy); 
  }

  .form-container {
    width: 100%;
    background-color: transparent;
  }

  .web3form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--burgundy);
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1rem;
    padding: 1rem 1.25rem;
    background-color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(89, 54, 58, 0.15);
    color: var(--burgundy);
    outline: none;
    transition: all 0.3s ease;
    box-sizing: border-box;
    width: 100%;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(89, 54, 58, 0.4);
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    background-color: var(--white);
    border-color: var(--burgundy);
    box-shadow: 0 4px 20px rgba(89, 54, 58, 0.05);
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .select-wrapper select {
    appearance: none;
    cursor: pointer;
  }

  .select-wrapper::after {
    content: "↓";
    font-family: 'Tenor Sans', sans-serif;
    position: absolute;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--burgundy);
    pointer-events: none;
    font-size: 0.9rem;
  }

  
  .desktop-only {
    display: block;
  }

  @media (max-width: 820px) {
    .contact-gradient-wrapper {
      background: linear-gradient(
        to bottom, 
        #59363A 0%, 
        #59363A 22%, 
        #8A6266 40%,
        #BA9699 55%,
        #DFCDC9 70%,
        #FEF4EF 85%, 
        #FEF4EF 100%
      );
      padding: calc(5rem + 70px) 1.5rem 5rem 1.5rem;
    }

    .desktop-only {
      display: none;
    }

    .contact-hero {
      text-align: center;
      margin-bottom: 4rem;
    }

    .main-title {
      font-size: 2.75rem;
    }

    .contact-content-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .content-left {
      align-items: center;
      width: 100%;
    }

    .editorial-info-card {
      padding: 2.5rem 2rem;
      width: 100%;
      max-width: 550px;
      box-sizing: border-box;
    }

    .contact-desc {
      margin-bottom: 2rem;
    }

    .card-line {
      margin: 2rem 0 0 0;
    }

    .content-right {
      width: 100%;
      max-width: 550px;
      margin: 0 auto;
    }

    .form-group label {
      text-align: left;
    }

 
  }
</style>
