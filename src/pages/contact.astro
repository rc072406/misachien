---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
import StickyNotes2 from '../components/StickyNotes2.astro';

const pageTitle = "Contact Misa Chien | Speaking, Press & Coaching Inquiries";
const pageDescription = "Get in touch with Misa Chien for executive coaching frameworks, keynote speaking engagements, media partnerships, or general inquiries.";

import contactImage from '../../public/images/GL5A6164.webp';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Misa Chien",
  "description": "Official contact and booking channel for Misa Chien, founder of The Authentic Asian.",
  "url": "https://misachien.com/contact",
  "mainEntity": {
    "@type": "Person",
    "name": "Misa Chien",
    "sameAs": [
      "https://www.instagram.com/misa_chien/",
      "https://www.linkedin.com/in/misachien",
      "https://substack.com/@misachien"
    ]
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={contactImage.src}>
  
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  
  <main class="contact-container">
    
    <div class="contact-hero-wrapper">
      <section class="contact-hero">
        <span class="subtitle">Get In Touch</span>
        <h1 class="main-title">
          Let's Create <br class="desktop-only" />
          <span class="serif-italic">Meaningful Connections</span>
        </h1>
      </section>
    </div>

    <section class="contact-content-grid">
      
      <div class="content-left">
        <div class="hero-image-container">
          <img src={contactImage.src} alt="Misa Chien Contact" class="visual-canvas-image" />
        </div>
        <StickyNotes2 />
      </div>

      <div class="content-right">
        
        <div class="editorial-info-card">
          <h2 class="section-heading">Reach Out</h2>
          <p class="contact-desc">
            Whether you are looking to scale your business, release limiting beliefs, or invite Misa to speak at your next event, we would love to hear from you.
          </p>
          
          <div class="contact-details">
            <div class="detail-item">
              <span class="detail-label">General Inquiries</span>
              <p class="detail-text">support@theauthenticasian.com</p>
            </div>
            <div class="detail-item">
              <span class="detail-label">Speaking & Press</span>
              <p class="detail-text">bernadine@theauthenticasian.com</p>
            </div>
          </div>

          <div class="card-line"></div>
        </div>

        <div class="form-container">
          <form action="https://api.web3forms.com/submit" method="POST" class="web3form">
            
            <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
            <input type="checkbox" name="botcheck" class="honeypot" style="display: none;" />
            <input type="hidden" name="redirect" value="https://misachien.com/thanks" />

            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name" />
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="your.email@example.com" />
            </div>

            <div class="form-group">
              <label for="subject">Inquiry Type</label>
              <div class="select-wrapper">
                <select id="subject" name="subject" required>
                  <option value="" disabled selected>Select an option</option>
                  <option value="Mindset & Business Coaching">Mindset & Business Coaching</option>
                  <option value="Speaking Engagements">Speaking Engagements</option>
                  <option value="Media & Press">Media & Press</option>
                  <option value="General Connection">General Inquiries</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="message">Your Message</label>
              <textarea id="message" name="message" rows="6" required placeholder="How can Misa support your journey?"></textarea>
            </div>

            <button type="submit" class="btn-filled">
              <span>Send Message</span>
            </button>

          </form>
        </div>

      </div>
    </section>

    <TypeWriter3 />

  </main>
</BaseLayout>

<style>
  /* ==========================================================
     DESIGN SYSTEM TOKENS (Uniform Quiet Luxury)
     ========================================================== */
  :root {
    --bg-solid-light: #FBF9F6;  /* Premium corporate white soft canvas */
    --text-primary: #1A1A1A;    /* Stark, uniform off-black text */
    --text-muted: #55514E;      /* Understated secondary grey */
    --accent-gold: #8C7E6D;     /* Sophisticated luxury bronze branding */
    
    --font-serif: 'Libre Baskerville', serif;
    --font-sans: 'Helvetica Neue', 'Inter', sans-serif;
  }

  .contact-container {
    width: 100%;
    max-width: 100vw;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--bg-solid-light);
    overflow-x: hidden;
  }

  /* ==========================================================
     HERO LAYOUT
     ========================================================== */
  .contact-hero-wrapper {
    position: relative;
    width: 100%;
    background-color: var(--bg-solid-light);
    padding: 10rem 4rem 4rem 4rem; 
    box-sizing: border-box;
  }

  .contact-hero {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    color: var(--text-primary);
  }

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -1px;
    text-transform: uppercase;
    margin: 0;
    color: var(--text-primary);
  }

  .serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: none; 
    color: var(--accent-gold);
    letter-spacing: 0;
  }

  /* ==========================================================
     TWO-COLUMN CONTENT FRAMEWORK
     ========================================================== */
  .contact-content-grid {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    padding: 0 4rem 8rem 4rem;
    align-items: start;
  }

  .content-left {
    display: flex;
    flex-direction: column;
    gap: 4rem; 
  }

  .hero-image-container {
    position: relative;
    width: 100%;
  }

  .visual-canvas-image {
    width: 100%;
    height: auto;
    object-fit: cover; 
    border: 1px solid #EAE5E0;
    border-radius: 0 !important; /* Forces strict square layout rules */
    display: block;
  }

  /* ==========================================================
     RIGHT VIEWPORT INTERFACE
     ========================================================== */
  .content-right {
    color: var(--text-primary); 
    display: flex;
    flex-direction: column;
    gap: 4rem; 
  }

  .editorial-info-card {
    background-color: transparent; 
    border-left: 2px solid var(--accent-gold);
    padding: 0.5rem 0 0.5rem 2rem;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 1.5rem 0;
  }

  .contact-desc {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 2.5rem;
    color: var(--text-muted);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail-label {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 0.4rem;
  }

  .detail-text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0;
    word-break: break-all;
  }

  .card-line {
    display: none; /* Removed physical baseline divider decoration */
  }

  /* ==========================================================
     FORM FRAMEWORK INTERACTIVE STYLING
     ========================================================== */
  .form-container {
    width: 100%;
  }

  .web3form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .form-group label {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-primary);
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1rem;
    padding: 1rem 1.25rem;
    background-color: #FFFFFF;
    border: 1px solid #D6D0C8;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
    width: 100%;
    border-radius: 0 !important; /* Sharp inputs mandatory */
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #999591;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    border-color: var(--text-primary);
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .select-wrapper select {
    appearance: none;
    cursor: pointer;
    padding-right: 3rem;
  }

  .select-wrapper::after {
    content: "↓";
    font-family: var(--font-sans);
    position: absolute;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
    font-size: 0.85rem;
  }

  .btn-filled {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: none;
    background-color: var(--text-primary);
    color: #FFFFFF;
    padding: 1.1rem 2.5rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
    border-radius: 0 !important;
  }

  .btn-filled:hover {
    opacity: 0.9;
  }

  .desktop-only {
    display: block;
  }

  /* ==========================================================
     RESPONSIVE BREAKPOINTS
     ========================================================== */
  @media (max-width: 900px) {
    .contact-hero-wrapper {
      padding: 8rem 1.5rem 3rem 1.5rem;
    }

    .desktop-only {
      display: none;
    }

    .main-title {
      font-size: 2.8rem;
    }

    .contact-content-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
      padding: 0 1.5rem 6rem 1.5rem;
    }

    .content-left {
      align-items: flex-start;
      width: 100%;
    }

    .editorial-info-card {
      padding: 0.5rem 0 0.5rem 1.5rem;
    }

    .detail-text {
      font-size: 1.1rem;
    }

    .content-right {
      width: 100%;
    }

    .btn-filled {
      width: 100%;
      text-align: center;
    }
  }
</style>
