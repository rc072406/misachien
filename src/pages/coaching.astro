---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
---

<BaseLayout title="Coaching | Misa Chien">
  <main class="coaching-container">
    
    <div class="coaching-hero-gradient" data-theme="start">
      <section class="coaching-hero reveal-on-scroll">
        <span class="subtitle">Subconscious Rewiring & Strategy</span>
        <h1 class="main-title">
          Reprogram Your <br class="desktop-only" />
          <span class="serif-italic">Unconscious Mind</span>
        </h1>
        <p class="hero-intro">
          Dismantle deeply rooted limiting beliefs and release the immigrant scarcity mindset. Move beyond survival mode and step fully into authentic leadership.
        </p>
      </section>
    </div>

    <section class="methodology-section" data-theme="light">
      <div class="methodology-grid reveal-on-scroll">
        <div class="methodology-left">
          <span class="section-label">The Methodology</span>
          <h2 class="section-heading">Unconscious Alignment</h2>
        </div>
        <div class="methodology-right">
          <p class="philosophy-text">
            Many high-achieving individuals of Asian descent carry an inherited blueprint of survival—an underlying constraint that dictates you must struggle, sacrifice, and constantly fear losing what you have built. 
          </p>
          <p class="philosophy-text">
            Misa works directly with your unconscious mind to untangle these cultural frameworks. By replacing reactive anxiety with internal certainty, you transform your relationship with wealth, work, and personal freedom.
          </p>
        </div>
      </div>
    </section>

    <section class="tracks-section" data-theme="dark">
      <div class="tracks-container">
        
        <div class="tracks-header reveal-on-scroll">
          <span class="subtitle">Designed Frameworks</span>
          <h2 class="tracks-main-heading">Two Paths to Alignment</h2>
        </div>

        <div class="tracks-grid">
          
          <div class="track-card reveal-on-scroll">
            <div class="track-meta">
              <span class="track-num">TRACK 01</span>
              <h3 class="track-title">The Seven-Figure Accelerator</h3>
            </div>
            <div class="track-body">
              <p class="track-target">For Founders Scaling from $250k to $1M+</p>
              <div class="track-line"></div>
              <p class="track-desc">
                A high-impact synthesis of tactical business frameworking and subconscious threshold conditioning. To cross the seven-figure threshold, you must break through the identity ceilings that keep you micro-managing your operations.
              </p>
              <ul class="track-features">
                <li>Strategic scaling architecture and team optimization.</li>
                <li>Identifying and clearing revenue-blocking limiting beliefs.</li>
                <li>Transitioning from a tactical worker to a visionary executive.</li>
              </ul>
            </div>
          </div>

          <div class="track-card reveal-on-scroll">
            <div class="track-meta">
              <span class="track-num">TRACK 02</span>
              <h3 class="track-title">The Executive Sanctuary</h3>
            </div>
            <div class="track-body">
              <p class="track-target">For C-Levels & Late-Stage Founders</p>
              <div class="track-line"></div>
              <p class="track-desc">
                A dedicated, confidential expansion space engineered to decouple your self-worth from your net worth. If you have already achieved massive external wealth but still carry the phantom weight of survival mode, this is your path back to peace.
              </p>
              <ul class="track-features">
                <li>Releasing inherited generational scarcity mindsets.</li>
                <li>Deconstructing chronic burnout cycles and nervous system strain.</li>
                <li>Learning the art of strategic rest and actually enjoying your success.</li>
              </ul>
            </div>
          </div>

        </div>

        <div class="coaching-cta reveal-on-scroll">
          <p class="cta-text">Ready to recondition your unconscious framework?</p>
          <a href={`${import.meta.env.BASE_URL}/contact`} class="btn-filled">
            <span>Apply For Coaching</span>
          </a>
        </div>

      </div>
    </section>
  <TypeWriter3    />

  </main>
</BaseLayout>

<style>
  .coaching-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--white);
  }


  .coaching-hero-gradient {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(
      to right, 
      #59363A 0%, 
      #59363A 6%, 
      #8A6266 25%,
      #BA9699 38%,
      #DFCDC9 48%,
      #FEF4EF 58%, 
      #FEF4EF 100%
    );
    padding: calc(7rem + 80px) 4rem 8rem 4rem; 
    box-sizing: border-box;
  }

  .coaching-hero-gradient::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    opacity: 0.025; 
    pointer-events: none;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 150 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='silk'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23silk)'/%3E%3C/svg%3E");
  }

  .coaching-hero {
    max-width: 1200px;
    margin: 0 auto;
    color: var(--white);
  }

  .subtitle {
    font-family: 'Tenor Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7); 
    display: block;
    margin-bottom: 1rem;
  }

  .main-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 4.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--coral);
  }

  .serif-italic {
    font-family: 'GF Didot', serif;
    font-style: italic;
    text-transform: none; 
    color: #DFCDC9; 
  }

  .hero-intro {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.15rem;
    line-height: 1.8;
    max-width: 600px;
    color: var(--white);
    opacity: 0.9;
  }

  /* --- METHODOLOGY OVERVIEW --- */
  .methodology-section {
    width: 100%;
    background-color: #FEF4EF; 
    padding: 8rem 4rem;
    box-sizing: border-box;
  }

  .methodology-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .section-label {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--coral);
    display: block;
    margin-bottom: 0.75rem;
  }

  .methodology-left .section-heading {
    color: var(--burgundy);
    font-size: 2.2rem;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .methodology-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    color: var(--burgundy);
  }

  .philosophy-text {
    font-family: 'Poppins', sans-serif;
    font-size: 1.05rem;
    line-height: 1.8;
    font-weight: 300;
    opacity: 0.9;
  }

  /* --- TRACKS LAYOUT BLOCK --- */
  .tracks-section {
    width: 100%;
    background-color: var(--burgundy);
    padding: 10rem 4rem;
    box-sizing: border-box;
    color: var(--white);
  }

  .tracks-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .tracks-header {
    text-align: center;
    margin-bottom: 6rem;
  }

  .tracks-main-heading {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 3rem;
    color: var(--white);
    text-transform: uppercase;
    margin-top: 0.5rem;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .track-card {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .track-card:hover {
    border-color: rgba(231, 120, 96, 0.4);
    transform: translateY(-4px);
  }

  .track-num {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 2px;
    color: var(--coral);
    display: block;
    margin-bottom: 0.5rem;
  }

  .track-title {
    font-family: 'Tenor Sans', sans-serif;
    font-size: 1.8rem;
    color: var(--white);
    text-transform: uppercase;
    font-weight: 400;
  }

  .track-target {
    font-family: 'GF Didot', serif;
    font-style: italic;
    font-size: 1.2rem;
    color: #DFCDC9;
    margin-bottom: 1.25rem;
  }

  .track-line {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 2rem;
  }

  .track-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 300;
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  .track-features {
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 300;
    opacity: 0.8;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .track-features li {
    position: relative;
    list-style: none;
  }

  .track-features li::before {
    content: "—";
    position: absolute;
    left: -1.2rem;
    color: var(--coral);
  }

  /* --- CALL TO ACTION --- */
  .coaching-cta {
    margin-top: 8rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

.coaching-cta .btn-filled {
  display: inline-block;
  align-self: center;
  text-align: center;
  width: auto;        
}

  .cta-text {
    font-family: 'GF Didot', serif;
    font-style: italic;
    font-size: 1.6rem;
    color: #DFCDC9;
  }

  

  /* --- RESPONSIVE WORKFLOWS --- */
  .desktop-only {
    display: block;
  }

  @media (max-width: 820px) {
    .coaching-hero-gradient {
      background: linear-gradient(
        to bottom, 
        #59363A 0%, 
        #59363A 22%, 
        #8A6266 40%,
        #BA9699 55%,
        #DFCDC9 70%,
        #FEF4EF 85%, 
        #FEF4EF 100%
      );
      padding: calc(5rem + 70px) 1.5rem 6rem 1.5rem;
    }

    .desktop-only {
      display: none;
    }

    coaching-hero {
      text-align: left; 
    }

    .main-title {
      font-size: 2.75rem;
    }

    .hero-intro {
      margin: 0; 
      font-size: 1.05rem;
    }

    .methodology-section {
      padding: 5rem 1.5rem;
    }

    .methodology-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: left; 
    }

    .methodology-left .section-heading {
      font-size: 1.8rem;
    }

    .tracks-section {
      padding: 6rem 1.5rem;
    }

    .tracks-header {
      margin-bottom: 4rem;
    }

    .tracks-main-heading {
      font-size: 2.25rem;
    }

    .tracks-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .track-card {
      padding: 3rem 2rem;
    }

    .coaching-cta {
      margin-top: 6rem;
    }

    .cta-text {
      font-size: 1.35rem;
    }

 
  }
</style>
