---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../../public/images/GL5A4559.webp';
import alinaImage from '../../public/images/Alinalee.webp';
const pageTitle = "Unconscious Mind Coaching for AAPI Leaders & Entrepreneurs | Misa Chien";
const pageDescription = "Dismantle the immigrant scarcity mindset, break through internal ceilings, and step into authentic leadership. Explore premium coaching tracks with Misa Chien.";
const coachingSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Executive & Mindset Coaching",
  "provider": {
    "@type": "Person",
    "name": "Misa Chien",
    "url": "https://misachien.com"
  },
  "areaServed": "Worldwide",
  "description": "Unconscious mind coaching specifically engineered for high-achieving individuals of Asian descent to deconstruct deeply rooted limiting beliefs and immigrant scarcity mindsets.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Misa Chien Coaching Frameworks",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Track 01: Scaling Entrepreneurs",
          "description": "Mindset reprogramming for 6-figure business owners aiming to scale to 7-figures by clearing internal ceilings and shifting out of survival mode."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Track 02: C-Suite & Late-Stage Leaders",
          "description": "Deep internal clarity and scarcity mindset release for senior corporate executives, C-level leaders, and late-stage founders."
        }
      }
    ]
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={heroImage.src}>
  <script type="application/ld+json" set:html={JSON.stringify(coachingSchema)} />
  
  <main class="coaching-container">
    
    <div class="coaching-hero-wrapper">
     <section class="coaching-hero">
  <div class="hero-text">
    <span class="subtitle">Your Journey Begins</span>
    <h1 class="main-title">
      Reprogram Your <br class="desktop-only" />
      <span class="serif-italic">Unconscious Mind</span>
    </h1>
    <p class="hero-intro">
      Dismantle deeply rooted limiting beliefs and release the immigrant scarcity mindset. Move beyond survival mode and step fully into authentic leadership.
    </p>
  </div>

  <div class="hero-image-container">
    <img src={heroImage.src} alt="Misa Chien Unconscious Mind Coaching" class="hero-img" />
  </div>
</section>
    </div>
<section class="testimonial-section">
      <div class="testimonial-grid">
        
        <div class="testimonial-left">
          <span class="testimonial-label">Client Testimonial | Track 02 | C-Suite & Late-Stage Leaders</span>
          
          <div class="quote-wrapper">
            <span class="quote-mark">“</span>
            <blockquote class="testimonial-quote">
              I highly recommend Misa's 'High Achiever Breakthrough Call' sessions! She helped me to identify one of my core limiting beliefs, which is that "I need to do more" to make up for feeling like 'I'm not doing enough.' She helped me to see that this belief stems from a core insecurity in my childhood, which in itself stems back to my mom and grandmother's childhood traumas. By being able to identify the pain of my ancestors and how that led to my childhood pain, I was able to let go of that belief. By seeing the belief in its totality, it lost much of its power over me. I'm so thankful for Misa's guidance, vulnerability, and encouragement, which allowed me to feel safe to dive deep into myself, which was the key to my epiphany. Thank you, Misa! If you feel like you may be holding yourself back despite getting years of therapy, I recommend having a few sessions with Misa! You deserve it!
            </blockquote> </div>

          <div class="testimonial-attribution">
            <span class="quote-mark">”</span>
            <p class="attribution-name">Alina Lee</p>
            <p class="attribution-title">Founding Partner, Aspire Law</p>
          </div>
        </div>

        <div class="testimonial-right">
          <div class="testimonial-image-frame">
            <img src={alinaImage.src} alt="Alina Lee, Founding Partner of Aspire Law" class="testimonial-img" />
          </div>
        </div>

      </div>
    </section>

    <section class="methodology-section">
      <div class="methodology-grid">
        <div class="methodology-left">
          <span class="section-label">The Methodology</span>
          <h2 class="section-heading">Unconscious Mind Coaching</h2>
        </div>
        
        <div class="methodology-right">
          <p class="philosophy-text">
            Many high-achieving individuals of Asian descent carry an inherited blueprint of survival—an underlying constraint that dictates you must struggle, sacrifice, and constantly fear losing what you have built. 
          </p>
          <p class="philosophy-text">
            Misa works directly with your unconscious mind to untangle these cultural frameworks. By replacing reactive anxiety with internal certainty, you transform your relationship with wealth, work, and personal freedom.
          </p>
        </div>
      </div>
    </section>

    <section class="tracks-section">
      <div class="tracks-container">
        
        <div class="tracks-header">
          <span class="track-subtitle">Designed Frameworks</span>
          <h2 class="tracks-main-heading">Which Path is Yours?</h2>
        </div>

        <div class="tracks-grid">
          
          <div class="track-card">
            <span class="track-badge">Unconscious Mind Coaching</span>
            <div class="track-meta">
              <span class="track-num">TRACK 01</span>
              <h3 class="track-title">SCALING ENTREPRENEURS</h3>
            </div>
            
            <div class="track-body">
              <p class="track-target">You built something real.
Now your mind needs to catch up.</p>
              <div class="track-line"></div>
              <p class="track-desc">
                You've crossed six figures. The strategy isn't the problem anymore — the ceiling is inside you. I work with entrepreneurs to reprogram the unconscious patterns quietly running the show, so scaling to seven figures feels like expansion, not survival.
              </p>
              <ul class="track-features">
                <li>For entrepreneurs already at six figures, ready to grow without grinding harder.</li>
              </ul>
              <a href="/contact" class="track-btn">
                <span>Learn About Track 01</span>
              </a>
            </div>
          </div>

          <div class="track-card">
            <span class="track-badge">Unconscious Mind Coaching</span>
            <div class="track-meta">
              <span class="track-num">TRACK 02</span>
              <h3 class="track-title">C-SUITE & LATE-STAGE LEADERS</h3>
            </div>
            
            <div class="track-body">
              <p class="track-target">You've achieved everything.
So why doesn't it feel that way?</p>
              <div class="track-line"></div>
              <p class="track-desc">
                You've led companies, rooms, and people your whole career. But scarcity still whispers. Old wounds still shape your decisions. I work with executives and late-stage entrepreneurs to release what's underneath — so your choices come from clarity, not fear, and your life finally feels like yours.
              </p>
              <ul class="track-features">
                <li>For C-suite leaders and senior entrepreneurs ready to be as free inside as they appear outside.</li>
              </ul>
              <a href="/contact" class="track-btn">
                <span>Learn About Track 02</span>
              </a>
            </div>
          </div>

        </div>

        <div class="coaching-cta">
          <p class="cta-text">Not sure yet? Take my complimentary workshop to see if this is for you.</p>
          <a href="/free-workshop" class="btn-filled">
            <span>Take the Workshop</span>
          </a>
        </div>

      </div>
    </section>



  </main>
</BaseLayout>

<style>
  :root {
    --bg-solid-light: #FBF9F6;  
    --bg-solid-dark: #59363B;  
    --text-primary: #59363B;   
    --text-muted: #6B4E52;    
    --accent-gold: #8C7E6D;    
    --accent-highlight: #E7765D; 
    
    --font-serif: 'Libre Baskerville', serif;
    --font-sans: 'Helvetica Neue', 'Inter', sans-serif;
  }

  .coaching-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--bg-solid-light);
  }

  /* ==========================================================
     HERO STYLING
     ========================================================== */
  .coaching-hero-wrapper {
    position: relative;
    width: 100%;
    background-color: var(--bg-solid-light);
    padding: 10rem 4rem 6rem 4rem; 
    box-sizing: border-box;
    border-bottom: 1px solid #EAE5E0;
  }

.coaching-hero {
  max-width: 1200px;
  margin: 0 auto;
  color: var(--text-primary);
  display: grid;
  grid-template-columns: 1.2fr 1fr; 
  gap: 4rem;
  align-items: center;
}

.hero-image-container {
  width: 100%;
  display: flex;
  justify-content: flex-end;
}

.hero-img {
  width: 100%;
  max-width: 500px; 
  height: auto;
  object-fit: cover;
}

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    color: var(--accent-highlight);
    display: block;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -1px;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--text-primary);
  }

  .serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: none; 
    color: var(--accent-gold); 
    letter-spacing: 0;
  }
.testimonial-section {
    width: 100%;
    background-color: #FFFFFF;
    padding: 7rem 4rem;
    box-sizing: border-box;
    border-bottom: 1px solid var(--border-color);
  }

  .testimonial-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .testimonial-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .testimonial-label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 2rem;
    display: block;
  }

  .quote-wrapper {
    position: relative;
    margin-bottom: 2rem;
  }

  .quote-mark {
    font-family: var(--font-serif);
    font-size: 6rem;
    color: rgba(140, 126, 109, 0.15);
    position: absolute;
    top: -2.5rem;
    left: -1rem;
    line-height: 1;
    user-select: none;
  }

  .testimonial-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1.7;
    color: var(--text-primary);
    margin: 0;
    position: relative;
    z-index: 2;
  }

  .testimonial-attribution {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
    width: fit-content;
  }

  .attribution-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .attribution-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin: 0;
  }

  .testimonial-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .testimonial-image-frame {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4 / 5;
    background-color: var(--bg-solid-light);
    box-sizing: border-box;
    padding: 1rem;
   border: 1px solid #EAE5E0;
  }

  .testimonial-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block; 
}
  .hero-intro {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.15rem;
    line-height: 1.8;
    max-width: 650px;
    color: var(--text-muted);
    margin: 0;
  }


  .methodology-section {
    width: 100%;
    background-color: var(--bg-solid-light); 
    padding: 5rem 4rem;
    box-sizing: border-box;
    border-bottom: 1px solid #EAE5E0;
  }

  .methodology-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: start;
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent-highlight);
    display: block;
    margin-bottom: 1rem;
  }

  .methodology-left .section-heading {
    font-family: var(--font-serif);
    color: var(--text-primary);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }

  .methodology-right {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    color: var(--text-muted);
  }

  .philosophy-text {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.8;
    font-weight: 500;
    margin: 0;
  }


  .tracks-section {
    width: 100%;
    background-color: var(--bg-solid-dark);
    padding: 5rem 4rem;
    box-sizing: border-box;
    color: #FFFFFF;
  }

  .tracks-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .tracks-header {
    text-align: left;
    margin-bottom: 5rem;
  }

  .track-subtitle {
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    color: var(--accent-highlight);
    display: block;
    margin-bottom: 1rem;
  }

  .tracks-main-heading {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 400;
    color: #FFFFFF;
    margin: 0;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .track-card {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 4rem 3.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    border-radius: 0 !important; 
  }

  .track-badge {
    align-self: flex-start;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    padding: 0.4rem 1rem;
    margin-bottom: 2.5rem;
  }

  .track-meta {
    margin-bottom: 2rem;
  }

  .track-num {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 2px;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 0.5rem;
  }

  .track-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: #FFFFFF;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .track-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .track-target {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--accent-gold); 
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
  }

  .track-line {
    width: 60px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-bottom: 2rem;
  }

  .track-desc {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 500;
    color: #E2D9DA;
    margin: 0 0 2rem 0;
  }

  .track-features {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 500;
    color: #C5C1BD;
    padding-left: 0;
    margin: 0 0 3rem 0;
    list-style: none;
  }

  .track-features li {
    position: relative;
    padding-left: 1.5rem;
  }

  .track-features li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--accent-gold);
  }

  .track-btn {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 1rem 2rem;
    transition: all 0.25s ease;
  }

  .track-btn:hover {
    background-color: #FFFFFF;
    color: var(--bg-solid-dark);
    border-color: #FFFFFF;
  }

  .coaching-cta {
    margin-top: 6rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 5rem;
  }

  .cta-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    color: #EAE5E0;
    margin: 0;
  }

  .btn-filled {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    background-color: #FFFFFF; 
    color: var(--bg-solid-dark);
    padding: 1.1rem 2.5rem;
    transition: all 0.3s ease;
  }

  .btn-filled:hover {
    background-color: var(--accent-highlight);
    color: #FFFFFF;
  }

  .desktop-only {
    display: block;
  }

  /* ==========================================================
     RESPONSIVE BREAKPOINTS
     ========================================================== */
  @media (max-width: 900px) {
    .coaching-hero-wrapper {
      padding: 8rem 1.5rem 4rem 1.5rem;
    }
.coaching-hero {
    grid-template-columns: 1fr; 
    gap: 3rem;
  }

  .hero-image-container {
    justify-content: center; 
  }

    .desktop-only {
      display: none;
    }

    .main-title {
      font-size: 2.8rem;
    }

    .methodology-section {
      padding: 5rem 1.5rem;
    }

    .methodology-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .methodology-left .section-heading {
      font-size: 1.8rem;
    }

    .tracks-section {
      padding: 3rem 1.5rem;
    }

    .tracks-header {
      margin-bottom: 3rem;
    }

    .tracks-main-heading {
      font-size: 2.25rem;
    }

    .tracks-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .track-card {
      padding: 3rem 2rem;
    }

    .coaching-cta {
      margin-top: 4rem;
      padding-top: 4rem;
    }

    .cta-text {
      font-size: 1.3rem;
    }
    
    .track-btn {
      display: block;
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
.testimonial-section {
      padding: 5rem 1.5rem;
    }

    .testimonial-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

   .testimonial-image-frame {
    max-width: 320px;      
    margin: 0 auto;        
    aspect-ratio: 4 / 5;    
    width: 100%;
  }

  .testimonial-right {
    grid-row: 1; 
    width: 100%;
    display: flex;
    justify-content: center; 
  }

    .testimonial-quote {
      font-size: 1.25rem;
    }
  }
</style>
