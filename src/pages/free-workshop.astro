---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';

const baseVideoUrl = import.meta.env.PUBLIC_YOUTUBE_URL;
const workshopVideoUrl = `${baseVideoUrl}?autoplay=1&mute=1&modestbranding=1&disablekb=1&rel=0&vq=hd720`;

const pageTitle = "Free Workshop: Master Your Unconscious Mind | Misa Chien";
const pageDescription = "Get instant access to Misa Chien's free exclusive training on dismantling deeply rooted limiting beliefs, releasing scarcity mindsets, and processing generational patterns.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const workshopSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Master Your Unconscious Mind Workshop",
  "description": pageDescription,
  "provider": {
    "@type": "Person",
    "name": "Misa Chien",
    "url": "https://misachien.com"
  },
  "offers": {
    "@type": "Offer",
    "price": "0.00",
    "priceCurrency": "USD",
    "category": "Free",
    "availability": "https://schema.org/InStock",
    "url": canonicalURL
  },
  "educationalLevel": "Intermediate"
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(workshopSchema)} />
  
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <main class="workshop-container">
    <div class="workshop-content-wrapper">
      
      <div class="workshop-grid" id="main-grid">
        
        <section class="workshop-hero">
          <span class="subtitle">Exclusive Training</span>
          <h1 class="main-title">
            Master Your <br class="desktop-only" />
            <span class="serif-italic">Unconscious Mind</span>
          </h1>
          <p class="hero-description">
            Enter your name and email to secure instantaneous access to this exclusive framework designed to dismantle deeply rooted limiting beliefs.
          </p>
        </section>

        <section class="form-section" id="opt-in-section">
          <h3 class="form-heading">Access The Workshop</h3>
          <form id="workshop-form" class="optin-form">
            <div class="input-group">
              <label for="fullName">Full Name</label>
              <input type="text" id="fullName" name="fullName" required placeholder="Jane Doe" />
            </div>
            <div class="input-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="jane@example.com" />
            </div>
            <button type="submit" class="form-submit-btn"><span>Watch Workshop Now</span></button>
          </form>
        </section>
        
      </div>

      <section class="hidden-content" id="video-section" style="display: none;">
        
        <div class="video-container">
          <iframe 
            src={workshopVideoUrl} 
            title="YouTube video player" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>

        <section class="funnel-coaching-cta" id="interactive-banner">
          <div class="funnel-content-left">
            <span class="funnel-pre-title">Strategic Integration</span>
            <h2 class="funnel-accent-text">Work With Misa to Overcome Scarcity Mindset</h2>
          </div>
          
          <div class="funnel-actions-right">
            <p class="funnel-supporting-text">
              These structured breakthrough sessions are configured to target emotional architecture, generational blocks, and architectural biases currently impacting leadership performance. Request tracking placement on the consultation waitlist below.
            </p>
            <a href="https://ut9kw2xefxf.typeform.com/to/JgPoLbVE" target="_blank" class="banner-btn"><span>Request Consultation →</span></a>
          </div>
        </section>

      </section>
    </div>
    <TypeWriter3 />
  </main>
</BaseLayout>

<style>
  :root {
  
    --bg-solid-light: #FBF9F6;  
    --text-primary: #1A1A1A;   
    --text-muted: #55514E;      
    --accent-gold: #8C7E6D;     
    --border-color: #EAE5E0;
    
   
    --font-serif: 'Libre Baskerville', Georgia, serif;
    --font-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  .workshop-container {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--bg-solid-light);
  }

  .workshop-content-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    padding: calc(8rem + 80px) 4rem 8rem 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .workshop-grid {
    width: 100%;
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 6rem;
    align-items: center;
  }

  .workshop-hero {
    text-align: left;
    color: var(--text-primary);
  }

  .subtitle {
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    color: var(--accent-gold);
    display: block;
    margin-bottom: 1.5rem;
  }

  .main-title {
    font-family: var(--font-serif);
    font-size: 3.75rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    color: var(--text-primary);
  }

  .serif-italic {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none; 
    color: var(--accent-gold);
    letter-spacing: 0;
  }

  .hero-description {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-muted);
    max-width: 520px;
    width: 100%; 
    box-sizing: border-box;
  }

  .form-section {
    width: 100%;
    padding: 4rem 3.5rem;
    background-color: #FFFFFF; 
    border: 1px solid var(--border-color);
    box-sizing: border-box;
    border-radius: 0 !important; 
  }

  .form-heading {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2.5rem;
  }

  .optin-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .input-group input {
    font-family: var(--font-sans);
    font-weight: 500;
    padding: 1.1rem;
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-size: 1rem;
    transition: border-color 0.3s ease;
    width: 100%; 
    box-sizing: border-box;
    border-radius: 0 !important;
  }

  .input-group input:focus {
    outline: none;
    border-color: var(--accent-gold);
  }

  .input-group input::placeholder {
    color: #A09A95;
  }

 
  .form-submit-btn {
    margin-top: 1rem;
    width: 100%;
    text-align: center;
    background-color: var(--text-primary);
    border: 1px solid var(--text-primary);
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 1.25rem 2rem;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    border-radius: 0 !important;
  }

  .form-submit-btn:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .hidden-content {
    width: 100%;
    max-width: 1000px;
    margin-top: 2rem;
  }

  .video-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000000;
    border: 1px solid var(--border-color);
    margin-bottom: 5rem;
    border-radius: 0 !important;
  }

  .video-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .funnel-coaching-cta {
    background-color: #FFFFFF;
    border: 1px solid var(--border-color);
    padding: 5rem 4.5rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 5rem;
    align-items: center;
    border-radius: 0 !important;
  }

  .funnel-content-left, .funnel-actions-right {
    position: relative;
  }

  .funnel-pre-title {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 3px;
    color: var(--accent-gold);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .funnel-accent-text {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2.2rem;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
    text-transform: uppercase;
  }

  .funnel-actions-right {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-left: 1px solid var(--border-color);
    padding-left: 4rem;
  }

  .funnel-supporting-text {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin: 0;
  }

  .banner-btn {
    align-self: flex-start;
    width: auto;
    display: inline-block;
    box-sizing: border-box;
    text-align: center;
    background-color: var(--text-primary);
    border: 1px solid var(--text-primary);
    padding: 1.25rem 2.5rem;
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.85rem;
    text-decoration: none;
    color: #FFFFFF;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    border-radius: 0 !important;
  }

  .banner-btn:hover {
    background-color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  /* --- Responsive Framework --- */
  @media (max-width: 992px) {
    .workshop-grid {
      gap: 3.5rem;
    }
    .main-title {
      font-size: 3rem;
    }
    .funnel-coaching-cta {
      gap: 3rem;
      padding: 4rem 3rem;
    }
  }

  @media (max-width: 820px) {
    .workshop-content-wrapper {
      padding: calc(5rem + 70px) 1.5rem 5rem 1.5rem;
    }

    .workshop-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .desktop-only {
      display: none;
    }

    .main-title {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
    }

    .form-section {
      padding: 3rem 2rem;
    }

    .funnel-coaching-cta {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 4rem 2rem;
    }

    .funnel-accent-text {
      font-size: 1.85rem;
    }

    .funnel-actions-right {
      border-left: none;
      padding-left: 0;
      gap: 2rem;
    }
    
    .banner-btn {
      display: block;
      align-self: stretch;
      width: 100%;
    }
  }
</style>

<script is:inline>
  function setupWorkshopForm() {
    const form = document.getElementById('workshop-form');
    const mainGrid = document.getElementById('main-grid');
    const videoSection = document.getElementById('video-section');

    if (!form || !mainGrid || !videoSection) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      const formData = new FormData(form);
      const payload = {
        fullName: formData.get('fullName'),
        email: formData.get('email'),
        source: 'Free Workshop' 
      };

      const ZAPIER_WEBHOOK_URL = 'https://hooks.zapier.com/hooks/catch/4323182/427ea3z/';
      
      fetch(ZAPIER_WEBHOOK_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      }).catch(err => console.error("Data submission failed:", err));
      
      mainGrid.style.display = 'none';
      videoSection.style.display = 'block';
      videoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

      setTimeout(() => {
        const reveals = videoSection.querySelectorAll('.reveal-on-scroll');
        reveals.forEach(el => {
          el.classList.add('is-visible');
        });
      }, 50);
    });
  }

  setupWorkshopForm();
  document.addEventListener('astro:page-load', setupWorkshopForm);
</script>
