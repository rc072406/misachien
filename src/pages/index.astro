---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter from '../components/TypeWriter.astro';
import Testimonials from '../components/Testimonials.astro';
import StickyNotes from '../components/StickyNotes.astro';
import TypeWriter2 from '../components/TypeWriter2.astro';

import heroImage from '../../public/images/_51A5829.webp';
---

<BaseLayout title="Misa Chien | Lorem Ipsum Showcase">
	<main transition:animate="fade">
		<section class="hero-section" id="section-one" data-theme="light">
			<div class="hero-container">
				<div class="hero-content">
					<span class="kicker">Lorem Ipsum Dolor Sit</span>
					<TypeWriter 
						staticText="Together let's " 
						words={["stay authentic", "crush limiting beliefs", "heal"]} 
					/>
					<p class="hero-body">
						Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.
					</p>
					<div class="action-wrapper">
						<a href="#" class="btn-filled">Start Your Journey</a>
					</div>
				</div>
				
				<div class="hero-image-container">
					<div class="accent-border-box" transition:name="hero-accent-border"></div>
					<img src={heroImage.src} alt="Misa Chien" class="visual-canvas-image" transition:name="hero-canvas" />
				</div>
			</div>
		</section>
        <TypeWriter2   />

		<Testimonials client:visible />

		<section class="pillars-section" id="section-three" data-theme="light">
			<div class="pillars-container"> <div class="section-lead">
				<span class="kicker">Consectetur Adipiscing</span>
				<h2>Dolor Sit Amet</h2>
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.</p>
			</div>

			<div class="pillars-grid">
				<div class="pillar-card reveal-on-scroll">
					<span class="card-index">01</span>
					<h3>Lorem Ipsum</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
					<a href="#" class="card-action">Read More &rarr;</a>
				</div>

				<div class="pillar-card reveal-on-scroll">
					<span class="card-index">02</span>
					<h3>Dolor Sit</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
					<a href="#" class="card-action">Read More &rarr;</a>
				</div>

				<div class="pillar-card reveal-on-scroll">
					<span class="card-index">03</span>
					<h3>Amet Consectetur</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
					<a href="#" class="card-action">Read More &rarr;</a>
				</div>
			</div>
		</section>
		<StickyNotes client:visible />
	</main>
</BaseLayout>

<style>
.hero-section {
  width: 100%;
  background: linear-gradient(
    to right in oklab, 
    #59363A 0%, 
    #59363A 8%, 
    #8A6266 22%,
    #BA9699 35%,
    #DFCDC9 45%,
    #FEF4EF 55%, 
    #FEF4EF 100% 
  );
}

	.hero-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 7rem 2rem;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 5rem;
		align-items: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
	}

	h1 {
		font-size: 4.25rem;
		line-height: 1.15;
		font-weight: 400;
	}

	.serif-italic {
		font-family: 'GF Didot', serif;
		font-style: italic;
		color: var(--burgundy);
	}

	.hero-body {
		font-size: 1.1rem;
		line-height: 1.75;
		font-weight: 300;
		max-width: 540px;
	}

	.btn-filled {
		position: relative;
		border: 1px solid var(--burgundy); 
		color: var(--burgundy); 
		padding: 1.1rem 2.5rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		display: inline-block;
		overflow: hidden;
		background: transparent;
		z-index: 1;
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-filled span {
		position: relative;
		z-index: 2;
	}

	.btn-filled::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: var(--coral); 
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 1;
	}

	.btn-filled:hover {
		color: var(--white); 
		border-color: var(--coral);
	}

	.btn-filled:hover::before {
		transform: scaleX(1);
	}

	.hero-image-container {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
	}

	.accent-border-box {
		position: absolute;
		inset: 0;
		border: 1px solid var(--coral);
		transform: translate(20px, 20px);
		z-index: 1;
		opacity: 0.5;
	}

	.visual-canvas-image {
		position: relative;
		width: 100%;
		height: 100%;
		object-fit: cover; 
		border: 1px solid rgba(89, 54, 58, 0.1);
		z-index: 2;
	}

	.statement-section {
		background-color: var(--burgundy);
		padding: 7rem 2rem;
		text-align: center;
	}

	.statement-container {
		max-width: 850px;
		margin: 0 auto;
	}

	.statement-container h2 {
		color: var(--white);
		font-size: 2.25rem;
		font-weight: 300;
		line-height: 1.5;
		letter-spacing: 0.5px;
	}

	.decorative-line {
		width: 60px;
		height: 1px;
		background-color: var(--coral);
		margin: 2.5rem auto;
	}

	.statement-author {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--coral);
		font-weight: 500;
	}

.pillars-section {
  width: 100%;
  background-color: #FEF4EF; 
  padding: 8rem 2rem;
  box-sizing: border-box;
}

.pillars-container {
  max-width: 1200px;
  margin: 0 auto;
}

	.section-lead {
		text-align: center;
		margin-bottom: 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.section-lead h2 {
		font-size: 2.75rem;
	}

	.section-lead p {
		font-weight: 300;
		font-size: 0.95rem;
		max-width: 480px;
		line-height: 1.6;
	}

	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
	}

	.pillar-card {
		border: 1px solid rgba(89, 54, 58, 0.1);
		padding: 3rem 2rem;
		background-color: var(--white);
		transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease, border-color 0.3s ease;
	}

	.pillar-card:hover {
		border-color: var(--coral);
	}

	.card-index {
		font-family: 'GF Didot', serif;
		color: var(--coral);
		font-size: 2.25rem;
		display: block;
		margin-bottom: 1.5rem;
	}

	.pillar-card h3 {
		margin-bottom: 1rem;
		font-size: 1.6rem;
	}

	.pillar-card p {
		font-size: 0.9rem;
		line-height: 1.7;
		margin-bottom: 2rem;
		font-weight: 300;
	}

	.card-action {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-weight: 600;
		color: var(--burgundy);
		transition: color 0.3s ease;
	}

	.pillar-card:hover .card-action {
		color: var(--coral);
	}

	@media (max-width: 960px) {
	.hero-section {
    background: linear-gradient(
      to bottom, 
      #59363A 0%, 
      #59363A 8%, 
      #8A6266 22%,
      #BA9699 35%,
      #DFCDC9 45%,
      #FEF4EF 55%, 
      #FEF4EF 100%
    );
  }
		

		.hero-container {
			grid-template-columns: 1fr;
			padding: 4rem 2rem;
			gap: 4rem;
		}
		
		.pillars-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		h1 {
			font-size: 3rem;
		}
		
		.statement-container h2 {
			font-size: 1.75rem;
		}
	}
</style>
