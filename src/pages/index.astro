---
import BaseLayout from '../layouts/BaseLayout.astro';

import Ticker from '../components/Ticker.astro';
import heroImage from '../../public/images/_51A5829.webp';

const pageTitle = "Misa Chien | Executive Mindset Coach & Authentic Leader";
const pageDescription = "Release your scarcity mindset with professional coach Misa Chien. Break through subconscious ceilings, heal emotional loops, and shift from survival to abundance.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const shareImageURL = new URL(heroImage.src, Astro.site ?? Astro.url).href;

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site ?? "https://misachien.com"}/#website`,
      "url": Astro.site ?? "https://misachien.com",
      "name": "Misa Chien",
      "description": pageDescription,
      "publisher": {
        "@id": `${Astro.site ?? "https://misachien.com"}/#person`
      }
    },
    {
      "@type": "Person",
      "@id": `${Astro.site ?? "https://misachien.com"}/#person`,
      "name": "Misa Chien",
      "url": Astro.site ?? "https://misachien.com",
      "image": shareImageURL,
      "jobTitle": "Founder & Executive Coach",
      "knowsAbout": [
        "Entrepreneurship",
        "AAPI Leadership",
        "Executive Coaching",
        "Mindset Coaching",
        "Subconscious Reprogramming"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/misachien",
        "https://www.instagram.com/misa_chien/"
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={heroImage.src}>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  
  <main>
    <section class="hero-section" id="section-one">
      <div class="hero-container">
        <div class="hero-content">
          <span class="kicker">Misa Chien &mdash; Authentic Leadership</span>
          <h1>
            Together, let’s recondition your <span class="font-cursive">unconscious</span> framework.
          </h1>
          <p class="hero-body">
            Release your scarcity mindset with elite executive mindset coach, Misa Chien. Shift away from structural survival loops and step into authentic abundance.
          </p>
          <div class="action-wrapper">
            <a href={`${import.meta.env.BASE_URL}/coaching`} class="btn-solid">
              Start Your Journey
            </a>
          </div>
        </div>
        
        <div class="hero-image-container">
          <img src={heroImage.src} alt="Misa Chien" class="hero-main-photo" />
        </div>
      </div>
    </section>

    <Ticker />

    <section class="pillars-section" id="section-three">
      <div class="pillars-container"> 
        <div class="section-lead">
          <span class="kicker">The Reprogramming Process</span>
          <h2>Shift From Scarcity to Abundance</h2>
          <p>Your business strategy isn’t the issue&mdash;your subconscious ceiling is. Follow these three targeted phases to identify your underlying patterns and claim true internal freedom.</p>
        </div>

        <div class="pillars-grid">
          <div class="pillar-card">
            <span class="card-index">01</span>
            <h3>Take the Scarcity Mindset Quiz</h3>
            <p>Uncover the invisible framework directing your executive decisions. Spend five minutes uncovering the exact subconscious blocks keeping you chained to a constant survival model.</p>
            <a href={`${import.meta.env.BASE_URL}/scarcity-mindset-quiz`} class="card-link">Take the Quiz &rarr;</a>
          </div>

          <div class="pillar-card">
            <span class="card-index">02</span>
            <h3>Choose Your Track</h3>
            <p>Whether you are a founder scaling your footprint or a C-suite executive looking for profound alignment, find the container custom-built for your scope.</p>
            <a href={`${import.meta.env.BASE_URL}/coaching`} class="card-link">Explore the Tracks &rarr;</a>
          </div>

          <div class="pillar-card">
            <span class="card-index">03</span>
            <h3>Attend the Masterclass</h3>
            <p>Access my private workshop outlining the core mechanics of your deep unconscious mind. Discover how to confidently intercept reactive legacy wounds before they override leadership strategy.</p>
            <a href={`${import.meta.env.BASE_URL}/free-workshop`} class="card-link">Reclaim Your Clarity &rarr;</a>
          </div>
        </div>
      </div>
    </section>

<section class="clarity-call-banner-system" id="interactive-banner">
      <canvas id="canvas" class="water-canvas"></canvas>
      
      <div class="clarity-content reveal-on-scroll">
        <span class="kicker light-text">Exclusive Invitation</span>
        <h2 class="serif-italic-banner light-text">Ready to recondition your unconscious framework?</h2>
        <p class="light-text">If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="light-highlight">Clarity Call</strong> to map out your blind spots.</p>
        <a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="cta-link-text">
          <span>Book Your Clarity Call &rarr;</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>

  :root {
    --bg-solid-light: #FBF9F6;  
    --bg-card-solid: #FFFFFF;
    --text-primary: #1A1A1A;   
    --text-muted: #55514E;      
    --accent-gold: #8C7E6D;     
    
    --font-serif: 'Libre Baskerville', serif;
    --font-sans: 'Helvetica Neue', 'Inter', sans-serif;
    --font-serif: 'Libre Baskerville', serif;
  }

  /* ==========================================================
     HERO SECTION
     ========================================================== */
  .hero-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-solid-light);
    border-bottom: 1px solid #EAE5E0;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 10rem 2rem 8rem 2rem;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 6rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .kicker {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 500;
    color: var(--accent-gold);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    line-height: 1.25;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0;
  }

  .font-cursive {
    font-family: var(--font-cursive);
    font-size: 4rem;
    color: var(--accent-gold);
    text-transform: none;
    font-weight: 400;
    display: inline-block;
    line-height: 0;
  }

  .hero-body {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 1.8;
    font-weight: 500; 
    color: var(--text-muted);
    max-width: 520px;
    margin: 0;
  }


  .btn-solid {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    background-color: var(--text-primary);
    color: #FFFFFF;
    padding: 1.2rem 2.8rem;
    border: none;
    border-radius: 0 !important; 
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .btn-solid:hover {
    background-color: var(--accent-gold);
  }

  .hero-image-container {
    position: relative;
    width: 100%;
  }


  .hero-main-photo {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 0 !important;
    display: block;
  }

  /* ==========================================================
     PILLARS SECTION
     ========================================================== */
  .pillars-section {
    width: 100%;
    background-color: #FFFFFF;
    padding: 9rem 2rem;
  }

  .pillars-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-lead {
    text-align: center;
    margin-bottom: 6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-lead h2 {
    font-family: var(--font-serif);
    font-size: 2.8rem;
    color: var(--text-primary);
    font-weight: 400;
    margin: 0;
  }

  .section-lead p {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.05rem;
    max-width: 560px;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }


  .pillar-card {
    border: 1px solid #EAE5E0;
    padding: 4rem 2.5rem;
    background-color: var(--bg-solid-light);
    border-radius: 0 !important;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .card-index {
    font-family: var(--font-serif);
    color: var(--accent-gold);
    font-size: 2rem;
    display: block;
    margin-bottom: 2rem;
  }

  .pillar-card h3 {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 1.2rem 0;
  }

  .pillar-card p {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text-muted);
    margin: 0 0 2.5rem 0;
    flex-grow: 1;
  }

  .card-link {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--text-primary);
    padding-bottom: 4px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .card-link:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .clarity-call-banner-system {
    position: relative;
    width: 100%;
    background-color: var(--text-primary);
    padding: 10rem 2rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .water-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.15; 
    z-index: 1;
  }

  .clarity-content {
    position: relative;
    z-index: 2;
    max-width: 700px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .light-text {
    color: #FFFFFF !important;
  }

  .serif-italic-banner {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 3rem;
    font-weight: 400;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .clarity-content p {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.8;
    font-weight: 500;
    color: #C5C1BD;
    max-width: 600px;
    margin: 0;
  }

  .light-highlight {
    color: #FFFFFF;
    font-weight: 700;
    border-bottom: 1px dashed var(--accent-gold);
  }

  
  .cta-link-text {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-decoration: none;
    color: var(--text-primary);
    background-color: #FFFFFF;
    padding: 1.25rem 2.5rem;
    border: 1px solid #FFFFFF;
    transition: all 0.3s ease;
    margin-top: 1rem;
  }

  .cta-link-text:hover {
    background-color: transparent;
    color: #FFFFFF;
    border-color: #FFFFFF;
  }



  /* ==========================================================
     RESPONSIVE BREAKPOINTS (Static stacking)
     ========================================================== */
  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      padding: 8rem 2rem 5rem 2rem;
      gap: 4rem;
    }
   .clarity-call-banner-system {
      padding: 7rem 1.5rem;
    }
    .serif-italic-banner {
      font-size: 2.25rem;
    }
    .cta-link-text {
      display: block;
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
    .pillars-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    h1 {
      font-size: 2.8rem;
    }

    .section-lead h2 {
      font-size: 2.2rem;
    }
  }
</style>
