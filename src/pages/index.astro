---
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeWriter from '../components/TypeWriter.astro';
import StickyNotes from '../components/StickyNotes.astro';
import TypeWriter3 from '../components/TypeWriter3.astro';
import ClarityCallBanner from '../components/ClarityCallBanner.astro';
import Ticker from '../components/Ticker.astro';
import heroImage from '../../public/images/_51A5829.webp';

const pageTitle = "Misa Chien | Executive Mindset Coach & Authentic Leader";
const pageDescription = "Release your scarcity mindset with professional coach Misa Chien. Break through subconscious ceilings, heal emotional loops, and shift from survival to abundance.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const shareImageURL = new URL(heroImage.src, Astro.site ?? Astro.url).href;

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site ?? "https://misachien.com"}/#website`,
      "url": Astro.site ?? "https://misachien.com",
      "name": "Misa Chien",
      "description": pageDescription,
      "publisher": {
        "@id": `${Astro.site ?? "https://misachien.com"}/#person`
      }
    },
    {
      "@type": "Person",
      "@id": `${Astro.site ?? "https://misachien.com"}/#person`,
      "name": "Misa Chien",
      "url": Astro.site ?? "https://misachien.com",
      "image": shareImageURL,
      "jobTitle": "Founder & Executive Coach",
      "knowsAbout": [
        "Entrepreneurship",
        "AAPI Leadership",
        "Executive Coaching",
        "Mindset Coaching",
        "Subconscious Reprogramming"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/misachien",
        "https://www.instagram.com/misa_chien/"
      ]
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={heroImage.src}>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
	<main >
		<section class="hero-section " id="section-one" data-theme="start" >
			<div class="hero-container">
				<div class="hero-content reveal-on-scroll">
					<span class="kicker">Misa Chien | Authentic Leader</span>
					<TypeWriter 
						staticText="Together let's " 
						words={["stay authentic", "crush limiting beliefs", "heal", "grow"]} 
					/>
					<p class="hero-body">
						Release your scaricty mindset with mindset coach, Misa Chien. 
					</p>
					<div class="action-wrapper">
						<a  href={`${import.meta.env.BASE_URL}/coaching`} class="btn-filled"><span>Start Your Journey</span></a>
					</div>
				</div>
				
				<div class="hero-image-container reveal-on-scroll">
					<div class="accent-border-box" ></div>
					<img src={heroImage.src} alt="Misa Chien" class="visual-canvas-image"  />
				</div>
			</div>
		</section>

<Ticker  />
		


		<section class="pillars-section" id="section-three" data-theme="light">
			<div class="pillars-container"> <div class="section-lead reveal-on-scroll">
				<span class="kicker">THE REPROGRAMMING PROCESS</span>
				<h2>Shift From Scarcity to Abundance</h2>
				<p>Your strategy isn’t the problem—the subconscious ceiling is. Follow these three steps to identify your patterns, choose your track, and recondition your mind for true freedom.</p>
			</div>

		<div class="pillars-grid">
                <div class="pillar-card reveal-on-scroll">
					<span class="card-index">01</span>
					<h3>Take the Scarcity Mindset Quiz</h3>
					<p>Uncover the invisible scripts running your business and life. Take only 10 questions to identify the exact subconscious blocks keeping you stuck in a survival loop, even after achieving success.</p>
					<a href={`${import.meta.env.BASE_URL}/scarcity-mindset-quiz`} class="card-action">TAKE THE QUIZ &rarr;</a>
				</div>

				<div class="pillar-card reveal-on-scroll">
					<span class="card-index">02</span>
					<h3>Choose Your Path to Clarity</h3>
					<p>Whether you are a 6-figure founder scaling to the next level or a C-suite leader seeking internal freedom, select the tailored framework designed to rewire your specific unconscious boundaries.</p>
					<a href={`${import.meta.env.BASE_URL}/coaching`} class="card-action">EXPLORE THE TRACKS &rarr;</a>
				</div>

				<div class="pillar-card reveal-on-scroll">
					<span class="card-index">03</span>
					<h3>Attend the Free Workshop</h3>
					<p>Watch my complimentary masterclass on decoding the scarcity mindset. Learn the precise mechanics of speaking to the unconscious mind and how to stop letting old wounds drive your executive decisions.</p>
					<a href={`${import.meta.env.BASE_URL}/free-workshop`} class="card-action">RECLAIM YOUR CLARITY &rarr;</a>
				</div>
			</div>
            </section>
<ClarityCallBanner client:visible />

		<StickyNotes client:visible />
        <TypeWriter3 client:visible />
	</main>
</BaseLayout>

<style>
.hero-section {
  position: relative;
  width: 100%;
  background: linear-gradient(
    to right, 
    #59363A 0%, 
    #59363A 6%, 
    #8A6266 25%,
    #BA9699 38%,
    #DFCDC9 48%,
    #FEF4EF 58%, 
    #FEF4EF 100%
  );
  overflow: hidden;
}

.hero-section::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  opacity: 0.035; 
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='studio'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23studio)'/%3E%3C/svg%3E");
}

	.hero-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: calc(6rem + 60px) 2rem 7rem 2rem;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 5rem;
		align-items: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
	}

	h1 {
		font-size: 5rem;
		line-height: 1.15;
		font-weight: 400;
	}

	.serif-italic {
		font-family: 'GF Didot', serif;
		font-style: italic;
		color: var(--burgundy);
	}

	.hero-body {
		font-size: 2rem;
		line-height: 1.75;
		font-weight: 300;
		max-width: 540px;
	}

	.btn-filled {
		position: relative;
		border: 1px solid var(--coral); 
		color: var(--coral); 
		padding: 1.1rem 2.5rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		display: inline-block;
		overflow: hidden;
		background: transparent;
		z-index: 1;
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-filled span {
		position: relative;
		z-index: 2;
	}

	.btn-filled::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: var(--coral); 
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 1;
	}

	.btn-filled:hover {
		color: var(--white); 
		border-color: var(--coral);
	}

	.btn-filled:hover::before {
		transform: scaleX(1);
	}

	.hero-image-container {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
	}

	.accent-border-box {
		position: absolute;
		inset: 0;
		border: 1px solid var(--coral);
		transform: translate(20px, 20px);
		z-index: 1;
		opacity: 0.5;
	}

	.visual-canvas-image {
		position: relative;
		width: 100%;
		height: 100%;
		object-fit: cover; 
		border: 1px solid rgba(89, 54, 58, 0.1);
		z-index: 2;
	}

.pillars-section {
  width: 100%;
  background-color: #FEF4EF; 
  padding: 8rem 2rem;
  box-sizing: border-box;
}

.pillars-container {
  max-width: 1200px;
  margin: 0 auto;
}

	.section-lead {
		text-align: center;
		margin-bottom: 5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
        color: var(--coral);
	}

	.section-lead h2 {
		font-size: 2.75rem;
         color: var(--burgundy);
	}

	.section-lead p {
		font-weight: 300;
		font-size: 0.95rem;
		max-width: 480px;
		line-height: 1.6;
         color: var(--coral);
	}

	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
	}

	.pillar-card {
		border: 1px solid rgba(89, 54, 58, 0.1);
		padding: 3rem 2rem;
		background-color: var(--white);
		transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease, border-color 0.3s ease;
	}

	.pillar-card:hover {
		border-color: var(--coral);
	}

	.card-index {
		font-family: 'GF Didot', serif;
		color: var(--coral);
		font-size: 2.25rem;
		display: block;
		margin-bottom: 1.5rem;
	}

	.pillar-card h3 {
		margin-bottom: 1rem;
		font-size: 1.6rem;
       color: var(--burgundy);
	}

	.pillar-card p {
		font-size: 0.9rem;
		line-height: 1.7;
		margin-bottom: 2rem;
		font-weight: 300;
         color: var(--coral);
	}

	.card-action {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-weight: 600;
		color: var(--burgundy);
		transition: color 0.3s ease;
	}

	.pillar-card:hover .card-action {
		color: var(--coral);
	}


	/* Fixed: Lowered the break target down from 960px to 820px to hold layout alignment longer */
	@media (max-width: 820px) {
		.hero-section {
			background: linear-gradient(
				to bottom, 
				#59363A 0%, 
				#59363A 8%, 
				#8A6266 22%,
				#BA9699 35%,
				#DFCDC9 45%,
				#FEF4EF 55%, 
				#FEF4EF 100%
			);
		}

		.hero-container {
			grid-template-columns: 1fr;
			
			padding: calc(4rem + 60px) 2rem 4rem 2rem;
			gap: 4rem;
		}
		
		.pillars-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		h1 {
			font-size: 3rem;
		}
		
		.statement-container h2 {
			font-size: 1.75rem;
		}

	}
</style>
