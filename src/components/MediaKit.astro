    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    z-index: 50;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .swiper { width: 100%; height: 100vh; }

  .swiper-slide {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 5vh 6vw;
    position: relative;
    overflow: hidden;
  }

  .swiper-slide[data-theme="light"] { 
    background-color: var(--cream-background); 
    color: var(--dark-grey-text); 
  }

  .swiper-slide[data-theme="dark"] { 
    background-color: var(--burgundy); 
    color: var(--soft-white); 
  }

  .screen-constrained {
    height: 80vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1350px;
    margin: 0 auto;
  }

  .slide-content, .slide-visual-panel {
    min-width: 0;
  }

  .full-width-visual { width: 100%; max-height: 55vh; }

  .image-constrained-wrapper {
    height: 100%;
    max-height: 80vh; 
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%; 
  }

  .image-mask {
    height: 100%;
    width: 100%;
    max-width: 500px;
    overflow: hidden;
    position: relative;
  }

  .slide-image { width: 100%; height: 100%; object-fit: cover; }

  .luxury-watermark {
    position: absolute;
    font-family: var(--font-display);
    font-size: 32vh;
    color: var(--coral);
    opacity: 0.04;
    line-height: 1;
    z-index: 0;
    pointer-events: none;
    bottom: 5vh;
    right: 5vw;
  }
  .luxury-watermark.light-watermark { color: var(--soft-white); opacity: 0.03; }

  .meta-category-pill {
    display: inline-block;
    color: var(--burgundy);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--coral);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 3px;
    margin-bottom: 3vh;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: calc(3rem + 2.5vw);
    font-weight: 400;
    color: var(--burgundy);
    line-height: 0.9;
