              </div>
              <div class="option-card-item luxury-border-bottom">
                <h4>PANELS & MODERATION</h4>
                <p>Virtual or in-person appearances</p>
              </div>
              <div class="option-card-item luxury-border-bottom">
                <h4>PODCAST / MEDIA APPEARANCES</h4>
