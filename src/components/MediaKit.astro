

  <style>
    :root {
      --cream: #FDFBF7;
      --peach: #F4EAE1;
      --font-header: 'Tenor Sans', sans-serif;
      --font-body: 'Poppins', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--cream);
      color: var(--burgundy);
      overflow-x: hidden;
    }

    .media-kit-container {
      width: 100%;
      height: 100vh;
      position: relative;
    }

    .swiper {
      width: 100%;
      height: 100%;
    }

    .swiper-slide {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 100%;
      overflow-y: auto;
      padding: 4rem 2rem;
    }

    /* Background Utility Classes */
    .bg-white { background-color: var(--white); }
    .bg-cream { background-color: var(--cream); }
    .bg-peach { background-color: var(--peach); }
    .coral-bg { background-color: var(--coral); }
    
    /* Text Color Utilities */
    .burgundy-text { color: var(--burgundy); }
    .coral-text { color: var(--coral); }
    .white-text { color: var(--white); }

    /* Content Layout Structure */
    .content-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
      max-width: 1200px;
      width: 100%;
      margin: auto;
      align-items: center;
    }

    .content-grid.split {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      max-width: 100%;
      height: 100%;
      padding: 0;
    }

    .col-left, .col-right {
      padding: 4rem;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .content-grid.standard-layout {
      grid-template-columns: 1.1fr 0.9fr;
    }

    /* Typography Details */
    h1, h2, h3, h4, .slide-header {
      font-family: var(--font-header);
      font-weight: 400;
      text-transform: uppercase;
    }

    p {
      font-family: var(--font-body);
    }

    .intro-meta-pill {
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 2px;
      margin-bottom: 1.5rem;
      opacity: 0.8;
    }

    .dot-separator {
      margin: 0 0.5rem;
      color: var(--coral);
    }

    .marker-highlight {
      font-family: var(--font-header);
      text-transform: uppercase;
      color: var(--coral);
      margin-bottom: 1.5rem;
    }

    /* Styled Lists */
    .styled-list {
      list-style: none;
    }

    .styled-list.bulleted li {
      position: relative;
      padding-left: 1.5rem;
      margin-bottom: 0.75rem;
      line-height: 1.6;
    }

    .styled-list.bulleted li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--coral);
      font-size: 1.2rem;
    }

    .col-right .styled-list.bulleted li::before {
      color: var(--white);
    }

    .styled-list:not(.bulleted) li {
      margin-bottom: 0.6rem;
      line-height: 1.5;
    }

    /* Action Elements */
    .quiz-action-btn {
      background-color: var(--coral);
      color: var(--white);
      border: none;
      padding: 1rem 2.5rem;
      font-family: var(--font-body);
      font-weight: 600;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-transform: uppercase;
    }

    .quiz-action-btn:hover {
      background-color: var(--burgundy);
      transform: translateY(-2px);
    }

    /* Media Layout Images */
    .image-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      max-height: 650px;
      display: flex;
      justify-content: center;
    }

    .slide-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 2px;
    }

    /* Montage Visual Grid */
    .image-montage-container div {
      overflow: hidden;
    }

    /* Video Player Mockup */
    .video-slide {
      background-color: #1A1A1A;
    }

    .video-container {
      width: 100%;
      max-width: 1000px;
      margin: auto;
    }

    .video-placeholder {
      position: relative;
      cursor: pointer;
    }

    .play-button {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 80px;
      height: 80px;
      background-color: rgba(224, 122, 95, 0.9);
      border-radius: 50%;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s ease;
    }

    .play-button::after {
      content: "";
      display: block;
      width: 0;
      height: 0;
      border-style: solid;
      border-width: 12px 0 12px 20px;
      border-color: transparent transparent transparent var(--white);
      margin-left: 6px;
    }

    .video-placeholder:hover .play-button {
      transform: translate(-50%, -50%) scale(1.1);
    }

    .video-title {
      position: absolute;
      bottom: 2rem;
      left: 2rem;
      color: var(--white);
      font-family: var(--font-header);
      font-size: 1.5rem;
      letter-spacing: 2px;
      z-index: 4;
    }

    /* Package Bundle Block */
    .bundle-box {
      border-radius: 4px;
      box-shadow: 0 10px 30px rgba(74, 14, 14, 0.05);
    }

    .mobile-static-note {
      padding: 1rem;
      background-color: rgba(244, 234, 225, 0.7);
      border-radius: 4px;
    }

    /* Navigation Custom Styling */
    .swiper-pagination-bullet-active {
      background: var(--coral) !important;
    }

    /* Responsive Breakdown Design */
    @media (max-width: 992px) {
      .swiper-slide {
        padding: 3rem 1rem;
      }
      .content-grid, .content-grid.standard-layout {
        grid-template-columns: 1fr;
        gap: 3rem;
      }
      .content-grid.split {
        grid-template-columns: 1fr;
      }
      .col-left, .col-right {
        padding: 3rem 1.5rem;
      }
      .image-wrapper {
        max-height: 450px;
      }
      .mobile-static-note {
        position: static !important;
        margin-bottom: 2rem;
        max-width: 100% !important;
      }
      h1.slide-header {
        font-size: 3.5rem !important;
      }
    }
  </style>
</head>
