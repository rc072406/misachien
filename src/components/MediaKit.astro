<script>
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  import 'swiper/css/scrollbar';
  import Swiper from 'swiper';
  import { Navigation, Pagination, Scrollbar, Keyboard, Mousewheel, Parallax } from 'swiper/modules';

  const initSwiper = () => {
    const swiperEl = document.querySelector('.mediaKitSwiper');
    if (swiperEl && !swiperEl.swiper) {
      new Swiper('.mediaKitSwiper', {
        modules: [Navigation, Pagination, Scrollbar, Keyboard, Mousewheel, Parallax],
        direction: 'horizontal',
        speed: 1100,
        parallax: true,
        mousewheel: { forceToAxis: true, sensitivity: 0.8 },
        keyboard: { enabled: true, onlyInViewport: true },
        scrollbar: { el: '.swiper-scrollbar', draggable: true },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          type: 'fraction',
          renderFraction: function (currentClass, totalClass) {
            return `<span class="${currentClass}"></span><span class="separator">/</span><span class="${totalClass}"></span>`;
          }
        },
        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
        on: {
          init: function (swiper) {
            const initialSlide = swiper.slides[swiper.activeIndex];
            swiper.el.setAttribute('data-current-theme', initialSlide.getAttribute('data-theme') || 'light');
          },
          slideChange: function (swiper) {
            const activeSlide = swiper.slides[swiper.activeIndex];
            swiper.el.setAttribute('data-current-theme', activeSlide.getAttribute('data-theme') || 'light');
          }
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initSwiper);
  setTimeout(initSwiper, 150);
</script>

<style>
  .media-kit-swiper-wrapper {
