<script>
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  import 'swiper/css/scrollbar';
  
  import Swiper from 'swiper';
  import { Navigation, Pagination, Scrollbar, Keyboard, Mousewheel, Parallax } from 'swiper/modules';

  const initSwiper = () => {
    const swiperEl = document.querySelector('.mediaKitSwiper');
    if (swiperEl && !swiperEl.swiper) {
      new Swiper('.mediaKitSwiper', {
        modules: [Navigation, Pagination, Scrollbar, Keyboard, Mousewheel, Parallax],
        direction: 'horizontal',
        loop: false,
        speed: 1200,
        parallax: true,
        mousewheel: {
          forceToAxis: true,
          sensitivity: 0.8,
        },
        keyboard: {
          enabled: true,
          onlyInViewport: true,
        },
        scrollbar: {
          el: '.swiper-scrollbar',
          draggable: true,
          hide: false,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          type: 'fraction',
          renderFraction: function (currentClass, totalClass) {
            return `<span class="${currentClass}"></span><span class="separator">/</span><span class="${totalClass}"></span>`;
          }
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        on: {
          init: function (swiper) {
            const initialSlide = swiper.slides[swiper.activeIndex];
            const theme = initialSlide.getAttribute('data-theme') || 'light';
            swiper.el.setAttribute('data-current-theme', theme);
          },
          slideChange: function (swiper) {
            const activeSlide = swiper.slides[swiper.activeIndex];
            const theme = activeSlide.getAttribute('data-theme') || 'light';
            swiper.el.setAttribute('data-current-theme', theme);
          }
        }
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwiper);
  } else {
    initSwiper();
  }

  setTimeout(initSwiper, 100);
</script>

<style>
  .media-kit-swiper-wrapper {
    --burgundy: #59363a;
    --coral: #e77860;
    --cream-background: #fef4ef;
    --soft-white: #ffffff;
    --light-grey-border: rgba(89, 54, 58, 0.1);
    --dark-grey-text: #2d2d2d;
    --font-display: 'Tenor Sans', sans-serif;
    --font-sans: 'Poppins', sans-serif;
    
    width: 100%;
    position: relative;
    background-color: var(--soft-white);
  }

  .luxury-noise-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    z-index: 50;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .swiper {
    width: 100%;
    height: 100vh;
    min-height: 720px;
  }

  .swiper-slide {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 5rem 7rem;
    position: relative;
    overflow: hidden;
  }

  .swiper-slide[data-theme="cream"] { background-color: var(--cream-background); }
  .swiper-slide[data-theme="light"] { background-color: var(--soft-white); }
  .swiper-slide[data-theme="dark"] { background-color: var(--burgundy); }

  .luxury-watermark {
    position: absolute;
    font-family: var(--font-display);
    font-size: 35vw;
    color: var(--coral);
    opacity: 0.03;
    line-height: 1;
    z-index: 0;
    pointer-events: none;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .luxury-watermark.light-watermark { color: var(--soft-white); opacity: 0.02; }

  .meta-category-pill {
    display: inline-flex;
    color: var(--burgundy);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--coral);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 2.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 400;
    color: var(--burgundy);
    line-height: 0.9;
    letter-spacing: -1px;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    font-style: italic;
    color: var(--coral);
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    color: var(--burgundy);
    line-height: 1.1;
    letter-spacing: 2px;
    margin-bottom: 2.5rem;
    text-transform: uppercase;
  }

  .section-heading.inverse-text { color: var(--soft-white); }
  .text-center { text-align: center; }

  .subsection-subheading {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    color: var(--coral);
    letter-spacing: 3px;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .swiper-slide[data-theme="dark"] .subsection-subheading {
    color: var(--cream-background);
  }

  .header-note {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 2px;
    color: var(--burgundy);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    border-left: 1px solid var(--coral);
    padding-left: 1rem;
