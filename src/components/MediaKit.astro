<script>
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  import 'swiper/css/scrollbar';
  
  import Swiper from 'swiper';
  
  import { Navigation, Pagination, Scrollbar, Keyboard, Mousewheel, Parallax } from 'swiper/modules';

  const initSwiper = () => {
    const swiperEl = document.querySelector('.mediaKitSwiper');
    if (swiperEl && !swiperEl.swiper) {
      new Swiper('.mediaKitSwiper', {
        modules: [Navigation, Pagination, Scrollbar, Keyboard, Mousewheel, Parallax],
        direction: 'horizontal',
        loop: false,
        speed: 1000,
        parallax: true,
        mousewheel: {
          forceToAxis: true,
          sensitivity: 0.8,
        },
        keyboard: {
          enabled: true,
          onlyInViewport: true,
        },
        scrollbar: {
          el: '.swiper-scrollbar',
          draggable: true,
          hide: false,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
          type: 'fraction',
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        on: {
          init: function (swiper) {
            const initialSlide = swiper.slides[swiper.activeIndex];
            const theme = initialSlide.getAttribute('data-theme') || 'light';
            swiper.el.setAttribute('data-current-theme', theme);
          },
          slideChange: function (swiper) {
            const activeSlide = swiper.slides[swiper.activeIndex];
            const theme = activeSlide.getAttribute('data-theme') || 'light';
            swiper.el.setAttribute('data-current-theme', theme);
          }
        }
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwiper);
  } else {
    initSwiper();
  }

  setTimeout(initSwiper, 100);
</script>

<style>
  .media-kit-swiper-wrapper {
    --burgundy: #59363a;
    --coral: #e77860;
    --cream-background: #fef4ef;
    --soft-white: #ffffff;
    --light-grey-border: rgba(89, 54, 58, 0.1);
    --dark-grey-text: #2d2d2d;
    --font-display: 'Tenor Sans', sans-serif;
    --font-sans: 'Poppins', sans-serif;
    
    width: 100%;
    position: relative;
    background-color: var(--soft-white);
  }

  .swiper {
    width: 100%;
    height: 100vh;
    min-height: 720px;
  }

  .swiper-slide {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 5rem 7rem;
    position: relative;
    overflow: hidden;
  }

  .swiper-slide::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(231, 120, 96, 0.08) 0%, transparent 70%);
    top: 5%;
    right: -10%;
    z-index: 1;
    pointer-events: none;
    filter: blur(80px);
    animation: ambientFloat 15s ease-in-out infinite alternate;
  }

  .swiper-slide[data-theme="dark"]::before {
    background: radial-gradient(circle, rgba(254, 244, 239, 0.05) 0%, transparent 70%);
    top: -10%;
    left: -5%;
  }

  @keyframes ambientFloat {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-50px, 40px) scale(1.1); }
  }

  .swiper-slide[data-theme="cream"] { background-color: var(--cream-background); }
  .swiper-slide[data-theme="light"] { background-color: var(--soft-white); }
  .swiper-slide[data-theme="dark"] { background-color: var(--burgundy); }

  .meta-category-pill {
    display: inline-flex;
    background-color: transparent;
    color: var(--burgundy);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--coral);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 3px;
    margin-bottom: 2.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 5.5rem;
    font-weight: 400;
    color: var(--coral);
    line-height: 0.95;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 400;
    color: var(--burgundy);
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 400;
    color: var(--burgundy);
    line-height: 1.1;
    letter-spacing: 1.5px;
    margin-bottom: 2.5rem;
    text-transform: uppercase;
  }

  .section-heading.inverse-text { color: var(--soft-white); }
  .text-center { text-align: center; }

  .marker {
    background: linear-gradient(to right, rgba(231, 120, 96, 0.15) 100%, rgba(231, 120, 96, 0.15) 100%);
    background-position: 0 90%;
    background-size: 0% 35%;
    background-repeat: no-repeat;
    padding: 0 4px;
    display: inline;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 1.2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .swiper-slide[data-theme="dark"] .marker {
    background: linear-gradient(to right, rgba(231, 120, 96, 0.3) 100%, rgba(231, 120, 96, 0.3) 100%);
    background-position: 0 90%;
    background-size: 0% 35%;
    background-repeat: no-repeat;
  }

  .swiper-slide-active .marker {
    background-size: 100% 35% !important;
    transition-delay: 0.8s;
  }

  .marker.dark-marker {
    color: var(--soft-white);
  }

  .subsection-subheading {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--coral);
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .swiper-slide[data-theme="dark"] .subsection-subheading {
    color: var(--cream-background);
  }

  .header-note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--burgundy);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .slide-description, .intro-context-text {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--dark-grey-text);
    margin-bottom: 3rem;
