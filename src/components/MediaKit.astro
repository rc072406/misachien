---
---

<section class="media-kit-container">
  <div class="swiper mySwiper">
    <div class="swiper-wrapper">
      
      <div class="swiper-slide intro-slide" data-swiper-parallax="-200">
        <div class="content-grid">
          <div class="text-content">
            <div class="intro-meta-pill" data-swiper-parallax="-300">
              FOUNDER <span class="dot-separator">•</span> COMMUNITY BUILDER <span class="dot-separator">•</span> SPEAKER
            </div>
            <h1 class="intro-title" data-swiper-parallax="-500">MISA CHIEN</h1>
            <p class="intro-subtitle" data-swiper-parallax="-700">Authentic Storytelling</p>
            <p class="intro-description" data-swiper-parallax="-900">
              Misa brings founder-to-founder credibility, trusted community access, 
              and authentic storytelling across leadership, identity, and ambition.
            </p>
            <button class="quiz-action-btn">WORK WITH ME</button>
          </div>
          <div class="image-wrapper main-photo" data-swiper-parallax="-100">
            <img src="https://placehold.co/600x700/f0eae5/4a0e0e?text=Misa+Hero" alt="Misa Chien Hero" class="slide-img" />
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-cream">
        <div class="content-grid standard-layout">
          <div class="text-content burgundy-text">
            <h2 class="section-heading" data-swiper-parallax="-400">THE STORY BEHIND THE STORYTELLER</h2>
            <p class="intro-description" data-swiper-parallax="-600">
              As a seasoned entrepreneur who has scaled multiple businesses, Misa understands the highs and lows of the founder journey. Her content bridges the gap between raw corporate reality and inspiring personal growth, making her a trusted voice for modern professionals.
            </p>
          </div>
          <div class="image-wrapper profile-photo" data-swiper-parallax="-200">
            <img src="https://placehold.co/600x700/f0eae5/4a0e0e?text=About+Misa" alt="About Misa" class="slide-img" />
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-white">
        <div class="content-grid split">
          <div class="col-left burgundy-text">
            <h2 class="section-heading">WHY PARTNERS WORK WITH MISA</h2>
            <div class="stagger-list" data-swiper-parallax="-400">
              <div class="list-item"><h3>Founder-to-founder credibility</h3></div>
              <div class="list-item"><h3>Trusted audience and community resonance</h3></div>
              <div class="list-item"><h3>Authentic storytelling</h3></div>
            </div>
          </div>
          <div class="col-right coral-bg">
            <h2 class="section-heading white-text">PREVIOUS PARTNERS</h2>
            <ul class="partner-list">
              <li>1587 Sneakers</li>
              <li>Fabletics</li>
              <li>GNC</li>
              <li>The Little Bra Company</li>
              <li>Revitalash</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-cream">
        <div class="metrics-layout">
          <h2 class="section-heading burgundy-text" data-swiper-parallax="-300">AUDIENCE DEMOGRAPHICS</h2>
          <div class="metrics-grid">
            <div class="metric-card" data-swiper-parallax="-400">
              <span class="metric-number">72%</span>
              <span class="metric-label">Female Identified</span>
            </div>
            <div class="metric-card" data-swiper-parallax="-500">
              <span class="metric-number">25-44</span>
              <span class="metric-label">Primary Age Range</span>
            </div>
            <div class="metric-card" data-swiper-parallax="-600">
              <span class="metric-number">Top Us</span>
              <span class="metric-label">CA, NY, TX Metro Areas</span>
            </div>
          </div>
        </div>
      </div>

      <div class="swiper-slide coral-bg">
        <div class="stats-layout">
          <h2 class="section-heading white-text" data-swiper-parallax="-200">CHANNELS & ENGAGEMENT</h2>
          <div class="stats-grid">
            <div class="stat-box" data-swiper-parallax="-300">
              <h3>LinkedIn</h3>
              <p class="stat-count">50K+</p>
              <p class="stat-desc">Executive Network</p>
            </div>
            <div class="stat-box" data-swiper-parallax="-400">
              <h3>Instagram</h3>
              <p class="stat-count">120K+</p>
              <p class="stat-desc">Highly Active Community</p>
            </div>
            <div class="stat-box" data-swiper-parallax="-500">
              <h3>TikTok</h3>
              <p class="stat-count">85K+</p>
              <p class="stat-desc">Viral Video Reach</p>
            </div>
          </div>
        </div>
      </div>

      <div class="swiper-slide video-slide">
        <div class="video-container" data-swiper-parallax-scale="0.8">
          <div class="video-placeholder">
            <div class="play-button"></div>
            <p class="video-title">WATCH MISA IN ACTION</p>
            <div class="video-mock-frame">
              <img src="https://placehold.co/1000x560/222222/ffffff?text=Video+Asset+Placeholder" alt="Video Player" class="slide-img" />
            </div>
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-white">
        <div class="content-grid standard-layout">
          <div class="image-wrapper case-study-photo" data-swiper-parallax="-300">
            <img src="https://placehold.co/600x700/f0eae5/4a0e0e?text=Case+Study+Highlight" alt="Case Study Success" class="slide-img" />
          </div>
          <div class="text-content burgundy-text">
            <h2 class="section-heading" data-swiper-parallax="-500">RECENT SUCCESS</h2>
            <p class="intro-subtitle" data-swiper-parallax="-600">Case Study</p>
            <p class="intro-description" data-swiper-parallax="-700">
              Our latest campaign drove exceptional organic reach, blending natural product integration with high-level career advice. The campaign yielded over 500k combined views and an engagement rate triple the industry standard.
            </p>
          </div>
        </div>
      </div>

      <div class="swiper-slide coral-bg">
        <div class="content-grid">
          <div class="text-content white-text">
            <h2 class="intro-title">COLLABORATION OPTIONS</h2>
            <ul class="options-list">
              <li data-swiper-parallax="-200">SPONSORED CONTENT</li>
              <li data-swiper-parallax="-300">SPEAKING / KEYNOTE</li>
              <li data-swiper-parallax="-400">PANELS & MODERATION</li>
              <li data-swiper-parallax="-500">MODELING / PHOTOSHOOTS</li>
            </ul>
          </div>
          <div class="image-wrapper montage-photo" data-swiper-parallax="-800">
             <img src="https://placehold.co/600x700/f0eae5/4a0e0e?text=Montage+Image" alt="Collaboration Setup" class="slide-img" />
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-cream">
        <div class="pricing-layout">
            <h2 class="section-heading burgundy-text">PRICING ANCHORS</h2>
            <div class="pricing-grid">
                <div class="price-box">
                    <h4>Speaking Engagements</h4>
                    <p>From $5,000</p>
                </div>
                <div class="price-box">
                    <h4>Paid Collaboration</h4>
                    <p>From $1,800</p>
                </div>
                <div class="price-box">
                    <h4>Photoshoots (Half-Day)</h4>
                    <p>From $2,500</p>
                </div>
            </div>
            <p class="intro-description footer-note">Bundle pricing available for multi-platform campaigns.</p>
        </div>
      </div>

 <div class="swiper-slide bg-white">
        <div class="content-grid standard-layout">
          <div class="text-content burgundy-text" style="text-align: left;">
            <h2 class="section-heading" data-swiper-parallax="-300" style="color: var(--coral); font-style: italic; font-family: 'GF Didot', serif;">
              TO REQUEST A QUOTE, PLEASE SHARE:
            </h2>
            
            <ul class="quote-requirements-list" data-swiper-parallax="-500" style="list-style-type: disc; padding-left: 1.5rem; font-family: var(--font-sans, 'Poppins', sans-serif); font-size: 1.1rem; line-height: 1.8; margin-bottom: 2rem;">
              <li>COLLABORATION TYPE</li>
              <li>REQUESTED DELIVERABLES AND PLATFORMS</li>
              <li>REMOTE OR ON-SITE</li>
              <li>DATE AND LOCATION</li>
              <li>WHETHER HMU IS PROVIDED</li>
              <li>REQUESTED USAGE RIGHTS</li>
              <li>BUDGET RANGE, IF AVAILABLE</li>
            </ul>

            <p class="intro-description" data-swiper-parallax="-600" style="font-size: 1.05rem; line-height: 1.5; margin-bottom: 2.5rem; font-weight: 500;">
              IF YOU HAVE A BUDGET RANGE, PLEASE INCLUDE IT SO WE CAN RECOMMEND THE BEST-FIT PACKAGE.
            </p>

            <div class="contact-details-block" data-swiper-parallax="-700" style="font-family: var(--font-sans, 'Poppins', sans-serif);">
              <h3 style="font-size: 1.2rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 0.5rem;">CONTACT:</h3>
              <p style="font-size: 1.2rem; font-weight: 600; margin: 0;">BERNADINE COTE</p>
              <p style="font-size: 1.2rem; font-weight: 400; color: var(--coral); margin: 0;">BERNADINE@THEAUTHENTICASIAN.COM</p>
            </div>
          </div>
          
          <div class="image-wrapper contact-photo" data-swiper-parallax="-200">
            <img src="https://placehold.co/600x700/f0eae5/4a0e0e?text=Contact+Misa" alt="Misa Chien Contact" class="slide-img" />
          </div>
        </div>
      </div>
    <div class="swiper-pagination"></div>
  </div>
</section>

<style>
  .media-kit-container {
    width: 100%;
    height: 100vh;
    background-color: #ffffff;
    overflow: hidden;
    position: relative;
  }

  .media-kit-container .swiper {
    width: 100%;
    height: 100%;
  }

  .media-kit-container .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem;
    box-sizing: border-box;
  }

  .media-kit-container .intro-title {
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    font-size: 5.5rem;
    font-weight: 400;
    letter-spacing: 4px;
    color: var(--coral);
    margin-bottom: 1rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .media-kit-container .intro-subtitle {
    font-family: 'GF Didot', serif;
    font-style: italic;
    font-size: 3rem;
    color: var(--burgundy);
    margin-bottom: 3rem;
    display: inline-block;
    line-height: 1.4;
    background: linear-gradient(
      to bottom, 
      transparent 55%, 
      rgba(231, 120, 96, 0.25) 55%
    );
    padding: 4px 8px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .media-kit-container .intro-subtitle.white-text {
    color: #ffffff;
    background: linear-gradient(
      to bottom, 
      transparent 55%, 
      rgba(255, 255, 255, 0.15) 55%
    );
  }

  .media-kit-container .intro-description {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--burgundy);
    opacity: 0.85;
    margin-bottom: 3.5rem;
    max-width: 600px;
  }

  .media-kit-container .white-text .intro-description {
    color: #ffffff;
  }

  .media-kit-container .section-heading {
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    font-size: 3rem;
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .media-kit-container .intro-meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    background-color: var(--burgundy);
    padding: 1rem 2rem;
    color: #ffffff;
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 1px;
    margin-bottom: 4rem;
    border-radius: 0; 
  }

  .media-kit-container .dot-separator {
    color: var(--coral);
    font-weight: 600;
  }

  .media-kit-container .quiz-action-btn {
    background-color: var(--coral);
    border: 1px solid var(--coral);
    color: #ffffff;
    padding: 1.25rem 3.5rem;
    font-family: 'Poppins', sans-serif;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .media-kit-container .quiz-action-btn:hover {
    background-color: transparent;
    color: var(--coral);
  }

  .media-kit-container .burgundy-bg .quiz-action-btn:hover {
    background-color: #ffffff;
    color: var(--burgundy);
    border-color: #ffffff;
  }

  .media-kit-container .content-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    width: 100%;
    max-width: 1200px;
    align-items: center;
  }

  .media-kit-container .content-grid.standard-layout {
    grid-template-columns: 1fr 1fr;
  }

  .media-kit-container .content-grid.split {
    grid-template-columns: 1fr 1fr;
    height: 100%;
    width: 100vw;
    max-width: none;
    margin: -5rem;
  }

  .media-kit-container .col-left, 
  .media-kit-container .col-right {
    padding: 10%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .media-kit-container .image-wrapper {
    height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .media-kit-container .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-kit-container .coral-bg { background-color: var(--coral); }
  .media-kit-container .burgundy-bg { background-color: var(--burgundy); }
  .media-kit-container .burgundy-text { color: var(--burgundy); }
  .media-kit-container .white-text { color: #ffffff; }
  .media-kit-container .bg-cream { background-color: #f9f4f0; }
  .media-kit-container .bg-white { background-color: #ffffff; }

  .media-kit-container .partner-list {
    list-style: none;
    padding: 0;
  }

  .media-kit-container .partner-list li {
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    font-size: 2rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .media-kit-container .stagger-list .list-item h3 {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-weight: 400;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .media-kit-container .metrics-layout, 
  .media-kit-container .stats-layout, 
  .media-kit-container .pricing-layout, 
  .media-kit-container .contact-layout {
    width: 100%;
    max-width: 1100px;
    text-align: center;
  }

  .media-kit-container .metrics-grid, 
  .media-kit-container .stats-grid, 
  .media-kit-container .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin: 4rem 0;
  }

  .media-kit-container .metric-card {
    background: #ffffff;
    padding: 3rem 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  }

  .media-kit-container .metric-number {
    display: block;
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    font-size: 4rem;
    color: var(--coral);
    margin-bottom: 0.5rem;
  }

  .media-kit-container .metric-label {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 1rem;
    color: var(--burgundy);
  }

  .media-kit-container .stat-box {
    border: 1px solid rgba(255,255,255,0.3);
    padding: 3rem 2rem;
  }

  .media-kit-container .stat-box h3 {
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .media-kit-container .stat-count {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 3rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .media-kit-container .stat-desc {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .media-kit-container .video-slide {
    background: #111111;
  }

  .media-kit-container .video-container {
    width: 100%;
    max-width: 1000px;
    aspect-ratio: 16/9;
    background: #222222;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .media-kit-container .video-placeholder {
    text-align: center;
    color: #ffffff;
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    width: 100%;
    height: 100%;
    position: relative;
  }

  .media-kit-container .video-mock-frame {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    opacity: 0.4;
  }

  .media-kit-container .video-title {
    font-size: 2rem;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 2;
    margin-top: 15%;
  }

  .media-kit-container .play-button {
    width: 80px;
    height: 80px;
    background: var(--coral);
    border-radius: 50%;
    margin: 0 auto 2rem;
    position: relative;
    z-index: 2;
  }

  .media-kit-container .play-button::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 55%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 15px 0 15px 25px;
    border-color: transparent transparent transparent #ffffff;
  }

  .media-kit-container .price-box {
    border: 1px solid var(--coral);
    padding: 3rem 2rem;
    background: #ffffff;
  }

  .media-kit-container .price-box h4 {
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    color: var(--burgundy);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .media-kit-container .price-box p {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-weight: 600;
    color: var(--coral);
    font-size: 1.25rem;
  }

  .media-kit-container .footer-note {
    margin: 0 auto;
  }

  .media-kit-container .contact-details {
    margin: 3rem 0;
  }

  .media-kit-container .contact-email {
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    font-size: 3.5rem;
    color: var(--coral);
    margin-bottom: 1rem;
  }

  .media-kit-container .contact-sub {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
    opacity: 0.8;
  }

  .media-kit-container .options-list {
    list-style: none;
    padding: 0;
    text-align: left;
  }

  .media-kit-container .options-list li {
    font-family: var(--font-logo, 'Tenor Sans', sans-serif);
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 0.5rem;
  }

  .media-kit-container .swiper-slide-active .intro-title,
  .media-kit-container .swiper-slide-active .intro-subtitle,
  .media-kit-container .swiper-slide-active .list-item,
  .media-kit-container .swiper-slide-active .metric-card,
  .media-kit-container .swiper-slide-active .stat-box,
  .media-kit-container .swiper-slide-active .price-box {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Parallax, EffectCreative, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/effect-creative';

  new Swiper('.mySwiper', {
    modules: [Navigation, Pagination, Parallax, EffectCreative, Autoplay],
    speed: 1000,
    parallax: true,
    mousewheel: true,
    grabCursor: true,
    effect: 'creative',
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },
    creativeEffect: {
      prev: {
        shadow: true,
        translate: ['-20%', 0, -1],
      },
      next: {
        translate: ['100%', 0, 0],
      },
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
  });
</script>
