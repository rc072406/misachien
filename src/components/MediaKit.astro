---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
import slide8Image from '../../public/images/90.webp';
import slide12Image from '../../public/images/79.webp';
import misaVideo from '../../public/videos/Misa Chien Speaker Reel.mp4';
---

<div class={`media-kit-wrapper ${className}`}>
  
  <section class="media-section" data-theme="light">
    <div class="luxury-noise-overlay"></div>
    <div class="luxury-watermark left-align">01</div>
    <div class="section-inner split-layout screen-constrained">
      <div class="section-content">
        <div class="meta-category-pill">FOUNDER • COMMUNITY BUILDER • SPEAKER • AUTHOR • ENTREPRENEUR</div>
        <h1 class="hero-title">Misa <em>Chien.</em></h1>
        <h2 class="hero-subtitle">Authentic Storytelling</h2>
        <p class="header-note">FOR SELECT BRAND, MEDIA, AND SPEAKING PARTNERSHIPS</p>
        <p class="section-description">Misa brings founder-to-founder credibility, trusted community access, and authentic storytelling across leadership, identity, ambition, and belonging.</p>
        
        <div class="metrics-display-grid">
          <div class="metric-group">
            <h3>PLATFORMS</h3>
            <p>LinkedIn<br />Instagram<br />Newsletter</p>
          </div>
          <div class="metric-group">
            <h3>AUDIENCE METRICS</h3>
            <p>LinkedIn: <strong class="stat-highlight">48,300+</strong><br />Instagram: <strong class="stat-highlight">13,000+</strong><br />Newsletter: <strong class="stat-highlight">3,000+</strong></p>
          </div>
        </div>
      </div>
      <div class="section-visual-panel image-constrained-wrapper">
        <div class="image-mask">
          <img src={slide12Image.src} class="section-image" alt="Misa Chien Hero">
        </div>
      </div>
    </div>
  </section>

  <section class="media-section" data-theme="light">
    <div class="luxury-noise-overlay"></div>
    <div class="luxury-watermark right-align">02</div>
    <div class="section-inner grid-two-col screen-constrained">
      <div class="section-content editorial-border-right">
        <h2 class="section-heading">WHY PARTNERS WORK WITH MISA</h2>
        <h3 class="subsection-subheading">WHAT OUR PARTNERS GET:</h3>
        <ul class="value-prop-list">
          <li>Founder-to-founder credibility</li>
          <li>Trusted audience and community resonance</li>
          <li>Authentic storytelling</li>
          <li>Clear communication and professional execution</li>
          <li>Thoughtful recommendations based on campaign fit</li>
        </ul>
      </div>
      <div class="section-content alt-column-panel">
        <div class="content-block-chunk">
          <h3 class="block-title-heading">BEST-FIT PARTNERSHIPS:</h3>
          <p class="block-body-text">We partner with brands, teams, and organizers whose goals align with Misa's values, audience, and voice.</p>
        </div>
        <div class="content-block-chunk">
          <h3 class="block-title-heading">PREVIOUS PARTNERS:</h3>
          <p class="brands-list-paragraph"><strong>Brands:</strong> 1587 Sneakers, Sulwhasoo, Fabletics, GNC, Revitalash</p>
          <p class="brands-list-paragraph"><strong>TV:</strong> The Great Food Truck Race Season 1</p>
        </div>
      </div>
    </div>
  </section>

  <section class="media-section" data-theme="dark">
    <div class="luxury-noise-overlay"></div>
    <div class="luxury-watermark left-align">03</div>
    <div class="section-inner cinematic-video-layout screen-constrained">
      <div class="section-content">
        <div class="meta-category-pill">IMPACT • RESONANCE</div>
        <h2 class="section-heading inverse-text">FEATURED WORK</h2>
        <h3 class="subsection-subheading">STORIES IN MOTION</h3>
      </div>
      <div class="section-visual-panel cinematic-panel">
        <div class="luxury-video-frame">
          <video muted loop playsinline class="cinematic-native-video">
            <source src={misaVideo} type="video/mp4" />
          </video>
          <button class="audio-toggle-badge" aria-label="Toggle Audio">
            <span class="pulse-ring"></span>
            <span class="audio-status-text">TAP FOR AUDIO</span>
          </button>
        </div>
      </div>
    </div>
  </section>
  
  <section class="media-section" data-theme="light">
    <div class="luxury-noise-overlay"></div>
    <div class="luxury-watermark right-align">04</div>
    <div class="section-inner split-layout inversion-layout screen-constrained">
      <div class="section-visual-panel image-constrained-wrapper">
        <div class="image-mask">
          <img src={slide8Image.src} class="section-image" alt="Misa Chien Contact">
        </div>
      </div>
      <div class="section-content">
        <h2 class="section-heading">REQUEST A QUOTE</h2>
        <p class="intro-context-text">Please share collaboration type, deliverables, location, usage needs, and your budget range.</p>
        
        <div class="contact-card-anchor-block">
          <span class="contact-pre-header-label">PARTNERSHIPS:</span>
          <p class="agent-contact-name-text">BERNADINE COTE</p>
          <a href="mailto:BERNADINE@THEAUTHENTICASIAN.COM" class="btn-filled-luxury">
            <span>BERNADINE@THEAUTHENTICASIAN.COM</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const allVideos = document.querySelectorAll('.cinematic-native-video');
    
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.play().catch(() => {});
        } else {
          entry.target.pause();
        }
      });
    }, { threshold: 0.15 });

    allVideos.forEach(video => {
      videoObserver.observe(video);
    });
  });

  document.addEventListener('click', (e) => {
    const toggleBtn = e.target.closest('.audio-toggle-badge');
    if (!toggleBtn) return;

    const section = toggleBtn.closest('.media-section');
    const video = section ? section.querySelector('.cinematic-native-video') : null;
    const textLabel = toggleBtn.querySelector('.audio-status-text');

    if (video) {
      if (video.muted) {
        video.muted = false;
        toggleBtn.classList.add('sound-on');
        if (textLabel) textLabel.textContent = "MUTE AUDIO";
      } else {
        video.muted = true;
        toggleBtn.classList.remove('sound-on');
        if (textLabel) textLabel.textContent = "TAP FOR AUDIO";
      }
    }
  });
</script>

<style>
  .media-kit-wrapper {
    --burgundy: #59363a;
    --coral: #e77860;
    --cream-background: #fef4ef;
    --soft-white: #ffffff;
    --light-grey-border: rgba(89, 54, 58, 0.12);
    --dark-grey-text: #333333;
    --font-display: 'Libre Baskerville', serif;
    --font-sans: 'Helvetica Neue', 'Inter', sans-serif;
    width: 100%;
    background-color: var(--soft-white);
    display: flex;
    flex-direction: column;
  }

  .media-section {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .media-section:first-child {
    border-bottom: 1px solid var(--light-grey-border);
  }

  h1 em {
    color: var(--coral);
  }

  .luxury-noise-overlay {
    position: absolute;
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%;
    pointer-events: none;
    z-index: 1;        
   
  }

  .media-section[data-theme="light"] { 
    background-color: var(--cream-background); 
    color: var(--dark-grey-text); 
  }

  .media-section[data-theme="dark"] { 
    background: var(--burgundy); 
    color: var(--soft-white); 
  }

  .media-section[data-theme="light"] .luxury-noise-overlay {
    opacity: 0.1;              
    mix-blend-mode: multiply;   
  }

  .media-section[data-theme="dark"] .luxury-noise-overlay {
    opacity: 0.04;             
    mix-blend-mode: normal;     
  }

  .screen-constrained {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1350px;
    margin: 0 auto;
    position: relative;
    z-index: 5; 
  }

  .section-content, .section-visual-panel {
    min-width: 0;
  }

  .image-constrained-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%; 
  }

  .image-mask {
    width: 100%;
    max-width: 500px;
    position: relative;
  }

  .section-image { 
    width: 100%; 
    height: auto; 
    object-fit: cover; 
    display: block;
  }

  .luxury-watermark {
    position: absolute;
    font-family: var(--font-display);
    font-size: 32vh;
    line-height: 1;
    z-index: 2; 
    pointer-events: none;
    bottom: 5vh; 
    white-space: nowrap;
  }
  
  .media-section[data-theme="light"] .luxury-watermark {
    opacity: 0.35; 
    color: #F1DFDC;
  }

  .media-section[data-theme="dark"] .luxury-watermark {
    opacity: 0.03; 
    color: var(--soft-white); 
  }

  .luxury-watermark.left-align { left: 5vw; right: auto; }
  .luxury-watermark.right-align { right: 5vw; left: auto; }

  .meta-category-pill {
    display: inline-block;
    color: var(--burgundy);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--coral);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 3px;
    margin-bottom: 3vh;
  }

  .media-section[data-theme="dark"] .meta-category-pill { 
    color: var(--soft-white); 
    border-bottom: 1px solid var(--coral); 
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: calc(3rem + 2.5vw);
    font-weight: 400;
    color: var(--burgundy);
    line-height: 0.9;
    margin-bottom: 1vh;
  }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-style: italic;
    color: var(--coral);
    margin-bottom: 4vh;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: calc(1.8rem + 0.5vw);
    font-weight: 400;
    color: var(--burgundy);
    line-height: 1.1;
    margin-bottom: 3.5vh;
    text-transform: uppercase;
  }
  
  .section-heading.inverse-text { color: var(--soft-white); }

  .subsection-subheading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--coral);
    letter-spacing: 2px;
    margin-bottom: 2.5vh;
    text-transform: uppercase;
  }

  .header-note {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 2px;
    color: var(--burgundy);
    margin-bottom: 3.5vh;
    border-left: 1px solid var(--coral);
    padding-left: 1rem;
  }

  .section-description, .intro-context-text {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--dark-grey-text);
    margin-bottom: 5vh;
    max-width: 480px;
  }

  .media-section[data-theme="dark"] .section-description { 
    color: rgba(255, 255, 255, 0.75); 
  }

  .split-layout { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 5vw; }
  .grid-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; }
  .editorial-border-right { border-right: 1px solid var(--light-grey-border); padding-right: 4vw; }

  .content-block-chunk { margin-bottom: 4.5vh; }
  .content-block-chunk:last-child { margin-bottom: 0; }
  
  .block-title-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--coral);
    letter-spacing: 2px;
    margin-bottom: 1.5vh;
    text-transform: uppercase;
  }
  
  .block-body-text, .brands-list-paragraph {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--dark-grey-text);
    margin: 0;
  }
  
  .brands-list-paragraph { margin-bottom: 2vh; }

  .metrics-display-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .metric-group h3 { font-family: var(--font-sans); font-size: 0.6rem; letter-spacing: 2px; color: var(--coral); margin-bottom: 0.8rem; }
  .metric-group p { font-family: var(--font-sans); font-size: 0.9rem; line-height: 1.7; margin: 0; }

  .value-prop-list { list-style: none; padding-left: 0; margin: 0; }
  .value-prop-list li { font-family: var(--font-sans); font-size: 0.9rem; line-height: 1.7; margin-bottom: 2vh; }

  .agent-contact-name-text { font-family: var(--font-display); font-size: 2.2rem; color: var(--burgundy); margin: 1vh 0 3.5vh 0; }
  
  .btn-filled-luxury { 
    display: inline-flex; 
    align-items: center;
    justify-content: center;
    background: var(--burgundy); 
    color: var(--soft-white); 
    padding: 1.25rem 3rem; 
    font-family: var(--font-sans); 
    font-size: 0.95rem; 
    font-weight: 500;
    letter-spacing: 2px;
    width: auto;                
    max-width: none;         
    white-space: nowrap;        
    box-sizing: border-box;
    text-align: center;
    text-decoration: none;
    z-index: 10;
    position: relative;
    border: 1px solid var(--burgundy);
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .btn-filled-luxury:hover {
    background: transparent;
    color: var(--burgundy);
  }

  .cinematic-video-layout { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 4vw; align-items: center; width: 100%; }
  .cinematic-panel { width: 100%; display: flex; align-items: center; justify-content: flex-end; }

  .luxury-video-frame {
    position: relative;
    width: 100%;
    max-width: 820px; 
    aspect-ratio: 16 / 9; 
    background-color: #000000;
    border: 1px solid rgba(255, 255, 255, 0.08); 
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5); 
    overflow: hidden;
    z-index: 10; 
  }

  .luxury-video-frame video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }

  .audio-toggle-badge {
    position: absolute;
    bottom: 24px;
    right: 24px;
    z-index: 20;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .audio-toggle-badge:hover { background: rgba(255, 255, 255, 0.9); border-color: var(--soft-white); }
  .audio-toggle-badge:hover .audio-status-text { color: var(--burgundy); }

  .audio-status-text { font-family: var(--font-sans); font-size: 0.65rem; font-weight: 500; letter-spacing: 2px; color: var(--soft-white); transition: color 0.3s ease; }

  .pulse-ring { width: 6px; height: 6px; background-color: var(--coral); border-radius: 50%; position: relative; }
  .pulse-ring::after { content: ''; position: absolute; top: -6px; left: -6px; right: -6px; bottom: -6px; border: 1px solid var(--coral); border-radius: 50%; animation: luxuryPulse 2s infinite ease-out; opacity: 0; }

  @keyframes luxuryPulse {
    0% { transform: scale(0.6); opacity: 0; }
    50% { opacity: 0.5; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  @media(max-width: 960px) {


    .screen-constrained {
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: flex-start !important;
      gap: 5vh !important;
    }

    .split-layout, .grid-two-col, .cinematic-video-layout {
      grid-template-columns: 1fr !important;
      gap: 5vh !important;
      width: 100%;
    }
    
    .editorial-border-right {
      border-right: none !important;
      padding-right: 0 !important;
      padding-bottom: 4vh !important;
      border-bottom: 1px solid var(--light-grey-border);
    }

    .hero-title { font-size: calc(2.2rem + 1.5vw); }
    .section-description, .intro-context-text { max-width: 100% !important; margin-bottom: 3vh; }
    
    .metrics-display-grid { 
      grid-template-columns: 1fr 1fr !important; 
      gap: 1.5rem; 
    }

    .image-constrained-wrapper {
      width: 100% !important;
      margin-top: 2vh;
    }

    .image-mask {
      max-width: 100% !important;
    } 
    
    .cinematic-panel { width: 100% !important; justify-content: center !important; }
    .luxury-video-frame { max-width: 100% !important; width: 100% !important; aspect-ratio: 16 / 9 !important; }
    
    .btn-filled-luxury { 
      font-size: 0.8rem !important;
      padding: 1.15rem 1.5rem !important; 
      width: 100% !important;          
      max-width: 100% !important;
      white-space: normal !important;
      line-height: 1.4 !important;
    }
    
    .luxury-watermark { display: none !important; }
  }
</style>
