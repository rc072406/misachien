---
---

<section class="media-kit-container">
  <div class="swiper mySwiper">
    <div class="swiper-wrapper">
      
      <div class="swiper-slide intro-slide" data-swiper-parallax="-200">
        <div class="content-grid">
          <div class="text-content">
            <div class="intro-meta-pill" data-swiper-parallax="-300">
              FOUNDER <span class="dot-separator">•</span> COMMUNITY BUILDER <span class="dot-separator">•</span> SPEAKER
            </div>
            <h1 class="intro-title" data-swiper-parallax="-500">MISA CHIEN</h1>
            <p class="intro-subtitle" data-swiper-parallax="-700">Authentic Storytelling</p>
            <p class="intro-description" data-swiper-parallax="-900">
              Misa brings founder-to-founder credibility, trusted community access, 
              and authentic storytelling across leadership, identity, and ambition.
            </p>
            <button class="quiz-action-btn">WORK WITH ME</button>
          </div>
          <div class="image-placeholder main-photo" data-swiper-parallax="-100">
            <span>[PHOTO: MISA HERO]</span>
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-cream">
        <div class="content-grid standard-layout">
          <div class="text-content burgundy-text">
            <h2 class="section-heading" data-swiper-parallax="-400">THE STORY BEHIND THE STORYTELLER</h2>
            <p class="intro-description" data-swiper-parallax="-600">
              As a seasoned entrepreneur who has scaled multiple businesses, Misa understands the highs and lows of the founder journey. Her content bridges the gap between raw corporate reality and inspiring personal growth, making her a trusted voice for modern professionals.
            </p>
          </div>
          <div class="image-placeholder profile-photo" data-swiper-parallax="-200">
            <span>[PHOTO: ABOUT MISA]</span>
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-white">
        <div class="content-grid split">
          <div class="col-left burgundy-text">
            <h2 class="section-heading">WHY PARTNERS WORK WITH MISA</h2>
            <div class="stagger-list" data-swiper-parallax="-400">
              <div class="list-item"><h3>Founder-to-founder credibility</h3></div>
              <div class="list-item"><h3>Trusted audience and community resonance</h3></div>
              <div class="list-item"><h3>Authentic storytelling</h3></div>
            </div>
          </div>
          <div class="col-right coral-bg">
            <h2 class="section-heading white-text">PREVIOUS PARTNERS</h2>
            <ul class="partner-list">
              <li>1587 Sneakers</li>
              <li>Fabletics</li>
              <li>GNC</li>
              <li>The Little Bra Company</li>
              <li>Revitalash</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-cream">
        <div class="metrics-layout">
          <h2 class="section-heading burgundy-text" data-swiper-parallax="-300">AUDIENCE DEMOGRAPHICS</h2>
          <div class="metrics-grid">
            <div class="metric-card" data-swiper-parallax="-400">
              <span class="metric-number">72%</span>
              <span class="metric-label">Female Identified</span>
            </div>
            <div class="metric-card" data-swiper-parallax="-500">
              <span class="metric-number">25-44</span>
              <span class="metric-label">Primary Age Range</span>
            </div>
            <div class="metric-card" data-swiper-parallax="-600">
              <span class="metric-number">Top Us</span>
              <span class="metric-label">CA, NY, TX Metro Areas</span>
            </div>
          </div>
        </div>
      </div>

      <div class="swiper-slide coral-bg">
        <div class="stats-layout">
          <h2 class="section-heading white-text" data-swiper-parallax="-200">CHANNELS & ENGAGEMENT</h2>
          <div class="stats-grid">
            <div class="stat-box" data-swiper-parallax="-300">
              <h3>LinkedIn</h3>
              <p class="stat-count">50K+</p>
              <p class="stat-desc">Executive Network</p>
            </div>
            <div class="stat-box" data-swiper-parallax="-400">
              <h3>Instagram</h3>
              <p class="stat-count">120K+</p>
              <p class="stat-desc">Highly Active Community</p>
            </div>
            <div class="stat-box" data-swiper-parallax="-500">
              <h3>TikTok</h3>
              <p class="stat-count">85K+</p>
              <p class="stat-desc">Viral Video Reach</p>
            </div>
          </div>
        </div>
      </div>

      <div class="swiper-slide video-slide">
        <div class="video-container" data-swiper-parallax-scale="0.8">
          <div class="video-placeholder">
            <div class="play-button"></div>
            <p class="video-title">WATCH MISA IN ACTION</p>
            <span>[VIDEO ELEMENT PLACEHOLDER]</span>
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-white">
        <div class="content-grid standard-layout">
          <div class="image-placeholder case-study-photo" data-swiper-parallax="-300">
            <span>[IMAGE: CASE STUDY HIGHLIGHT]</span>
          </div>
          <div class="text-content burgundy-text">
            <h2 class="section-heading" data-swiper-parallax="-500">RECENT SUCCESS</h2>
            <p class="intro-subtitle" data-swiper-parallax="-600">Case Study</p>
            <p class="intro-description" data-swiper-parallax="-700">
              Our latest campaign drove exceptional organic reach, blending natural product integration with high-level career advice. The campaign yielded over 500k combined views and an engagement rate triple the industry standard.
            </p>
          </div>
        </div>
      </div>

      <div class="swiper-slide coral-bg">
        <div class="content-grid">
          <div class="text-content white-text">
            <h2 class="intro-title">COLLABORATION OPTIONS</h2>
            <ul class="options-list">
              <li data-swiper-parallax="-200">SPONSORED CONTENT</li>
              <li data-swiper-parallax="-300">SPEAKING / KEYNOTE</li>
              <li data-swiper-parallax="-400">PANELS & MODERATION</li>
              <li data-swiper-parallax="-500">MODELING / PHOTOSHOOTS</li>
            </ul>
          </div>
          <div class="image-placeholder montage-photo" data-swiper-parallax="-800">
             <span>[MONTAGE IMAGE]</span>
          </div>
        </div>
      </div>

      <div class="swiper-slide bg-cream">
        <div class="pricing-layout">
            <h2 class="section-heading burgundy-text">PRICING ANCHORS</h2>
            <div class="pricing-grid">
                <div class="price-box">
                    <h4>Speaking Engagements</h4>
                    <p>From $5,000</p>
                </div>
                <div class="price-box">
                    <h4>Paid Collaboration</h4>
                    <p>From $1,800</p>
                </div>
                <div class="price-box">
                    <h4>Photoshoots (Half-Day)</h4>
                    <p>From $2,500</p>
                </div>
            </div>
            <p class="intro-description footer-note">Bundle pricing available for multi-platform campaigns.</p>
        </div>
      </div>

      <div class="swiper-slide burgundy-bg">
        <div class="contact-layout white-text">
          <h2 class="intro-title" data-swiper-parallax="-300">LET'S BUILD SOMETHING TOGETHER</h2>
          <p class="intro-subtitle white-text" data-swiper-parallax="-500">Next Steps</p>
          <div class="contact-details" data-swiper-parallax="-700">
            <p class="contact-email">hello@misachien.com</p>
            <p class="contact-sub">Reach out directly to review custom deliverables and availability calendars.</p>
          </div>
          <button class="quiz-action-btn" data-swiper-parallax="-900">GET IN TOUCH</button>
        </div>
      </div>

    </div>
    <div class="swiper-pagination"></div>
  </div>
</section>

<style>
  :root {
    --coral: #e77860;
    --burgundy: #4a0e0e; 
    --white: #ffffff;
    --cream: #f9f4f0;
    --font-logo: 'Tenor Sans', sans-serif;
    --font-sans: 'Poppins', sans-serif;
    --font-serif: 'GF Didot', serif;
  }

  .media-kit-container {
    width: 100%;
    height: 100vh;
    background-color: var(--white);
    overflow: hidden;
  }

  .swiper {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem;
    box-sizing: border-box;
  }

  .intro-title {
    font-family: var(--font-logo);
    font-size: 5.5rem;
    font-weight: 400;
    letter-spacing: 4px;
    color: var(--coral);
    margin-bottom: 1rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .intro-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 3rem;
    color: var(--burgundy);
    margin-bottom: 3rem;
    display: inline-block;
    line-height: 1.4;
    background: linear-gradient(
      to bottom, 
      transparent 55%, 
      rgba(231, 120, 96, 0.25) 55%
    );
    padding: 4px 8px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .intro-subtitle.white-text {
    color: var(--white);
    background: linear-gradient(
      to bottom, 
      transparent 55%, 
      rgba(255, 255, 255, 0.15) 55%
    );
  }

  .intro-description {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--burgundy);
    opacity: 0.85;
    margin-bottom: 3.5rem;
    max-width: 600px;
  }

  .white-text .intro-description {
    color: var(--white);
  }

  .section-heading {
    font-family: var(--font-logo);
    font-size: 3rem;
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .intro-meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    background-color: var(--burgundy);
    padding: 1rem 2rem;
    color: var(--white);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 1px;
    margin-bottom: 4rem;
    border-radius: 0; 
  }

  .dot-separator {
    color: var(--coral);
    font-weight: 600;
  }

  .quiz-action-btn {
    background-color: var(--coral);
    border: 1px solid var(--coral);
    color: var(--white);
    padding: 1.25rem 3.5rem;
    font-family: 'Poppins', sans-serif;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .quiz-action-btn:hover {
    background-color: transparent;
    color: var(--coral);
  }

  .burgundy-bg .quiz-action-btn:hover {
    background-color: var(--white);
    color: var(--burgundy);
    border-color: var(--white);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    width: 100%;
    max-width: 1200px;
    align-items: center;
  }

  .content-grid.standard-layout {
    grid-template-columns: 1fr 1fr;
  }

  .content-grid.split {
    grid-template-columns: 1fr 1fr;
    height: 100%;
    width: 100vw;
    max-width: none;
    margin: -5rem;
  }

  .col-left, .col-right {
    padding: 10%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .image-placeholder {
    background: #f0eae5;
    height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    color: var(--burgundy);
    opacity: 0.5;
    border-radius: 0px;
  }

  .coral-bg { background-color: var(--coral); }
  .burgundy-bg { background-color: var(--burgundy); }
  .burgundy-text { color: var(--burgundy); }
  .white-text { color: var(--white); }
  .bg-cream { background-color: var(--cream); }
  .bg-white { background-color: var(--white); }

  .partner-list {
    list-style: none;
    padding: 0;
  }

  .partner-list li {
    font-family: var(--font-logo);
    font-size: 2rem;
    color: var(--white);
    margin-bottom: 1rem;
  }

  .stagger-list .list-item h3 {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .metrics-layout, .stats-layout, .pricing-layout, .contact-layout {
    width: 100%;
    max-width: 1100px;
    text-align: center;
  }

  .metrics-grid, .stats-grid, .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin: 4rem 0;
  }

  .metric-card {
    background: var(--white);
    padding: 3rem 2rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  }

  .metric-number {
    display: block;
    font-family: var(--font-logo);
    font-size: 4rem;
    color: var(--coral);
    margin-bottom: 0.5rem;
  }

  .metric-label {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--burgundy);
  }

  .stat-box {
    border: 1px solid rgba(255,255,255,0.3);
    padding: 3rem 2rem;
  }

  .stat-box h3 {
    font-family: var(--font-logo);
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .stat-count {
    font-family: var(--font-sans);
    font-size: 3rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .stat-desc {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .video-slide {
    background: #111;
  }

  .video-container {
    width: 100%;
    max-width: 1000px;
    aspect-ratio: 16/9;
    background: #222;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-placeholder {
    text-align: center;
    color: white;
    font-family: var(--font-logo);
  }

  .video-title {
    font-size: 2rem;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .play-button {
    width: 80px;
    height: 80px;
    background: var(--coral);
    border-radius: 50%;
    margin: 0 auto 2rem;
    position: relative;
  }

  .play-button::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 55%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 15px 0 15px 25px;
    border-color: transparent transparent transparent white;
  }

  .price-box {
    border: 1px solid var(--coral);
    padding: 3rem 2rem;
    background: var(--white);
  }

  .price-box h4 {
    font-family: var(--font-logo);
    color: var(--burgundy);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .price-box p {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--coral);
    font-size: 1.25rem;
  }

  .footer-note {
    margin: 0 auto;
  }

  .contact-details {
    margin: 3rem 0;
  }

  .contact-email {
    font-family: var(--font-logo);
    font-size: 3.5rem;
    color: var(--coral);
    margin-bottom: 1rem;
  }

  .contact-sub {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
    opacity: 0.8;
  }

  .options-list {
    list-style: none;
    padding: 0;
    text-align: left;
  }

  .options-list li {
    font-family: var(--font-logo);
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 0.5rem;
  }

  .swiper-slide-active .intro-title,
  .swiper-slide-active .intro-subtitle,
  .swiper-slide-active .list-item,
  .swiper-slide-active .metric-card,
  .swiper-slide-active .stat-box,
  .swiper-slide-active .price-box {
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Parallax, EffectCreative } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/effect-creative';

  new Swiper('.mySwiper', {
    modules: [Navigation, Pagination, Parallax, EffectCreative],
    speed: 1000,
    parallax: true,
    mousewheel: true,
    grabCursor: true,
    effect: 'creative',
    creativeEffect: {
      prev: {
        shadow: true,
        translate: ['-20%', 0, -1],
      },
      next: {
        translate: ['100%', 0, 0],
      },
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
  });
</script>
