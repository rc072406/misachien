              <div class="rate-listing-row-item"><span>Video Post</span><strong>$2,500</strong></div>
            </div>

            <div class="platform-package-tier-box">
              <div class="platform-box-header">
                <h4>NEWSLETTER <span class="platform-box-subtitle-followers">(3K+ Subscribers)</span></h4>
              </div>
              <div class="rate-listing-row-item"><span>Featured Placement</span><strong>$800</strong></div>
              <p class="compact-card-fineprint">Affiliate tracking: 20% commission per purchase. Fixed base placement rules apply.</p>
            </div>
          </div>

          <div class="slide-content bundle-layout-panel">
            <div class="bundle-package-matrix-card">
              <div class="bundle-matrix-card-header">
                <h3>CAMPAIGN BUNDLES</h3>
