<script>
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  
  import Swiper from 'swiper';

  import { Navigation, Pagination, Keyboard, Mousewheel, Autoplay } from 'swiper/modules';

  const initSwiper = () => {
    const swiperEl = document.querySelector('.mediaKitSwiper');
    if (swiperEl && !swiperEl.swiper) {
      new Swiper('.mediaKitSwiper', {
       
        modules: [Navigation, Pagination, Keyboard, Mousewheel, Autoplay],
        direction: 'horizontal',
        loop: false,
        speed: 700,
        
       
        autoplay: {
          delay: 4000, 
          disableOnInteraction: false, 
      
        },
        
        mousewheel: {
          forceToAxis: true,
        },
        keyboard: {
          enabled: true,
          onlyInViewport: true,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
      });
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwiper);
  } else {
    initSwiper();
  }

  setTimeout(initSwiper, 100);
</script>

<style>

  .media-kit-swiper-wrapper {
    --burgundy: #59363a;
    --coral: #e77860;
    --cream-background: #fef4ef;
    --soft-white: #ffffff;
    --light-grey-border: rgba(89, 54, 58, 0.1);
    --dark-grey-text: #2d2d2d;
    --font-display: 'Tenor Sans', sans-serif;
    --font-sans: 'Poppins', sans-serif;
    
    width: 100%;
    position: relative;
    background-color: var(--soft-white);
  }

 
  .swiper {
    width: 100%;
    height: 100vh;
    min-height: 720px;
  }

  .swiper-slide {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4rem 6rem;
    position: relative;
    overflow: hidden;
  }

  
  .swiper-slide[data-theme="cream"] {
    background-color: var(--cream-background);
  }
  .swiper-slide[data-theme="light"] {
    background-color: var(--soft-white);
  }
  .swiper-slide[data-theme="dark"] {
    background-color: var(--burgundy);
  }

 
  .meta-category-pill {
    display: inline-flex;
    background-color: var(--burgundy);
    color: var(--soft-white);
    padding: 0.6rem 1.2rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 2rem;
  }


  .hero-title {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 400;
    color: var(--coral);
    line-height: 1;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 2.2rem;
    font-weight: 300;
    font-style: italic;
    color: var(--burgundy);
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 400;
    color: var(--burgundy);
    line-height: 1.2;
    letter-spacing: 2px;
    margin-bottom: 2rem;
    text-transform: uppercase;
  }

  .section-heading.inverse-text {
    color: var(--soft-white);
  }

  .text-center {
    text-align: center;
  }

  /* EMULATED HIGHLIGHT HIGHLIGHTER EFFECT SYSTEM */
  .marker {
    background: linear-gradient(to bottom, transparent 55%, rgba(231, 120, 96, 0.25) 55%);
    padding: 4px 8px;
    display: inline;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .marker.dark-marker {
    background: linear-gradient(to bottom, transparent 55%, rgba(231, 120, 96, 0.4) 55%);
    color: var(--soft-white);
  }

  .subsection-subheading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--coral);
    letter-spacing: 1px;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .swiper-slide[data-theme="dark"] .subsection-subheading {
    color: var(--cream-background);
  }

  .header-note {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--burgundy);
    margin-bottom: 1rem;
  }

  .slide-description, .intro-context-text {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--dark-grey-text);
    margin-bottom: 2.5rem;
    max-width: 620px;
  }

  .swiper-slide[data-theme="dark"] .slide-description {
    color: var(--cream-background);
  }


  .slide-inner {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
  }

  .split-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  .split-layout.inversion-layout {
