---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
import slide1Image from '../../public/images/width_8001.webp';
import slide5Image from '../../public/images/width_640.webp';
import slide7Image from '../../public/images/width_533.webp';
import slide9Image from '../../public/images/width_640 (1).webp';
---

<div class={`media-kit-swiper-wrapper ${className}`}>
  <div class="luxury-noise-overlay"></div>
  
  <div class="swiper mediaKitSwiper">
    <div class="swiper-wrapper">
      
      <div class="swiper-slide" data-theme="cream">
        <div class="luxury-watermark" data-swiper-parallax="-400">01</div>
        <div class="slide-inner split-layout screen-constrained" data-swiper-parallax="-200">
          <div class="slide-content">
