    :root {
      --cream: #fcfbf7;
      --peach: #fbd6c6;
      --font-accent: 'GF Didot', 'Playfair Display', serif;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: var(--font-sans);
      background-color: var(--cream);
    }

    
    .media-kit-container {
      width: 100%;
      height: 100vh;
      background-color: #ffffff;
      overflow: hidden;
      position: relative;
    }

    .swiper {
      width: 100%;
      height: 100%;
    }

    .swiper-slide {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 5rem;
      box-sizing: border-box;
      overflow-y: auto; 
    }

    
    .content-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
      width: 100%;
      max-width: 1250px;
      align-items: center;
      margin: 0 auto;
    }

    .content-grid.standard-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .content-grid.split {
      grid-template-columns: 1fr 1fr;
      max-width: none;
      gap: 0;
      height: 100%;
    }

    .col-left, .col-right {
      padding: 5rem;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
    }

  
    .image-wrapper {
      width: 100%;
      height: 600px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
    }
    
    .slide-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    
    .coral-bg { background-color: var(--coral); }
    .burgundy-bg { background-color: var(--burgundy); }
    .bg-cream { background-color: var(--cream); }
    .bg-peach { background-color: var(--peach); }
    .bg-white { background-color: #ffffff; }
    
    .burgundy-text { color: var(--burgundy); }
    .white-text { color: #ffffff; }
    .coral-text { color: var(--coral); }

    .slide-header {
      font-family: var(--font-logo);
      font-weight: bold;
      line-height: 1.1;
      margin-top: 0;
      margin-bottom: 2rem;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

   
    .marker-highlight {
      display: inline-block;
      font-family: var(--font-accent);
      font-style: italic;
      font-weight: 400;
      background: linear-gradient(to bottom, transparent 55%, rgba(231, 120, 96, 0.25) 55%);
      padding: 4px 8px;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      margin-bottom: 1.5rem;
    }

    .white-text .marker-highlight {
      background: linear-gradient(to bottom, transparent 55%, rgba(255, 255, 255, 0.25) 55%);
    }

    .marker-highlight.sans-serif-mode {
      font-family: var(--font-logo);
      font-style: normal;
      font-weight: bold;
    }

    /* Slide Elements */
    .intro-meta-pill {
      display: inline-flex;
      align-items: center;
      gap: 1.25rem;
      background-color: var(--burgundy);
      padding: 1rem 2rem;
      color: #ffffff;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      letter-spacing: 1px;
      margin-bottom: 3rem;
    }

    .dot-separator { color: var(--coral); font-weight: 600; }

    .quiz-action-btn {
      background-color: var(--coral);
      border: 1px solid var(--coral);
      color: #ffffff;
      padding: 1.25rem 3.5rem;
      font-family: var(--font-sans);
      font-weight: 600;
      letter-spacing: 0.15em;
      cursor: pointer;
      transition: all 0.3s ease;
      text-transform: uppercase;
    }

    .quiz-action-btn:hover {
      background-color: transparent;
      color: var(--coral);
    }

  
    .styled-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 300;
      line-height: 1.8;
    }
    
    .styled-list.bulleted li {
      margin-bottom: 0.4rem;
      padding-left: 1.2rem;
      text-indent: -1.2rem;
    }
    .styled-list.bulleted li::before {
      content: "• ";
    }

    
    .video-slide { background: #111111; }
    .video-container {
      width: 100%;
      max-width: 1000px;
      aspect-ratio: 16/9;
      background: #222222;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .video-placeholder {
      text-align: center;
      color: #ffffff;
      font-family: var(--font-logo);
      width: 100%;
      height: 100%;
      position: relative;
    }
    .video-mock-frame {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0; left: 0;
      z-index: 1;
      opacity: 0.4;
    }
    .video-title {
      font-size: 2rem;
      letter-spacing: 2px;
      margin-bottom: 0.5rem;
      position: relative;
      z-index: 2;
      margin-top: 15%;
    }
    .play-button {
      width: 80px; height: 80px;
      background: var(--coral);
      border-radius: 50%;
      margin: 0 auto 2rem;
      position: relative;
      z-index: 2;
    }
    .play-button::after {
      content: '';
      position: absolute;
      top: 50%; left: 55%;
      transform: translate(-50%, -50%);
      border-style: solid;
      border-width: 15px 0 15px 25px;
      border-color: transparent transparent transparent #ffffff;
    }

    
    .animate-up { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .swiper-slide-active .animate-up { opacity: 1; transform: translateY(0); }
    
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }
    .delay-4 { transition-delay: 0.4s; }

    /* Custom Swiper Pagination Dots */
    .swiper-pagination-bullet { background: var(--burgundy); opacity: 0.3; }
    .swiper-pagination-bullet-active { opacity: 1; background: var(--coral); }

    /* ---------------- MOBILE RESPONSIVENESS ---------------- */
    @media (max-width: 992px) {
      .media-kit-container .swiper-slide {
        padding: 3rem 2rem;
        height: auto;
        min-height: 100vh;
      }
      .content-grid, .content-grid.standard-layout, .content-grid.split {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .col-left, .col-right {
        padding: 2rem 0;
      }
      .content-grid.split {
        display: flex;
        flex-direction: column;
      }
      .slide-header {
        font-size: 2.5rem !important;
      }
      h2[style*="font-size: 5rem"], 
      h2[style*="font-size: 4.5rem"] {
        font-size: 3rem !important;
      }
      .intro-title {
        font-size: 3.5rem !important;
      }
      .marker-highlight {
        font-size: 1.8rem !important;
      }
      .image-wrapper {
        height: 400px;
        order: -1; 
      }
      .intro-meta-pill {
        display: none; 
      }
      .image-montage-container {
        height: 400px !important;
        order: -1;
      }
      .bundle-box {
        margin-top: 2rem;
      }
 
      .mobile-static-note {
        position: static !important;
        margin-bottom: 2rem;
      }
    }
  </style>

<body>

