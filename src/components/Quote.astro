---
// src/components/Quote.astro
interface Props {
  introText?: string;
  healingText?: string;
  quote?: string;
  author?: string;
}

const { 
  introText = "shed limiting beliefs", 
  healingText = "learn to heal",
  quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.", 
  author = "Lorem Ipsum, 2026" 
} = Astro.props;
---

<section class="statement-section" id="section-two">
  <canvas id="dandelion-canvas"></canvas>

  <div class="animation-stage">
    <h2 class="intro-text">{introText}</h2>
    
    <h2 class="healing-text">{healingText}</h2>
  </div>

  <div class="statement-container final-quote-stage">
    <h2>"{quote}"</h2>
    <div class="decorative-line"></div>
    <span class="statement-author">{author}</span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);


  function initDandelionBackground() {
    const canvas = document.getElementById('dandelion-canvas') as HTMLCanvasElement | null;
    const section = document.getElementById('section-two');
    if (!canvas || !section) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let particles: Particle[] = [];
    const mouse = { x: -1000, y: -1000, radius: 120 };

    function resize() {
      if (!canvas || !section) return;
      canvas.width = section.offsetWidth;
      canvas.height = section.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

   
    section.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = section.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    section.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    
    
    const computedWhite = getComputedStyle(document.documentElement).getPropertyValue('--white').trim() || '#ffffff';

    class Particle {
      x!: number;
      y!: number;
      baseX!: number;
      baseY!: number;
      size!: number;
      speedX!: number;
      speedY!: number;
      angle!: number;
      spin!: number;
      opacity!: number;

      constructor() {
        this.reset();
        
        if (canvas) this.y = Math.random() * canvas.height;
      }

      reset() {
        if (!canvas) return;
        this.x = Math.random() * canvas.width;
        this.y = canvas.height + Math.random() * 20; 
        this.size = Math.random() * 1.5 + 0.8; 
        this.speedX = Math.random() * 0.4 - 0.2; 
        this.speedY = -(Math.random() * 0.6 + 0.3); 
        this.angle = Math.random() * Math.PI * 2;
        this.spin = Math.random() * 0.01 - 0.005;
        this.opacity = Math.random() * 0.3 + 0.15; 
      }

      update() {
        this.x += this.speedX;
        this.y += this.speedY;
        this.angle += this.spin;

      
        const dx = mouse.x - this.x;
        const dy = mouse.y - this.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < mouse.radius) {
          const force = (mouse.radius - distance) / mouse.radius;
          
          this.x -= (dx / distance) * force * 2;
          this.y -= (dy / distance) * force * 2;
        }

        if (this.y < -20 || (canvas && this.x < -20) || (canvas && this.x > canvas.width + 20)) {
          this.reset();
        }
      }

      draw() {
        if (!ctx) return;
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.angle);
        ctx.beginPath();
        
        
        ctx.moveTo(0, 0);
        ctx.lineTo(0, this.size * 6);
        
        ctx.strokeStyle = computedWhite;
        ctx.globalAlpha = this.opacity;
        ctx.lineWidth = 0.5;
        ctx.stroke();
        ctx.restore();
      }
    }

   
    particles = [];
    const particleCount = 240; 
    for (let i = 0; i < particleCount; i++) {
      particles.push(new Particle());
    }

    function animate() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      particles.forEach(p => {
        p.update();
        p.draw();
      });
      
      requestAnimationFrame(animate);
    }
    animate();
  }


  function initSectionTwoAnimation() {
    const triggerElement = document.querySelector('#section-two');
    if (!triggerElement) return;

    gsap.set('.healing-text', { display: 'none', opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerElement,
        start: 'top 50%',
        toggleActions: 'play none none none',
      }
    });

    tl.to('.intro-text', {
      opacity: 1,
      filter: 'blur(0px)',
      scale: 1,
      duration: 1.4,
      ease: 'power2.out'
    })
    .to('.intro-text', {
      opacity: 0,
      filter: 'blur(30px)',
      scale: 1.1,
      duration: 1.2,
      ease: 'power2.in',
      delay: 1.2
    })
    .set('.intro-text', { display: 'none' })
    
  
    .set('.healing-text', { display: 'block' })
    .to('.healing-text', {
      opacity: 1,
      filter: 'blur(0px)',
      scale: 1,
      duration: 1.4,
      ease: 'power2.out'
    })
    .to('.healing-text', {
      opacity: 0,
      filter: 'blur(30px)',
      scale: 1.1,
      duration: 1.2,
      ease: 'power2.in',
      delay: 1.2
    })
    .set('.animation-stage', { display: 'none' })
    
    
    .set('.final-quote-stage', { display: 'flex' })
    .to('.final-quote-stage', {
      opacity: 1,
      duration: 0.8
    })
    .from('.final-quote-stage h2', {
      y: 25,
      opacity: 0,
      filter: 'blur(6px)',
      duration: 1.4,
      ease: 'power3.out'
    }, '-=0.4')
    .from('.decorative-line', {
      scaleX: 0,
      duration: 1,
      ease: 'power2.out'
    }, '-=0.8')
    .from('.statement-author', {
      y: 15,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out'
    }, '-=0.6');
  }

  initDandelionBackground();
  initSectionTwoAnimation();
  
  document.addEventListener('astro:page-load', () => {
    initDandelionBackground();
    initSectionTwoAnimation();
  });
</script>

<style>
  .statement-section {
    background-color: var(--burgundy);
    padding: 8rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    min-height: 95vh;
    position: relative;
    overflow: hidden;
  }

 
  #dandelion-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none; 
    z-index: 1;
  }

  .animation-stage, 
  .final-quote-stage {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .intro-text,
  .healing-text {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 300;
    letter-spacing: 1px;
    opacity: 0;
    filter: blur(20px);
    transform: scale(0.95);
    text-align: center;
  }

  .healing-text {
    color: var(--coral);
    font-style: italic;
  }

  .final-quote-stage {
    opacity: 0;
    display: none;
  }

  .final-quote-stage h2 {
    color: var(--white);
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.5px;
    text-align: center;
  }

  .decorative-line {
    width: 60px;
    height: 1px;
    background-color: var(--coral);
    margin: 2.5rem auto;
  }

  .statement-author {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--coral);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .intro-text, .healing-text { font-size: 2.5rem; }
    .final-quote-stage h2 { font-size: 1.65rem; }
  }
</style>
