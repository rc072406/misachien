---
// src/components/Quote.astro
interface Props {
  introText?: string;
  healingText?: string;
  quote?: string;
  author?: string;
}

const { 
  introText = "shed limiting beliefs", 
  healingText = "learn to heal",
  quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.", 
  author = "Lorem Ipsum, 2026" 
} = Astro.props;
---

<section class="statement-section" id="section-two">
  <canvas id="dandelion-canvas"></canvas>

  <div class="animation-stage">
    <h2 class="intro-text">{introText}</h2>
    
    <h2 class="healing-text">{healingText}</h2>
  </div>

  <div class="statement-container final-quote-stage">
    <h2>"{quote}"</h2>
    <div class="decorative-line"></div>
    <span class="statement-author">{author}</span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  class FloatingPetal {
    x: number;
    y: number;
    vx: number;
    vy: number;
    angle: number;
    spin: number;
    length: number;
    isChased: boolean; 

    constructor(canvasWidth: number, canvasHeight: number, isInitial = false) {
      this.x = Math.random() * canvasWidth;
      this.y = isInitial ? Math.random() * canvasHeight : canvasHeight + 20;
      this.vx = (Math.random() - 0.5) * 1.5;
      this.vy = -(Math.random() * 0.8 + 0.4); 
      this.angle = Math.random() * Math.PI * 2;
      this.spin = (Math.random() - 0.5) * 0.05;
      this.length = 6; 
      this.isChased = false;
    }

    update(mouse: { x: number; y: number }) {
      const globalBreeze = Math.sin(Date.now() * 0.001) * 0.5;
      
      this.x += this.vx + 1.2 + globalBreeze; 
      this.y += this.vy;
      this.angle += this.spin;
      
      this.vy += Math.sin(Date.now() * 0.002) * 0.01;

      const dx = mouse.x - this.x;
      const dy = mouse.y - this.y;
      const distance = Math.sqrt(dx * dx + dy * dy);
      const interactionRadius = 80;

      if (distance < interactionRadius) {
        this.isChased = true; 
        const force = (interactionRadius - distance) / interactionRadius;
        this.x -= (dx / distance) * force * 3;
        this.y -= (dy / distance) * force * 3;
      }
    }

    draw(ctx: CanvasRenderingContext2D, strokeColor: string) {
      ctx.beginPath();
      ctx.moveTo(this.x, this.y);
      ctx.lineTo(
        this.x + Math.cos(this.angle) * this.length, 
        this.y + Math.sin(this.angle) * this.length
      );
      ctx.strokeStyle = strokeColor;
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }

  class YellowDandelion {
    x: number;
    stemHeight: number;
    offset: number;

    constructor(x: number) {
      this.x = x;
      this.stemHeight = 25 + Math.random() * 80;
      this.offset = Math.random() * 100;
    }

    draw(ctx: CanvasRenderingContext2D, canvasHeight: number) {
      const groundY = canvasHeight;
      const wind = Math.sin(Date.now() * 0.0015 + this.offset) * 8;
      const headX = this.x + wind;
      const headY = groundY - this.stemHeight;
      
      ctx.beginPath();
      ctx.moveTo(this.x, groundY + 5);
      ctx.quadraticCurveTo(this.x, groundY - this.stemHeight / 2, headX, headY);
      ctx.strokeStyle = 'rgba(90, 120, 70, 0.4)';
      ctx.lineWidth = 2;
      ctx.stroke();
      
      ctx.fillStyle = '#FFD700';
      for(let i = 0; i < 8; i++) {
        ctx.beginPath();
        ctx.ellipse(headX, headY, 8, 3, (i * Math.PI / 4), 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.beginPath();
      ctx.arc(headX, headY, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#FFA500';
      ctx.fill();
    }
  }

 
  class WhiteDandelion {
    x: number;
    stemHeight: number;
    offset: number;
    localSeeds: { angle: number; distance: number; isFloating: boolean }[];

    constructor(x: number) {
      this.x = x;
      this.stemHeight = 35 + Math.random() * 70;
      this.offset = Math.random() * 100;
      this.localSeeds = [];
      this.generateSeeds();
    }

    generateSeeds() {
      this.localSeeds = [];
    
      for (let i = 0; i < 24; i++) {
        this.localSeeds.push({
          angle: (i * Math.PI / 12) + Math.random() * 0.2,
          distance: 10 + Math.random() * 8,
          isFloating: false
        });
      }
    }

    updateAndDraw(ctx: CanvasRenderingContext2D, canvasHeight: number, mouse: { x: number; y: number }, onSeedDetached: (x: number, y: number) => void) {
      const groundY = canvasHeight;
      const wind = Math.sin(Date.now() * 0.0015 + this.offset) * 8;
      const headX = this.x + wind;
      const headY = groundY - this.stemHeight;

     
      ctx.beginPath();
      ctx.moveTo(this.x, groundY + 5);
      ctx.quadraticCurveTo(this.x, groundY - this.stemHeight / 2, headX, headY);
      ctx.strokeStyle = 'rgba(90, 120, 70, 0.35)';
      ctx.lineWidth = 1.5;
      ctx.stroke();

    
      ctx.beginPath();
      ctx.arc(headX, headY, 4, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(110, 140, 90, 0.6)';
      ctx.fill();

   
      this.localSeeds.forEach(seed => {
        if (seed.isFloating) return;

        const seedX = headX + Math.cos(seed.angle) * seed.distance;
        const seedY = headY + Math.sin(seed.angle) * seed.distance;

      
        const dx = mouse.x - seedX;
        const dy = mouse.y - seedY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < 55) {
          seed.isFloating = true;
         
          onSeedDetached(seedX, seedY);
        } else {
          
          ctx.beginPath();
          ctx.moveTo(headX, headY);
          ctx.lineTo(seedX, seedY);
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
          ctx.lineWidth = 0.7;
          ctx.stroke();

          // Render soft fluffy tip
          ctx.beginPath();
          ctx.arc(seedX, seedY, 1.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
          ctx.fill();
        }
      });
    }
  }

  class RainDrop {
    x: number;
    y: number;
    speedY: number;
    length: number;

    constructor(canvasWidth: number) {
      this.x = Math.random() * canvasWidth;
      this.y = Math.random() * -100;
      this.speedY = Math.random() * 5 + 8;
      this.length = Math.random() * 15 + 10;
    }

    update(canvasHeight: number, canvasWidth: number) {
      this.y += this.speedY;
      if (this.y > canvasHeight) {
        this.y = Math.random() * -20;
        this.x = Math.random() * canvasWidth;
      }
    }

    draw(ctx: CanvasRenderingContext2D) {
      ctx.beginPath();
      ctx.moveTo(this.x, this.y);
      ctx.lineTo(this.x, this.y + this.length);
      ctx.strokeStyle = 'rgba(174, 219, 240, 0.4)';
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }

  function initPetalBackground() {
    const canvas = document.getElementById('dandelion-canvas') as HTMLCanvasElement | null;
    const section = document.getElementById('section-two');
    if (!canvas || !section) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let petals: FloatingPetal[] = [];
    let yellowFlowers: YellowDandelion[] = [];
    let whiteFlowers: WhiteDandelion[] = [];
    let raindrops: RainDrop[] = [];
    
    let isRaining = false;
    const mouse = { x: -1000, y: -1000 };
    const petalCount = 240; 

    function resize() {
      if (!canvas || !section) return;
      canvas.width = section.offsetWidth;
      canvas.height = section.offsetHeight;
      
      petals = [];
      for (let i = 0; i < petalCount; i++) {
        petals.push(new FloatingPetal(canvas.width, canvas.height, true));
      }

      yellowFlowers = [];
      const yellowDensity = Math.floor(canvas.width / 35);
      for (let i = 0; i < yellowDensity; i++) {
        yellowFlowers.push(new YellowDandelion(Math.random() * canvas.width));
      }

      whiteFlowers = [];
      const whiteDensity = Math.floor(canvas.width / 30);
      for (let i = 0; i < whiteDensity; i++) {
        whiteFlowers.push(new WhiteDandelion(Math.random() * canvas.width));
      }
    }
    
    resize();
    window.addEventListener('resize', resize);

    section.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = section.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    section.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    const computedWhite = getComputedStyle(document.documentElement).getPropertyValue('--white').trim() || 'rgba(255, 255, 255, 0.7)';

    function checkRegrowth() {
      if (isRaining) return;

      const untouchedPetals = petals.filter(p => !p.isChased).length;

      if (untouchedPetals <= (petalCount * 0.7) && petals.length > 0) {
        isRaining = true;
        raindrops = [];
        for (let i = 0; i < 120; i++) {
          raindrops.push(new RainDrop(canvas!.width));
        }

        setTimeout(() => {
          isRaining = false;
          raindrops = [];
          
        
          petals.forEach(p => {
            p.isChased = false; 
          });

        
          whiteFlowers.forEach(w => {
            w.generateSeeds();
          });
        }, 7000);
      }
    }

    function animate() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      
      yellowFlowers.forEach(flower => {
        flower.draw(ctx, canvas.height);
      });

      
      whiteFlowers.forEach(flower => {
        flower.updateAndDraw(ctx, canvas.height, mouse, (seedX, seedY) => {
          const detachedPetal = new FloatingPetal(canvas.width, canvas.height, false);
          detachedPetal.x = seedX;
          detachedPetal.y = seedY;
          detachedPetal.isChased = true; 
          petals.push(detachedPetal);
        });
      });

      if (isRaining) {
        raindrops.forEach(drop => {
          drop.update(canvas.height, canvas.width);
          drop.draw(ctx);
        });
      }

  
      petals.forEach((petal, index) => {
        petal.update(mouse);
        petal.draw(ctx, computedWhite);

        if (petal.y < -20 || petal.x > canvas.width + 20 || petal.x < -20) {
          // If it was a dynamically generated extra petal, drop it to optimize memory
          if (index >= petalCount) {
            petals.splice(index, 1);
          } else {
            Object.assign(petal, new FloatingPetal(canvas.width, canvas.height, false));
          }
        }
      });
      
      checkRegrowth();
      requestAnimationFrame(animate);
    }
    animate();
  }

  function initSectionTwoAnimation() {
    const triggerElement = document.querySelector('#section-two');
    if (!triggerElement) return;

    gsap.set('.healing-text', { display: 'none', opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerElement,
        start: 'top 50%',
        toggleActions: 'play none none none',
      }
    });

    tl.to('.intro-text', {
      opacity: 1,
      filter: 'blur(0px)',
      scale: 1,
      duration: 1.4,
      ease: 'power2.out'
    })
    .to('.intro-text', {
      opacity: 0,
      filter: 'blur(30px)',
      scale: 1.1,
      duration: 1.2,
      ease: 'power2.in',
      delay: 1.2
    })
    .set('.intro-text', { display: 'none' })
    .set('.healing-text', { display: 'block' })
    .to('.healing-text', {
      opacity: 1,
      filter: 'blur(0px)',
      scale: 1,
      duration: 1.4,
      ease: 'power2.out'
    })
    .to('.healing-text', {
      opacity: 0,
      filter: 'blur(30px)',
      scale: 1.1,
      duration: 1.2,
      ease: 'power2.in',
      delay: 1.2
    })
    .set('.animation-stage', { display: 'none' })
    .set('.final-quote-stage', { display: 'flex' })
    .to('.final-quote-stage', {
      opacity: 1,
      duration: 0.8
    })
    .from('.final-quote-stage h2', {
      y: 25,
      opacity: 0,
      filter: 'blur(6px)',
      duration: 1.4,
      ease: 'power3.out'
    }, '-=0.4')
    .from('.decorative-line', {
      scaleX: 0,
      duration: 1,
      ease: 'power2.out'
    }, '-=0.8')
    .from('.statement-author', {
      y: 15,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out'
    }, '-=0.6');
  }

  initPetalBackground();
  initSectionTwoAnimation();
  
  document.addEventListener('astro:page-load', () => {
    initPetalBackground();
    initSectionTwoAnimation();
  });
</script>

<style>
  .statement-section {
    background-color: var(--burgundy);
    padding: 8rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    min-height: 95vh;
    position: relative;
    overflow: hidden;
  }

  #dandelion-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none; 
    z-index: 1;
  }

  .animation-stage, 
  .final-quote-stage {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .intro-text,
  .healing-text {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 300;
    letter-spacing: 1px;
    opacity: 0;
    filter: blur(20px);
    transform: scale(0.95);
    text-align: center;
  }

  .healing-text {
    color: var(--coral);
    font-style: italic;
  }

  .final-quote-stage {
    opacity: 0;
    display: none;
  }

  .final-quote-stage h2 {
    color: var(--white);
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.5px;
    text-align: center;
  }

  .decorative-line {
    width: 60px;
    height: 1px;
    background-color: var(--coral);
    margin: 2.5rem auto;
  }

  .statement-author {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--coral);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .intro-text, .healing-text { font-size: 2.5rem; }
    .final-quote-stage h2 { font-size: 1.65rem; }
  }
</style>
