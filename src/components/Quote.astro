---
interface Props {
  introText?: string;
  healingText?: string;
  quote?: string;
  author?: string;
}

const { 
  introText = "shed limiting beliefs", 
  healingText = "learn to heal",
  quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.", 
  author = "Lorem Ipsum, 2026" 
} = Astro.props;
---

<section class="statement-section" id="section-two">
  <div class="ambient-glow"></div>

  <div class="stage-container intro-stage">
    <h2 class="premium-text intro-text">{introText}</h2>
  </div>

  <div class="stage-container healing-stage">
    <h2 class="premium-text healing-text">{healingText}</h2>
  </div>

  <div class="stage-container final-quote-stage">
    <h2 class="quote-text">"{quote}"</h2>
    <div class="decorative-line"></div>
    <span class="statement-author">{author}</span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initSectionTwoAnimation() {
    const triggerElement = document.querySelector('#section-two');
    if (!triggerElement) return;

  
    gsap.set('.intro-stage', { display: 'flex', opacity: 1 });
    gsap.set('.healing-stage, .final-quote-stage', { display: 'none', opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerElement,
        start: 'top 40%',
        toggleActions: 'play none none none',
      }
    });

  
    tl.to('.intro-text', {
      opacity: 1,
      filter: 'blur(0px)',
      y: 0,
      duration: 1.6,
      ease: 'power3.out'
    })
   
    .to('.intro-text', {
      opacity: 0,
      filter: 'blur(20px)',
      y: -20,
      duration: 1.2,
      ease: 'power3.in',
      delay: 1.5
    })
    .set('.intro-stage', { display: 'none' })
    
   
    .set('.healing-stage', { display: 'flex' })
   
    .to('.healing-text', {
      opacity: 1,
      filter: 'blur(0px)',
      y: 0,
      duration: 1.6,
      ease: 'power3.out'
    })

    .to('.healing-text', {
      opacity: 0,
      filter: 'blur(20px)',
      y: -20,
      duration: 1.2,
      ease: 'power3.in',
      delay: 1.5
    })
    .set('.healing-stage', { display: 'none' })

  
    .set('.final-quote-stage', { display: 'flex' })
    .to('.final-quote-stage', {
      opacity: 1,
      duration: 0.8
    })
    .from('.final-quote-stage h2', {
      y: 30,
      opacity: 0,
      filter: 'blur(10px)',
      duration: 1.8,
      ease: 'power4.out'
    }, '-=0.4')
    .from('.decorative-line', {
      scaleX: 0,
      duration: 1.4,
      ease: 'power3.inOut'
    }, '-=1.0')
    .from('.statement-author', {
      y: 15,
      opacity: 0,
      duration: 1,
      ease: 'power2.out'
    }, '-=0.6');
  }

  initSectionTwoAnimation();
  document.addEventListener('astro:page-load', initSectionTwoAnimation);
</script>

<style>
  :root {

    --line-color: #107270;
    --main-color: #0b1a29;
    --g-color: #159faa;
    

    --accent-bright: #23f0ff; 
    
    --font-display: var(--font-display, serif);
    --font-sans: system-ui, sans-serif;
  }

  .statement-section {
    background-color: var(--main-color);
    padding: 8rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }


  .ambient-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(7, 144, 151, 0.08) 0%, rgba(11, 26, 41, 0) 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  .stage-container {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }


  .premium-text {
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 300;
    letter-spacing: 1px;
    text-align: center;
    opacity: 0;
    filter: blur(15px);
    transform: translateY(20px);
  }


  .healing-text {
    background: linear-gradient(to right, #ffffff, var(--accent-bright));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: italic;
  }


  .quote-text {
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1.6;
    letter-spacing: 0.5px;
    text-align: center;
    max-width: 750px;
  }

 
  .decorative-line {
    width: 60px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--accent-bright), transparent);
    margin: 3rem auto;
    transform-origin: center;
  }

  .statement-author {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-bright);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .premium-text { font-size: 2.75rem; }
    .quote-text { font-size: 1.85rem; }
    .statement-section { padding: 4rem 1.5rem; }
  }
</style>
