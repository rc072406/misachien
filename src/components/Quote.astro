---
interface Props {
  introText?: string;
  quote?: string;
  author?: string;
}

const { 
  introText = "shed limiting beliefs", 
  quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.", 
  author = "Lorem Ipsum, 2026" 
} = Astro.props;
---

<section class="statement-section" id="section-two" data-intro={introText}>
  <div class="animation-stage">
    <div class="canvas-container">
      <canvas id="particleCanvas"></canvas>
    </div>
  </div>

  <div class="statement-container final-quote-stage">
    <h2>"{quote}"</h2>
    <div class="decorative-line"></div>
    <span class="statement-author">{author}</span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  class Petal {
    x: number;
    y: number;
    originX: number;
    originY: number;
    isSecondText: boolean;
    length: number;
    width: number;
    opacity: number;
    maxOpacity: number;
    fadeSpeed: number;
    wobbleSpeed: number;
    wobbleCount: number;
    angle: number;
    rotationSpeed: number;
    speedX: number;
    speedY: number;

    constructor(x: number, y: number, isSecondText: boolean) {
      this.x = x;
      this.y = y;
      this.originX = x;
      this.originY = y;
      this.isSecondText = isSecondText;
      
      this.length = Math.random() * 5 + 4;
      this.width = Math.random() * 1.5 + 0.8;
      this.maxOpacity = Math.random() * 0.4 + 0.6;
      this.opacity = isSecondText ? 0 : this.maxOpacity;
      
      this.speedY = Math.random() * -1.5 - 0.5;
      this.speedX = Math.random() * 1.5 + 0.5;
      this.fadeSpeed = Math.random() * 0.005 + 0.003;
      this.wobbleSpeed = Math.random() * 0.04 + 0.01;
      this.wobbleCount = Math.random() * Math.PI * 2;
      this.angle = (Math.random() - 0.5) * 0.5;
      this.rotationSpeed = (Math.random() - 0.5) * 0.05;
    }

    update(timelineProgress: number) {
      if (!this.isSecondText) {
        if (timelineProgress > 1.0) {
          const factor = timelineProgress - 1.0;
          this.wobbleCount += this.wobbleSpeed;
          this.x += (this.speedX + Math.sin(this.wobbleCount) * 0.8) * factor;
          this.y += this.speedY * factor;
          this.angle += this.rotationSpeed * factor;
          this.opacity -= this.fadeSpeed * factor;
        }
      } else {
        if (timelineProgress > 2.0 && timelineProgress <= 3.0) {
          this.x = this.originX + (Math.random() - 0.5) * 0.2;
          this.y = this.originY + (Math.random() - 0.5) * 0.2;
          if (this.opacity < this.maxOpacity) this.opacity += 0.05;
        } else if (timelineProgress > 3.0) {
          const factor = timelineProgress - 3.0;
          this.wobbleCount += this.wobbleSpeed;
          this.x += (this.speedX + Math.sin(this.wobbleCount) * 1.0) * factor;
          this.y += this.speedY * factor;
          this.angle += this.rotationSpeed * factor;
          this.opacity -= this.fadeSpeed * factor;
        }
      }
    }

    draw(ctx: CanvasRenderingContext2D) {
      if (this.opacity <= 0) return;
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate(this.angle);
      
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(this.width, -this.length / 2, 0, -this.length);
      ctx.quadraticCurveTo(-this.width, -this.length / 2, 0, 0);
      
      ctx.fillStyle = !this.isSecondText 
        ? `rgba(245, 245, 240, ${this.opacity})` 
        : `rgba(231, 120, 96, ${this.opacity})`;
        
      ctx.fill();
      ctx.restore();
    }
  }

  function initSectionTwoAnimation() {
    const triggerElement = document.querySelector('#section-two') as HTMLElement;
    const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement;
    if (!triggerElement || !canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animState = { timelineProgress: 0.0 };
    let text1 = triggerElement.getAttribute('data-intro') || "shed limiting beliefs";
    let text2 = "Learn to Heal";
    let p1: Petal[] = [];
    let p2: Petal[] = [];

    function scanText(text: string, isSecond: boolean) {
      if (!ctx || !canvas) return [];
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      let fontSize = canvas.width > 768 ? 54 : 34;
      ctx.font = `300 ${fontSize}px serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(text, canvas.width / 2, canvas.height / 2);

      const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const gap = canvas.width > 768 ? 6 : 4;
      const scanned: Petal[] = [];

      for (let y = 0; y < canvas.height; y += gap) {
        for (let x = 0; x < canvas.width; x += gap) {
          if (data[(y * canvas.width + x) * 4 + 3] > 128) {
            scanned.push(new Petal(x, y, isSecond));
          }
        }
      }
      return scanned;
    }

    function resizeCanvas() {
      const container = canvas.parentElement;
      if (!container) return;
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
      p1 = scanText(text1, false);
      p2 = scanText(text2, true);
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    let animationFrameId: number;
    function render() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const prog = animState.timelineProgress;

      if (prog <= 2.0) {
        p1.forEach(p => { p.update(prog); p.draw(ctx); });
      }
      if (prog >= 2.0) {
        p2.forEach(p => { p.update(prog); p.draw(ctx); });
      }

      animationFrameId = requestAnimationFrame(render);
    }
    render();

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerElement,
        start: 'top 40%',
        toggleActions: 'play none none none',
      }
    });

    tl.to(animState, {
      timelineProgress: 4.0,
      duration: 8.0,
      ease: 'none'
    })
    .to('.animation-stage', {
      opacity: 0,
      duration: 0.6,
      onComplete: () => {
        cancelAnimationFrame(animationFrameId);
        gsap.set('.animation-stage', { display: 'none' });
      }
    }, '-=0.6')
    .set('.final-quote-stage', { display: 'flex' })
    .to('.final-quote-stage', { opacity: 1, duration: 0.8 })
    .from('.final-quote-stage h2', { y: 25, opacity: 0, filter: 'blur(6px)', duration: 1.4, ease: 'power3.out' }, '-=0.4')
    .from('.decorative-line', { scaleX: 0, duration: 1, ease: 'power2.out' }, '-=0.8')
    .from('.statement-author', { y: 15, opacity: 0, duration: 0.8, ease: 'power2.out' }, '-=0.6');
  }

  initSectionTwoAnimation();
  document.addEventListener('astro:page-load', initSectionTwoAnimation);
</script>

<style>
  .statement-section {
    background-color: var(--burgundy, #2b0c15);
    padding: 8rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    min-height: 95vh;
    position: relative;
    overflow: hidden;
  }

  .animation-stage, 
  .final-quote-stage {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .canvas-container {
    width: 100%;
    height: 450px;
    position: relative;
    pointer-events: none;
  }

  #particleCanvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .final-quote-stage {
    opacity: 0;
    display: none;
  }

  .final-quote-stage h2 {
    color: var(--white, #ffffff);
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.5px;
    text-align: center;
  }

  .decorative-line {
    width: 60px;
    height: 1px;
    background-color: var(--coral, #e77860);
    margin: 2.5rem auto;
  }

  .statement-author {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--coral, #e77860);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .final-quote-stage h2 { font-size: 1.65rem; }
    .canvas-container { height: 350px; }
  }
</style>
