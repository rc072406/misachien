---
interface Props {
  introText?: string;
  quote?: string;
  author?: string;
}

const { 
  introText = "shed limiting beliefs", 
  quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.", 
  author = "Lorem Ipsum, 2026" 
} = Astro.props;
---

<section class="statement-section" id="section-two">
  <div class="animation-stage">
    <h2 class="intro-text">{introText}</h2>
    
    <div class="flowers-container not-loaded">
      <div class="flowers">
        <div class="flower flower--1">
          <div class="flower__leafs flower__leafs--1">
            <div class="flower__leaf flower__leaf--1"></div>
            <div class="flower__leaf flower__leaf--2"></div>
            <div class="flower__leaf flower__leaf--3"></div>
            <div class="flower__leaf flower__leaf--4"></div>
            <div class="flower__white-circle"></div>
            <div class="flower__light flower__light--1"></div>
            <div class="flower__light flower__light--2"></div>
            <div class="flower__light flower__light--3"></div>
            <div class="flower__light flower__light--4"></div>
            <div class="flower__light flower__light--5"></div>
            <div class="flower__light flower__light--6"></div>
            <div class="flower__light flower__light--7"></div>
            <div class="flower__light flower__light--8"></div>
          </div>
          <div class="flower__line">
            <div class="flower__line__leaf flower__line__leaf--1"></div>
            <div class="flower__line__leaf flower__line__leaf--2"></div>
            <div class="flower__line__leaf flower__line__leaf--3"></div>
            <div class="flower__line__leaf flower__line__leaf--4"></div>
            <div class="flower__line__leaf flower__line__leaf--5"></div>
            <div class="flower__line__leaf flower__line__leaf--6"></div>
          </div>
        </div>

        <div class="flower flower--2">
          <div class="flower__leafs flower__leafs--2">
            <div class="flower__leaf flower__leaf--1"></div>
            <div class="flower__leaf flower__leaf--2"></div>
            <div class="flower__leaf flower__leaf--3"></div>
            <div class="flower__leaf flower__leaf--4"></div>
            <div class="flower__white-circle"></div>
            <div class="flower__light flower__light--1"></div>
            <div class="flower__light flower__light--2"></div>
            <div class="flower__light flower__light--3"></div>
            <div class="flower__light flower__light--4"></div>
            <div class="flower__light flower__light--5"></div>
            <div class="flower__light flower__light--6"></div>
            <div class="flower__light flower__light--7"></div>
            <div class="flower__light flower__light--8"></div>
          </div>
          <div class="flower__line">
            <div class="flower__line__leaf flower__line__leaf--1"></div>
            <div class="flower__line__leaf flower__line__leaf--2"></div>
            <div class="flower__line__leaf flower__line__leaf--3"></div>
            <div class="flower__line__leaf flower__line__leaf--4"></div>
          </div>
        </div>

        <div class="flower flower--3">
          <div class="flower__leafs flower__leafs--3">
            <div class="flower__leaf flower__leaf--1"></div>
            <div class="flower__leaf flower__leaf--2"></div>
            <div class="flower__leaf flower__leaf--3"></div>
            <div class="flower__leaf flower__leaf--4"></div>
            <div class="flower__white-circle"></div>
            <div class="flower__light flower__light--1"></div>
            <div class="flower__light flower__light--2"></div>
            <div class="flower__light flower__light--3"></div>
            <div class="flower__light flower__light--4"></div>
            <div class="flower__light flower__light--5"></div>
            <div class="flower__light flower__light--6"></div>
            <div class="flower__light flower__light--7"></div>
            <div class="flower__light flower__light--8"></div>
          </div>
          <div class="flower__line">
            <div class="flower__line__leaf flower__line__leaf--1"></div>
            <div class="flower__line__leaf flower__line__leaf--2"></div>
            <div class="flower__line__leaf flower__line__leaf--3"></div>
            <div class="flower__line__leaf flower__line__leaf--4"></div>
          </div>
        </div>

        <div class="grow-ans" style="--d:1.2s">
          <div class="flower__g-long">
            <div class="flower__g-long__top"></div>
            <div class="flower__g-long__bottom"></div>
          </div>
        </div>

        <div class="growing-grass">
          <div class="flower__grass flower__grass--1">
            <div class="flower__grass--top"></div>
            <div class="flower__grass--bottom"></div>
            <div class="flower__grass__leaf flower__grass__leaf--1"></div>
            <div class="flower__grass__leaf flower__grass__leaf--2"></div>
            <div class="flower__grass__leaf flower__grass__leaf--3"></div>
            <div class="flower__grass__leaf flower__grass__leaf--4"></div>
            <div class="flower__grass__leaf flower__grass__leaf--5"></div>
            <div class="flower__grass__leaf flower__grass__leaf--6"></div>
            <div class="flower__grass__leaf flower__grass__leaf--7"></div>
            <div class="flower__grass__leaf flower__grass__leaf--8"></div>
            <div class="flower__grass__overlay"></div>
          </div>
        </div>

        <div class="growing-grass">
          <div class="flower__grass flower__grass--2">
            <div class="flower__grass--top"></div>
            <div class="flower__grass--bottom"></div>
            <div class="flower__grass__leaf flower__grass__leaf--1"></div>
            <div class="flower__grass__leaf flower__grass__leaf--2"></div>
            <div class="flower__grass__leaf flower__grass__leaf--3"></div>
            <div class="flower__grass__leaf flower__grass__leaf--4"></div>
            <div class="flower__grass__leaf flower__grass__leaf--5"></div>
            <div class="flower__grass__leaf flower__grass__leaf--6"></div>
            <div class="flower__grass__leaf flower__grass__leaf--7"></div>
            <div class="flower__grass__leaf flower__grass__leaf--8"></div>
            <div class="flower__grass__overlay"></div>
          </div>
        </div>

        <div class="grow-ans" style="--d:2.4s"><div class="flower__g-right flower__g-right--1"><div class="leaf"></div></div></div>
        <div class="grow-ans" style="--d:2.8s"><div class="flower__g-right flower__g-right--2"><div class="leaf"></div></div></div>

        <div class="grow-ans" style="--d:2.8s">
          <div class="flower__g-front">
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--1"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--2"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--3"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--4"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--5"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--6"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--7"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__leaf-wrapper flower__g-front__leaf-wrapper--8"><div class="flower__g-front__leaf"></div></div>
            <div class="flower__g-front__line"></div>
          </div>
        </div>

        <div class="grow-ans" style="--d:3.2s">
          <div class="flower__g-fr">
            <div class="leaf"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--1"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--2"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--3"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--4"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--5"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--6"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--7"></div>
            <div class="flower__g-fr__leaf flower__g-fr__leaf--8"></div>
          </div>
        </div>

        <div class="long-g long-g--0">
          <div class="grow-ans" style="--d:3s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:2.2s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:3.4s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:3.6s"><div class="leaf leaf--3"></div></div>
        </div>
        <div class="long-g long-g--1">
          <div class="grow-ans" style="--d:3.6s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:3.8s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:4s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:4.2s"><div class="leaf leaf--3"></div></div>
        </div>
        <div class="long-g long-g--2">
          <div class="grow-ans" style="--d:4s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:4.2s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:4.4s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:4.6s"><div class="leaf leaf--3"></div></div>
        </div>
        <div class="long-g long-g--3">
          <div class="grow-ans" style="--d:4s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:4.2s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:3s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:3.6s"><div class="leaf leaf--3"></div></div>
        </div>
        <div class="long-g long-g--4">
          <div class="grow-ans" style="--d:4s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:4.2s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:3s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:3.6s"><div class="leaf leaf--3"></div></div>
        </div>
        <div class="long-g long-g--5">
          <div class="grow-ans" style="--d:4s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:4.2s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:3s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:3.6s"><div class="leaf leaf--3"></div></div>
        </div>
        <div class="long-g long-g--6">
          <div class="grow-ans" style="--d:4.2s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:4.4s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:4.6s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:4.8s"><div class="leaf leaf--3"></div></div>
        </div>
        <div class="long-g long-g--7">
          <div class="grow-ans" style="--d:3s"><div class="leaf leaf--0"></div></div>
          <div class="grow-ans" style="--d:3.2s"><div class="leaf leaf--1"></div></div>
          <div class="grow-ans" style="--d:3.5s"><div class="leaf leaf--2"></div></div>
          <div class="grow-ans" style="--d:3.6s"><div class="leaf leaf--3"></div></div>
        </div>
      </div>
    </div>
  </div>

  <div class="statement-container final-quote-stage">
    <h2>"{quote}"</h2>
    <div class="decorative-line"></div>
    <span class="statement-author">{author}</span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initSectionTwoAnimation() {
    const triggerElement = document.querySelector('#section-two');
    const flowersWrapper = document.querySelector('.flowers-container');
    if (!triggerElement || !flowersWrapper) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerElement,
        start: 'top 50%',
        toggleActions: 'play none none none',
      }
    });

    tl.to('.intro-text', {
      opacity: 1,
      filter: 'blur(0px)',
      scale: 1,
      duration: 1.4,
      ease: 'power2.out'
    })
    .to('.intro-text', {
      opacity: 0,
      filter: 'blur(30px)',
      scale: 1.1,
      duration: 1.2,
      ease: 'power2.in',
      delay: 1.2
    })
    .set('.intro-text', { display: 'none' })
    .set('.flowers-container', { display: 'block' })
    .to('.flowers-container', {
      opacity: 1,
      scale: 1,
      duration: 0.5,
      onStart: () => {
        flowersWrapper.classList.remove('not-loaded');
      }
    })
    .to({}, { duration: 6.5 })
    .to('.flowers-container', {
      opacity: 0,
      scale: 0.95,
      duration: 1.2,
      ease: 'power2.inOut'
    })
    .set('.animation-stage', { display: 'none' })
    .set('.final-quote-stage', { display: 'flex' })
    .to('.final-quote-stage', {
      opacity: 1,
      duration: 0.8
    })
    .from('.final-quote-stage h2', {
      y: 25,
      opacity: 0,
      filter: 'blur(6px)',
      duration: 1.4,
      ease: 'power3.out'
    }, '-=0.4')
    .from('.decorative-line', {
      scaleX: 0,
      duration: 1,
      ease: 'power2.out'
    }, '-=0.8')
    .from('.statement-author', {
      y: 15,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out'
    }, '-=0.6');
  }

  initSectionTwoAnimation();
  document.addEventListener('astro:page-load', initSectionTwoAnimation);
</script>

<style>
  :root {
    --line-color: #107270;
    --main-color: #0b1a29;
    --leaf-color: #079097;
    --g-color: #159faa;
  }

  .statement-section {
    background-color: var(--main-color);
    padding: 8rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .animation-stage, 
  .final-quote-stage {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .intro-text {
    color: #fff;
    font-family: var(--font-display, serif);
    font-size: 3.5rem;
    font-weight: 300;
    letter-spacing: 1px;
    opacity: 0;
    filter: blur(20px);
    transform: scale(0.95);
    text-align: center;
  }

  .flowers-container {
    width: 100%;
    height: 60vh;
    position: relative;
    display: none;
    opacity: 0;
    transform: scale(0.9);
  }

  .flowers {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  .flower {
    position: absolute;
    bottom: 10vmin;
    transform-origin: bottom center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .flower--1 { z-index: 100; transform: scale(1); }
  .flower--2 { z-index: 99; transform: rotate(-10deg) scale(0.85) translate(-10vmin, 2vmin); }
  .flower--3 { z-index: 98; transform: rotate(10deg) scale(0.85) translate(10vmin, 2vmin); }

  .flower__line {
    width: 2vmin;
    height: 55vmin;
    background-image: linear-gradient(to top, rgba(0,0,0,0), var(--line-color), #a1e2e6);
    box-shadow: inset 0 2px 2px rgba(255,255,255,0.1);
    border-radius: 4vmin;
    transform-origin: bottom center;
    animation: grow-flower-line 4s linear forwards;
  }

  .flowers-container.not-loaded .flower__line { animation: none; }

  .flower__leafs {
    position: absolute;
    bottom: 50vmin;
    width: 30vmin;
    height: 30vmin;
    transform-origin: center bottom;
    animation: bloom-flower-leafs 1s 3.5s backwards;
  }

  .flowers-container.not-loaded .flower__leafs { animation: none; transform: scale(0); }

  .flower__leaf {
    position: absolute;
    bottom: 15vmin;
    left: 50%;
    width: 15vmin;
    height: 25vmin;
    border-radius: 51% 49% 47% 53% / 82% 82% 18% 18%;
    background-image: linear-gradient(to top, #012426, #23f0ff);
    transform-origin: bottom center;
    opacity: 0.9;
    box-shadow: inset 0 -2px 2vmin rgba(10,10,10,0.8);
  }

  .flower__leaf--1 { transform: translateX(-50%) scale(1.1); top: 1vmin; z-index: 1; }
  .flower__leaf--2 { transform: translateX(-50%) rotate(-30deg); top: 3vmin; }
  .flower__leaf--3 { transform: translateX(-50%) rotate(30deg); top: 3vmin; }
  .flower__leaf--4 { transform: translateX(-50%) rotate(60deg); top: 5vmin; }

  .flower__white-circle {
    position: absolute;
    top: 15vmin;
    left: 50%;
    transform: translateX(-50%);
    width: 9vmin;
    height: 9vmin;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 0 4vmin rgba(255,255,255,0.8);
    z-index: 10;
  }

  .flower__light {
    position: absolute;
    bottom: 15vmin;
    width: 1vmin;
    height: 1vmin;
    background-color: #fff;
    border-radius: 50%;
    filter: blur(0.2vmin);
  }

  .flower__light--1 { left: 5vmin; animation: float-lights 4s infinite linear; }
  .flower__light--2 { right: 5vmin; animation: float-lights 3.5s infinite linear; }
  .flower__light--3 { left: 10vmin; animation: float-lights 4.2s infinite linear; }
  .flower__light--4 { right: 10vmin; animation: float-lights 3.8s infinite linear; }
  .flower__light--5 { left: 2vmin; animation: float-lights 4.8s infinite linear; }
  .flower__light--6 { right: 2vmin; animation: float-lights 4.1s infinite linear; }
  .flower__light--7 { left: 8vmin; animation: float-lights 3.9s infinite linear; }
  .flower__light--8 { right: 8vmin; animation: float-lights 4.6s infinite linear; }

  .flower__line__leaf {
    position: absolute;
    width: 7vmin;
    height: 7vmin;
    border-radius: 100% 0% 0% 100% / 100% 100% 0% 0%;
    box-shadow: inset 0 2px 1vmin rgba(44, 238, 252, 0.2);
    background-image: linear-gradient(to bottom left, transparent, var(--main-color) 98%), linear-gradient(to bottom right, #23f0ff 45%, transparent 50%);
    -webkit-mask-image: linear-gradient(135deg, #159faa 40%, transparent 50%);
  }

  .flower__line__leaf--1 { top: 12vmin; left: -5vmin; transform: rotate(-20deg); }
  .flower__line__leaf--2 { top: 22vmin; right: -5vmin; transform: rotate(160deg) scaleY(-1); }
  .flower__line__leaf--3 { top: 30vmin; left: -5vmin; transform: rotate(-10deg); }
  .flower__line__leaf--4 { top: 40vmin; right: -5vmin; transform: rotate(170deg) scaleY(-1); }

  .growing-grass {
    position: absolute;
    bottom: 10vmin;
    z-index: 10;
  }

  .flower__grass {
    position: relative;
    width: 1vmin;
    animation: grow-flower-line 4s linear forwards;
    transform-origin: bottom center;
  }

  .flower__grass--1 { height: 25vmin; transform: translateX(-20vmin) rotate(-15deg); }
  .flower__grass--2 { height: 20vmin; transform: translateX(20vmin) rotate(15deg); }

  .flower__grass__leaf {
    position: absolute;
    width: 5vmin;
    height: 5vmin;
    border-radius: 100% 0% 0% 100% / 100% 100% 0% 0%;
    background-image: linear-gradient(to bottom left, transparent, var(--main-color) 98%), linear-gradient(to bottom right, #23f0ff 45%, transparent 50%);
  }

  .flower__grass__leaf--1 { top: 2vmin; left: -3vmin; transform: rotate(-25deg); }
  .flower__grass__leaf--2 { top: 6vmin; right: -3vmin; transform: rotate(155deg) scaleY(-1); }

  .grow-ans {
    animation: grow-flower-line 4s var(--d) linear both;
  }

  .flower__g-long {
    position: absolute;
    bottom: 10vmin;
    left: -15vmin;
    transform-origin: bottom center;
  }
  .flower__g-long__top {
    width: 1.5vmin;
    height: 40vmin;
    background-image: linear-gradient(to top, var(--line-color), #23f0ff);
    border-radius: 20px;
  }

  .flower__g-right {
    position: absolute;
    bottom: 6vmin;
    left: 25vmin;
    transform-origin: bottom left;
    transform: rotate(15deg);
  }
  .flower__g-right .leaf {
    width: 25vmin;
    height: 40vmin;
    border-top-left-radius: 100%;
    border-left: 1.5vmin solid var(--leaf-color);
    -webkit-mask-image: linear-gradient(to top, transparent 20%, var(--leaf-color) 60%);
  }

  .flower__g-front {
    position: absolute;
    bottom: 6vmin;
    left: -5vmin;
    transform-origin: bottom center;
    z-index: 110;
  }
  .flower__g-front__line {
    width: 1.2vmin;
    height: 25vmin;
    background-image: linear-gradient(to top, transparent, var(--line-color), #23f0ff);
  }
  .flower__g-front__leaf-wrapper {
    position: absolute;
    width: 8vmin;
    height: 8vmin;
  }
  .flower__g-front__leaf {
    width: 100%;
    height: 100%;
    border-radius: 100% 0% 0% 100% / 100% 100% 0% 0%;
    background-image: linear-gradient(to bottom left, transparent, var(--main-color)), linear-gradient(to bottom right, #159faa 50%, transparent 50%);
  }
  .flower__g-front__leaf-wrapper--1 { top: -2vmin; transform: scale(0.7); }
  .flower__g-front__leaf-wrapper--2 { top: -2vmin; transform: rotateY(-180deg) scale(0.7); }

  .flower__g-fr {
    position: absolute;
    bottom: 5vmin;
    left: 15vmin;
    transform-origin: bottom left;
    z-index: 10;
    animation: flower__g-fr-ans 3s linear infinite;
  }
  .flower__g-fr .leaf {
    width: 25vmin;
    height: 45vmin;
    border-top-left-radius: 100%;
    border-left: 1.5vmin solid var(--leaf-color);
    -webkit-mask-image: linear-gradient(to top, transparent 25%, var(--leaf-color) 50%);
  }

  .long-g {
    position: absolute;
    bottom: 10vmin;
    transform-origin: bottom left;
  }
  .long-g .leaf {
    width: 4vmin;
    height: 50vmin;
    background-image: linear-gradient(to top, var(--line-color), transparent);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .long-g--0 { left: -35vmin; transform: rotate(-20deg); }
  .long-g--1 { left: -25vmin; transform: scale(0.8) rotate(-10deg); }
  .long-g--2 { left: 25vmin; transform: scale(0.9) rotate(15deg); }
  .long-g--3 { left: 35vmin; transform: scale(0.7) rotate(25deg); }

  @keyframes grow-flower-line {
    0% { height: 0; opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes bloom-flower-leafs {
    0% { transform: scale(0); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
