---
interface Props {
  introText?: string;
  quote?: string;
  author?: string;
}

const { 
  introText = "shed limiting beliefs", 
  quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.", 
  author = "Lorem Ipsum, 2026" 
} = Astro.props;
---

<section class="statement-section" id="section-two" data-intro={introText}>
  <div class="animation-stage">
    <div class="canvas-container">
      <canvas id="particleCanvas"></canvas>
    </div>
  </div>

  <div class="statement-container final-quote-stage">
    <h2>"{quote}"</h2>
    <div class="decorative-line"></div>
    <span class="statement-author">{author}</span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  class Petal {
    x: number;
    y: number;
    originX: number;
    originY: number;
    isSecondText: boolean;
    length: number;
    width: number;
    opacity: number;
    maxOpacity: number;
    fadeSpeed: number;
    wobbleSpeed: number;
    wobbleCount: number;
    angle: number;
    rotationSpeed: number;
    speedX: number;
    speedY: number;
    hasBattered: boolean;

    constructor(x: number, y: number, isSecondText: boolean) {
      this.x = x;
      this.y = y;
      this.originX = x;
      this.originY = y;
      this.isSecondText = isSecondText;
      
      this.length = Math.random() * 7 + 5;
      this.width = Math.random() * 1.2 + 0.6;
      this.maxOpacity = Math.random() * 0.35 + 0.55;
      this.opacity = isSecondText ? 0 : this.maxOpacity;
      
      this.speedY = Math.random() * -0.9 - 0.4;
      this.speedX = Math.random() * 1.2 + 0.6;
      this.fadeSpeed = Math.random() * 0.003 + 0.002;
      this.wobbleSpeed = Math.random() * 0.02 + 0.01;
      this.wobbleCount = Math.random() * Math.PI * 2;
      this.angle = (Math.random() - 0.5) * 0.25;
      this.rotationSpeed = (Math.random() - 0.5) * 0.02;
      this.hasBattered = false;
    }

    update(timelineProgress: number) {
      if (!this.isSecondText) {
        if (timelineProgress > 1.0) {
          if (!this.hasBattered) {
            this.speedX += (Math.random() - 0.3) * 0.5;
            this.speedY += (Math.random() - 0.5) * 0.2;
            this.hasBattered = true;
          }
          const factor = (timelineProgress - 1.0) * 0.8;
          this.wobbleCount += this.wobbleSpeed;
          this.x += (this.speedX + Math.sin(this.wobbleCount) * 1.2) * factor;
          this.y += this.speedY * factor;
          this.angle += this.rotationSpeed * factor;
          this.opacity -= this.fadeSpeed * factor;
        } else {
          this.x = this.originX + Math.sin(this.wobbleCount + timelineProgress * 10) * 0.15;
          this.y = this.originY + Math.cos(this.wobbleCount + timelineProgress * 10) * 0.15;
        }
      } else {
        if (timelineProgress > 2.0 && timelineProgress <= 3.2) {
          this.x = this.originX + Math.sin(this.wobbleCount) * 0.1;
          this.y = this.originY + Math.cos(this.wobbleCount) * 0.1;
          if (this.opacity < this.maxOpacity) this.opacity += 0.02;
        } else if (timelineProgress > 3.2) {
          if (!this.hasBattered) {
            this.speedX += (Math.random() - 0.3) * 0.5;
            this.speedY += (Math.random() - 0.5) * 0.2;
            this.hasBattered = true;
          }
          const factor = (timelineProgress - 3.2) * 0.8;
          this.wobbleCount += this.wobbleSpeed;
          this.x += (this.speedX + Math.sin(this.wobbleCount) * 1.4) * factor;
          this.y += this.speedY * factor;
          this.angle += this.rotationSpeed * factor;
          this.opacity -= this.fadeSpeed * factor;
        }
      }
    }

    draw(ctx: CanvasRenderingContext2D) {
      if (this.opacity <= 0) return;
      ctx.save();
      ctx.translate(this.x, this.y);
      ctx.rotate(this.angle);
      
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.quadraticCurveTo(this.width * 1.5, -this.length * 0.3, this.width, -this.length * 0.7);
      ctx.quadraticCurveTo(this.width * 0.3, -this.length, 0, -this.length);
      ctx.quadraticCurveTo(-this.width * 0.3, -this.length, -this.width, -this.length * 0.7);
      ctx.quadraticCurveTo(-this.width * 1.5, -this.length * 0.3, 0, 0);
      
      ctx.fillStyle = !this.isSecondText 
        ? `rgba(255, 255, 255, ${this.opacity})` 
        : `rgba(231, 120, 96, ${this.opacity})`;
        
      ctx.fill();
      ctx.restore();
    }
  }

  function initSectionTwoAnimation() {
    const triggerElement = document.querySelector('#section-two') as HTMLElement;
    const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement;
    if (!triggerElement || !canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animState = { timelineProgress: 0.0 };
    let text1 = triggerElement.getAttribute('data-intro') || "shed limiting beliefs";
    let text2 = "Learn to Heal";
    let p1: Petal[] = [];
    let p2: Petal[] = [];

    function scanText(text: string, isSecond: boolean) {
      if (!ctx || !canvas) return [];
      
      let dpr = window.devicePixelRatio || 1;
      let baseWidth = canvas.clientWidth;
      let baseHeight = canvas.clientHeight;
      
      canvas.width = baseWidth * dpr;
      canvas.height = baseHeight * dpr;
      ctx.scale(dpr, dpr);

      ctx.clearRect(0, 0, baseWidth, baseHeight);
      
      let fontSize = baseWidth > 768 ? 52 : 34;
      ctx.font = `300 ${fontSize}px serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(text, baseWidth / 2, baseHeight / 2);

      const imgData = ctx.getImageData(0, 0, baseWidth * dpr, baseHeight * dpr);
      const data = imgData.data;
      ctx.clearRect(0, 0, baseWidth, baseHeight);

      const gap = baseWidth > 768 ? 4 : 3;
      const scanned: Petal[] = [];

      for (let y = 0; y < baseHeight; y += gap) {
        for (let x = 0; x < baseWidth; x += gap) {
          const pixelX = Math.floor(x * dpr);
          const pixelY = Math.floor(y * dpr);
          const index = (pixelY * (baseWidth * dpr) + pixelX) * 4;
          
          if (data[index + 3] > 128) {
            scanned.push(new Petal(x, y, isSecond));
          }
        }
      }
      return scanned;
    }

    function resizeCanvas() {
      p1 = scanText(text1, false);
      p2 = scanText(text2, true);
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    let animationFrameId: number;
    function render() {
      if (!ctx || !canvas) return;
      
      let dpr = window.devicePixelRatio || 1;
      let baseWidth = canvas.width / dpr;
      let baseHeight = canvas.height / dpr;
      
      ctx.clearRect(0, 0, baseWidth, baseHeight);

      const prog = animState.timelineProgress;

      if (prog <= 2.2) {
        p1.forEach(p => { p.update(prog); p.draw(ctx); });
      }
      if (prog >= 1.8) {
        p2.forEach(p => { p.update(prog); p.draw(ctx); });
      }

      animationFrameId = requestAnimationFrame(render);
    }
    render();

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerElement,
        start: 'top top',
        end: '+=2500',
        scrub: 1.2,
        pin: true,
        invalidateOnRefresh: true
      }
    });

    tl.to(animState, {
      timelineProgress: 4.5,
      ease: 'power1.inOut'
    })
    .to('.animation-stage', {
      opacity: 0,
      filter: 'blur(4px)',
      duration: 0.5
    }, '-=0.8')
    .set('.final-quote-stage', { display: 'flex' })
    .to('.final-quote-stage', { opacity: 1, duration: 0.8 }, '-=0.3')
    .from('.final-quote-stage h2', { y: 35, opacity: 0, filter: 'blur(8px)', duration: 1.6, ease: 'power2.out' }, '-=0.5')
    .from('.decorative-line', { scaleX: 0, duration: 1.2, ease: 'power2.out' }, '-=1.0')
    .from('.statement-author', { y: 20, opacity: 0, filter: 'blur(3px)', duration: 1.0, ease: 'power2.out' }, '-=0.8');
  }

  initSectionTwoAnimation();
  document.addEventListener('astro:page-load', initSectionTwoAnimation);
</script>

<style>
  .statement-section {
    background-color: var(--burgundy, #2b0c15);
    padding: 8rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    min-height: 95vh;
    position: relative;
    overflow: hidden;
  }

  .animation-stage, 
  .final-quote-stage {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .canvas-container {
    width: 100%;
    height: 450px;
    position: relative;
    pointer-events: none;
  }

  #particleCanvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .final-quote-stage {
    opacity: 0;
    display: none;
  }

  .final-quote-stage h2 {
    color: var(--white, #ffffff);
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.5px;
    text-align: center;
  }

  .decorative-line {
    width: 60px;
    height: 1px;
    background-color: var(--coral, #e77860);
    margin: 2.5rem auto;
  }

  .statement-author {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--coral, #e77860);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .final-quote-stage h2 { font-size: 1.65rem; }
    .canvas-container { height: 350px; }
  }
</style>
