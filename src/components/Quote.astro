---
interface Props {
  introText?: string;
  quote?: string;
  author?: string;
}

const { 
  introText = "shed limiting beliefs", 
  quote = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.", 
  author = "Lorem Ipsum, 2026" 
} = Astro.props;
---

<section class="statement-section" id="section-two">
  <div class="animation-stage">
    <div class="canvas-container">
      <canvas id="particleCanvas"></canvas>
    </div>
  </div>

  <div class="statement-container final-quote-stage">
    <h2>"{quote}"</h2>
    <div class="decorative-line"></div>
    <span class="statement-author">{author}</span>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  class Particle {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    x: number;
    y: number;
    originX: number;
    originY: number;
    isSecondText: boolean;
    size: number;
    speedX: number;
    speedY: number;
    opacity: number;
    fadeSpeed: number;
    wobbleSpeed: number;
    wobbleCount: number;

    constructor(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, x: number, y: number, isSecondText: boolean) {
      this.canvas = canvas;
      this.ctx = ctx;
      this.x = x;
      this.y = y;
      this.originX = x;
      this.originY = y;
      this.isSecondText = isSecondText;
      
      this.size = Math.random() * 2 + 0.5;
      this.opacity = Math.random() * 0.6 + 0.4;
      
      this.speedY = Math.random() * -2.2 - 0.6;
      this.speedX = (Math.random() - 0.5) * 2;
      this.fadeSpeed = Math.random() * 0.006 + 0.003;
      this.wobbleSpeed = Math.random() * 0.06 + 0.02;
      this.wobbleCount = Math.random() * Math.PI * 2;
    }

    update(intensity: number, triggerSecondPhase: boolean) {
      if (!this.isSecondText) {
        if (intensity > 0) {
          this.wobbleCount += this.wobbleSpeed;
          this.x += this.speedX + Math.sin(this.wobbleCount) * 0.4 * intensity;
          this.y += this.speedY * intensity;
          this.opacity -= this.fadeSpeed * intensity;
        } else {
          this.x = this.originX + (Math.random() - 0.5) * 0.3;
          this.y = this.originY + (Math.random() - 0.5) * 0.3;
        }
      } else {
        if (triggerSecondPhase) {
          this.wobbleCount += this.wobbleSpeed;
          this.x += this.speedX + Math.sin(this.wobbleCount) * 0.6;
          this.y += this.speedY * 1.2;
          this.opacity -= this.fadeSpeed * 0.8;
        } else {
          this.x = this.originX + (Math.random() - 0.5) * 0.3;
          this.y = this.originY + (Math.random() - 0.5) * 0.3;
          if (this.opacity < 0.8) {
            this.opacity += 0.02;
          }
        }
      }
    }

    draw() {
      if (this.opacity <= 0) return;
      this.ctx.beginPath();
      this.ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      
      if (!this.isSecondText) {
        this.ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity})`;
        this.ctx.shadowBlur = this.size * 1.2;
        this.ctx.shadowColor = 'rgba(255, 255, 255, 0.4)';
      } else {
        this.ctx.fillStyle = `rgba(231, 120, 96, ${this.opacity})`;
        this.ctx.shadowBlur = this.size * 1.8;
        this.ctx.shadowColor = 'rgba(231, 120, 96, 0.7)';
      }
      
      this.ctx.fill();
    }
  }

  function initSectionTwoAnimation() {
    const triggerElement = document.querySelector('#section-two');
    const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement;
    if (!triggerElement || !canvas) return;

    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return;

    let textParticles: Particle[] = [];
    let state = {
      intensity1: 0,
      showSecondText: false,
      intensity2: false
    };

    let text1 = "shed limiting beliefs";
    let text2 = "Learn to Heal";

    function resizeCanvas() {
      const container = canvas.parentElement;
      if (!container) return;
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
      generateAllParticles();
    }

    function scanText(text: string, isSecond: boolean) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      let fontSize = canvas.width > 768 ? 52 : 34;
      ctx.font = `300 ${fontSize}px serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#ffffff';
      ctx.fillText(text, canvas.width / 2, canvas.height / 2);

      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imageData.data;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const gap = canvas.width > 768 ? 3 : 2;
      const scanned: Particle[] = [];

      for (let y = 0; y < canvas.height; y += gap) {
        for (let x = 0; x < canvas.width; x += gap) {
          const index = (y * canvas.width + x) * 4;
          const alpha = data[index + 3];
          
          if (alpha > 128) {
            scanned.push(new Particle(canvas, ctx, x, y, isSecond));
          }
        }
      }
      return scanned;
    }

    let p1: Particle[] = [];
    let p2: Particle[] = [];

    function generateAllParticles() {
      p1 = scanText(text1, false);
      p2 = scanText(text2, true);
    }

    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    let animationFrameId: number;
    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (!state.showSecondText) {
        p1.forEach((particle, index) => {
          particle.update(state.intensity1, false);
          particle.draw();
          if (particle.opacity <= 0 || particle.y < 0) {
            p1.splice(index, 1);
          }
        });
      } else {
        p2.forEach((particle, index) => {
          particle.update(0, state.intensity2);
          particle.draw();
          if (particle.opacity <= 0 || particle.y < 0) {
            p2.splice(index, 1);
          }
        });
      }

      animationFrameId = requestAnimationFrame(render);
    }
    render();

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerElement,
        start: 'top 40%',
        toggleActions: 'play none none none',
      },
      onComplete: () => {
        cancelAnimationFrame(animationFrameId);
      }
    });

    tl.to(state, {
      intensity1: 1.5,
      duration: 2.8,
      ease: 'power2.inOut',
      delay: 0.8
    })
    .set(state, { showSecondText: true })
    .to({}, { duration: 1.5 })
    .to(state, {
      intensity2: true,
      duration: 3.2,
      onStart: () => { state.intensity2 = true; }
    })
    .set('.animation-stage', { display: 'none' })
    .set('.final-quote-stage', { display: 'flex' })
    .to('.final-quote-stage', {
      opacity: 1,
      duration: 0.8
    })
    .from('.final-quote-stage h2', {
      y: 25,
      opacity: 0,
      filter: 'blur(6px)',
      duration: 1.4,
      ease: 'power3.out'
    }, '-=0.4')
    .from('.decorative-line', {
      scaleX: 0,
      duration: 1,
      ease: 'power2.out'
    }, '-=0.8')
    .from('.statement-author', {
      y: 15,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out'
    }, '-=0.6');
  }

  initSectionTwoAnimation();
  document.addEventListener('astro:page-load', initSectionTwoAnimation);
</script>

<style>
  .statement-section {
    background-color: var(--burgundy, #2b0c15);
    padding: 8rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    min-height: 95vh;
    position: relative;
    overflow: hidden;
  }

  .animation-stage, 
  .final-quote-stage {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .canvas-container {
    width: 100%;
    height: 450px;
    position: relative;
    pointer-events: none;
  }

  #particleCanvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .final-quote-stage {
    opacity: 0;
    display: none;
  }

  .final-quote-stage h2 {
    color: var(--white, #ffffff);
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0.5px;
    text-align: center;
  }

  .decorative-line {
    width: 60px;
    height: 1px;
    background-color: var(--coral, #e77860);
    margin: 2.5rem auto;
  }

  .statement-author {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--coral, #e77860);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .final-quote-stage h2 { font-size: 1.65rem; }
    .canvas-container { height: 350px; }
  }
</style>
