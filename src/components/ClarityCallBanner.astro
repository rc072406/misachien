---
interface Props {
	// none atm
}
---

<section class="clarity-call-banner-system" id="interactive-banner">
	<canvas id="canvas" class="water-canvas"></canvas>
	
	<div class="clarity-content">
		<span class="kicker light-text">Exclusive Invitation</span>
		<h2 class="serif-italic light-text">Ready to recondition your unconscious framework?</h2>
		<p class="light-text">If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="light-highlight">Clarity Call</strong> to map out your blind spots.</p>
		<a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="cta-link-text">
			<span>Book Your Clarity Call &rarr;</span>
		</a>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import * as PIXI from 'pixi.js';

	const banner = document.getElementById('interactive-banner');
	const canvas = document.querySelector("#canvas") as HTMLCanvasElement;

	if (banner && canvas) {
		const width = banner.clientWidth;
		const height = banner.clientHeight;

		const app = new PIXI.Application({
			view: canvas,
			width: width,
			height: height,
			backgroundAlpha: 0,
			resolution: window.devicePixelRatio || 1,
			autoDensity: true
		});

		const container = new PIXI.Container();
		app.stage.addChild(container);

		const bg = PIXI.Sprite.from('/images/water.webp');
		bg.anchor.set(0.5);
		bg.position.set(width / 2, height / 2);
		
		const resizeBg = () => {
			const w = banner.clientWidth;
			const h = banner.clientHeight;
			const bgRatio = bg.texture.width / bg.texture.height;
			const bannerRatio = w / h;

			if (bannerRatio > bgRatio) {
				bg.width = w;
				bg.height = w / bgRatio;
			} else {
				bg.height = h;
				bg.width = h * bgRatio;
			}
		};

		if (bg.texture.baseTexture.valid) {
			resizeBg();
		} else {
			bg.texture.on('update', resizeBg);
		}

		container.addChild(bg);

		const ripples: PIXI.Sprite[] = [];
		const filters: PIXI.Filter[] = [];

		const displacementSprite = PIXI.Sprite.from('https://s3-us-west-2.amazonaws.com/s.cdpn.io/1600187/waterTemp.jpg');
		displacementSprite.texture.baseTexture.wrapMode = PIXI.WRAP_MODES.REPEAT;
		displacementSprite.scale.set(1);
		displacementSprite.anchor.set(0);

		const loadSprite = PIXI.Sprite.from('https://s3-us-west-2.amazonaws.com/s.cdpn.io/1600187/waterTemp.jpg');
		loadSprite.texture.baseTexture.wrapMode = PIXI.WRAP_MODES.REPEAT;
		loadSprite.scale.set(0.99);
		loadSprite.anchor.set(0.2);

		const loadFilter = new PIXI.filters.DisplacementFilter(loadSprite);
		loadFilter.scale.x = 0;
		loadFilter.scale.y = 0;
		container.filters = [loadFilter];

		const displacementFilter = new PIXI.filters.DisplacementFilter(displacementSprite);
		displacementFilter.scale.x = 10;
		displacementFilter.scale.y = 10;
		filters.push(displacementFilter);

		for (let i = 0; i < 10; i++) {
			const ripple = PIXI.Sprite.from('https://s3-us-west-2.amazonaws.com/s.cdpn.io/1600187/ripple.png');
			ripple.anchor.set(0.5);
			ripple.scale.set(0);
			app.stage.addChild(ripple);
			
			const filter = new PIXI.filters.DisplacementFilter(ripple);
			filters.push(filter);
			ripples.push(ripple);
		}

		app.stage.filters = filters;

		const waves = gsap.to(displacementSprite.anchor, {
			y: "-2",
			x: "-1",
			duration: 44,
			ease: "none",
			repeat: -1,
			paused: true
		});

		let i = -1;
		banner.addEventListener('mousemove', function(ev) {
			const rect = canvas.getBoundingClientRect();
			const x = ev.clientX - rect.left;
			const y = ev.clientY - rect.top;

			i++;
			if (i > 9) {
				i = 0;
			} 
			MakeWaves(x, y, i);
		}, false);

		function MakeWaves(x: number, y: number, index: number) {
			ripples[index].position.set(x, y);
			runTweens(ripples[index], filters[index + 1]);
		}

		const runTweens = (ripple: PIXI.Sprite, filter: any) => {
			gsap.fromTo(ripple.scale, { x: 0.1, y: 0.1 }, { x: 1.5, y: 1.5, duration: 4 });
			gsap.fromTo(filter.scale, { x: 50, y: 50 }, { x: 0, y: 0, duration: 4 });
		};

		gsap.from(container, {
			alpha: 0,
			duration: 1,
			repeatDelay: 4, 
			ease: "power3.out",
			yoyo: true, 
			delay: 2,
		});

		gsap.from(loadSprite.anchor, {
			y: 0.35,
			x: 0.25,
			duration: 1,
			ease: "power1.out",
			repeatDelay: 4, 
			yoyo: true, 
			delay: 2,
			onComplete: () => { waves.play(); }
		});

		gsap.from(loadFilter.scale, {
			x: 900, 
			y: 9500, 
			duration: 1,
			ease: "power1.out",
			delay: 2,
		});

		window.addEventListener('resize', () => {
			if (!banner || !canvas) return;
			const w = banner.clientWidth;
			const h = banner.clientHeight;
			app.renderer.resize(w, h);
			bg.position.set(w / 2, h / 2);
			resizeBg();
		});
	}
</script>

<style>
	.clarity-call-banner-system {
		--coral: #E77860;
		--coral-light: #F0937D;
		--burgundy: #59363A;
		--white: #FFFFFF;
		--cream: #FEF4EF;

		position: relative;
		width: 100%;
		overflow: hidden;
		box-sizing: border-box;
		padding: 6rem 3rem;
		background-image: url('/images/water.webp');
		background-size: cover;
		background-position: center;
	}

	.water-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		pointer-events: none;
	}

	.clarity-content {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
		position: relative;
		z-index: 2;
	}

	.kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
		margin-bottom: -0.5rem;
	}

	.light-text { 
		color: var(--white); 
		max-width: 600px;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
	}

	h2 {
		font-size: clamp(2rem, 3.5vw, 2.6rem);
		line-height: 1.25;
		font-weight: 400;
	}
	h2.light-text { color: var(--cream); }

	p {
		font-size: clamp(1rem, 1.5vw, 1.1rem);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		font-weight: 300;
	}
	p.light-text { color: #DFCDC9; }

	.light-highlight { color: var(--white); font-weight: 600; }

	.cta-link-text {
		position: relative;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		color: var(--cream);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0;
		pointer-events: auto;
		z-index: 4;
		transition: color 0.3s ease;
	}

	.cta-link-text span {
		position: relative;
	}

	.cta-link-text::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1px;
		background-color: var(--cream);
		transform: scaleX(1);
		transform-origin: right;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.cta-link-text:hover {
		color: var(--white);
	}

	.cta-link-text:hover::after {
		transform: scaleX(0);
	}

	@media (max-width: 820px) {
		.clarity-call-banner-system { padding: 4.5rem 2rem; }
	}
</style>
