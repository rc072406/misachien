---
interface Props {
	// none atm
}
---

<section class="clarity-call-banner-system" id="interactive-banner">
	<div class="river-background-container">
		<div class="river-current-layer" id="river-mesh"></div>
		<canvas id="water-ripple-canvas" class="water-ripple-canvas"></canvas>
	</div>

	<div class="banner-inner-frame"></div>
	
	<div class="clarity-content">
		<span class="kicker light-text">Exclusive Invitation</span>
		<h2 class="serif-italic light-text">Ready to recondition your unconscious framework?</h2>
		<p class="light-text">If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="light-highlight">Clarity Call</strong> to map out your blind spots.</p>
		<a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="btn-filled banner-btn light-btn"><span>Book Your Clarity Call</span></a>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	const banner = document.getElementById('interactive-banner');
	const canvas = document.getElementById('water-ripple-canvas') as HTMLCanvasElement;
	const riverMesh = document.getElementById('river-mesh');

	if (banner && canvas && riverMesh) {
		const ctx = canvas.getContext('2d');
		let ripples: any[] = [];
		let width = canvas.width = banner.clientWidth;
		let height = canvas.height = banner.clientHeight;

		window.addEventListener('resize', () => {
			if (!banner || !canvas) return;
			width = canvas.width = banner.clientWidth;
			height = canvas.height = banner.clientHeight;
		});

		gsap.to(riverMesh, {
			backgroundPosition: '200% 50%',
			duration: 25,
			ease: 'none',
			repeat: -1
		});

		banner.addEventListener('mousemove', (e) => {
			const rect = banner.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			
			if (Math.random() > 0.15) {
				ripples.push({
					x,
					y,
					radius: 2,
					maxRadius: Math.random() * 80 + 60,
					alpha: 0.6,
					speed: Math.random() * 2 + 2
				});
			}
		});

		function animateWater() {
			if (!ctx || !canvas) return;
			ctx.clearRect(0, 0, width, height);

			for (let i = ripples.length - 1; i >= 0; i--) {
				const r = ripples[i];
				r.radius += r.speed;
				r.alpha = 1 - (r.radius / r.maxRadius);

				if (r.alpha <= 0) {
					ripples.splice(i, 1);
					continue;
				}

				ctx.beginPath();
				ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
				
				let gradient = ctx.createRadialGradient(r.x, r.y, r.radius - 4, r.x, r.y, r.radius + 4);
				gradient.addColorStop(0, `rgba(254, 244, 239, 0)`);
				gradient.addColorStop(0.3, `rgba(254, 244, 239, ${r.alpha * 0.25})`);
				gradient.addColorStop(0.5, `rgba(240, 147, 125, ${r.alpha * 0.4})`);
				gradient.addColorStop(0.7, `rgba(89, 54, 58, ${r.alpha * 0.15})`);
				gradient.addColorStop(1, `rgba(254, 244, 239, 0)`);

				ctx.strokeStyle = gradient;
				ctx.lineWidth = 6;
				ctx.stroke();
			}

			requestAnimationFrame(animateWater);
		}

		animateWater();
	}
</script>

<style>
	.clarity-call-banner-system {
		--coral: #E77860;
		--coral-light: #F0937D;
		--burgundy: #59363A;
		--white: #FFFFFF;
		--cream: #FEF4EF;

		position: relative;
		width: 100%;
		overflow: hidden;
		box-sizing: border-box;
		padding: 6rem 3rem;
		background-color: var(--burgundy);
	}

	.river-background-container {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}

	.river-current-layer {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			115deg, 
			#4B2737 0%, 
			#8D4150 25%, 
			#E77860 50%, 
			#8D4150 75%, 
			#4B2737 100__
		);
		background-size: 300% 100%;
		opacity: 1;
		filter: blur(4px);
	}

	.river-background-container::after {
		content: '';
		position: absolute;
		inset: 0;
		opacity: 0.02;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='grain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23grain)'/%3E%3C/svg%3E");
	}

	.water-ripple-canvas {
		position: absolute;
		inset: 0;
		mix-blend-mode: color-dodge;
		filter: blur(1.5px);
		opacity: 0.85;
	}

	.banner-inner-frame {
		position: absolute;
		inset: 16px;
		pointer-events: none;
		border: 1px solid rgba(254, 244, 239, 0.12);
		z-index: 3;
	}

	.clarity-content {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
		position: relative;
		z-index: 2;
	}

	.kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
		margin-bottom: -0.5rem;
	}

	.light-text { 
		color: var(--white); 
		max-width: 600px;
	}

	h2 {
		font-size: clamp(2rem, 3.5vw, 2.6rem);
		line-height: 1.25;
		font-weight: 400;
	}
	h2.light-text { color: var(--cream); }

	p {
		font-size: clamp(1rem, 1.5vw, 1.1rem);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		font-weight: 300;
	}
	p.light-text { color: #DFCDC9; }

	.light-highlight { color: var(--cream); font-weight: 500; }

	.btn-filled.banner-btn {
		position: relative;
		padding: 1.1rem 2.5rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		align-self: center;   
		margin: 0 auto;       
		width: max-content;   
		overflow: hidden;
		z-index: 4;
		pointer-events: auto; 
		border-radius: 0;
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-filled.banner-btn span {
		position: relative;
		z-index: 5;
	}

	.btn-filled.banner-btn::before {
		content: '';
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: -1;
	}

	.light-btn {
		border: 1px solid var(--cream);
		color: var(--cream);
		background: transparent;
	}
	.light-btn::before { background-color: var(--cream); }
	.light-btn:hover { color: #8D4150; border-color: var(--cream); }
	.light-btn:hover::before { transform: scaleX(1); }

	@media (max-width: 820px) {
		.clarity-call-banner-system { padding: 4.5rem 2rem; }
		.banner-inner-frame { inset: 12px; }
	}
</style>
