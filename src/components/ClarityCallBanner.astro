---
interface Props {
	// none atm
}
---

<section class="clarity-call-banner-system" id="interactive-banner">
	<div class="water-background-container">
		<div class="gradient-base"></div>
		<div class="ripple-shimmer-overlay"></div>
		<div id="ripple-pool" class="ripple-pool"></div>
	</div>

	<div class="banner-inner-frame"></div>
	
	<div class="clarity-content">
		<span class="kicker light-text">Exclusive Invitation</span>
		<h2 class="serif-italic light-text">Ready to recondition your unconscious framework?</h2>
		<p class="light-text">If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="light-highlight">Clarity Call</strong> to map out your blind spots.</p>
		<a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="btn-filled banner-btn light-btn"><span>Book Your Clarity Call</span></a>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	const banner = document.getElementById('interactive-banner');
	const ripplePool = document.getElementById('ripple-pool');

	if (banner && ripplePool) {
		let lastX = 0;
		let lastY = 0;
		const minDistance = 20; 
		banner.addEventListener('mousemove', (e) => {
			const rect = banner.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;

			
			const distance = Math.sqrt(Math.pow(x - lastX, 2) + Math.pow(y - lastY, 2));

			if (distance > minDistance) {
				createWaterRipple(x, y);
				lastX = x;
				lastY = y;
			}
		});

		function createWaterRipple(startX, startY) {
	
			const ringCount = 2;
			
			for (let i = 0; i < ringCount; i++) {
				const ripple = document.createElement('div');
				ripple.className = 'water-ring';
				
				
				ripple.style.left = `${startX}px`;
				ripple.style.top = `${startY}px`;
				
				ripplePool.appendChild(ripple);

				
				gsap.fromTo(ripple, 
					{
						width: 0,
						height: 0,
						opacity: 0.5,
						borderWidth: '3px'
					},
					{
						width: 180 + i * 60, 
						height: 180 + i * 60,
						opacity: 0,
						borderWidth: '0px',
						duration: 1.6 + i * 0.4, 
						ease: 'sine.out', 
						delay: i * 0.12,
						onComplete: () => {
							ripple.remove(); 
						}
					}
				);
			}
		}
	}
</script>

<style>
	.clarity-call-banner-system {
		--coral: #E77860;
		--coral-light: #F0937D;
		--burgundy: #59363A;
		--white: #FFFFFF;
		--cream: #FEF4EF;

		position: relative;
		width: 100%;
		overflow: hidden;
		box-sizing: border-box;
		padding: 6rem 3rem;
		background-color: #4B2737;
	}

	/* --- Isolated Background System --- */
	.water-background-container {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}

	.gradient-base {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, #4B2737 0%, #8D4150 50%, #DF7A62 100%);
	}


	.ripple-shimmer-overlay {
		position: absolute;
		inset: 0;
		opacity: 0.03;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='grain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23grain)'/%3E%3C/svg%3E");
	}

	.ripple-pool {
		position: absolute;
		inset: 0;
	}

	/* --- Liquid Ring Styling --- */
	:global(.water-ring) {
		position: absolute;
		border: 1px solid rgba(254, 244, 239, 0.35);
		border-radius: 50%;
		pointer-events: none;
		transform: translate(-50%, -50%);
	
		mix-blend-mode: screen;
	
		box-shadow: 
			inset 0 0 15px rgba(240, 147, 125, 0.15),
			0 0 15px rgba(254, 244, 239, 0.1);
		filter: blur(1px);
		will-change: width, height, opacity, border-width;
	}


	.banner-inner-frame {
		position: absolute;
		inset: 16px;
		pointer-events: none;
		border: 1px solid rgba(254, 244, 239, 0.08);
		z-index: 3;
	}

	.clarity-content {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
		position: relative;
		z-index: 2; 
	}

	.kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
		margin-bottom: -0.5rem;
	}

	.light-text { 
		color: var(--white); 
		max-width: 600px;
	}

	h2 {
		font-size: clamp(2rem, 3.5vw, 2.6rem);
		line-height: 1.25;
		font-weight: 400;
	}
	h2.light-text { color: var(--cream); }

	p {
		font-size: clamp(1rem, 1.5vw, 1.1rem);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		font-weight: 300;
	}
	p.light-text { color: #DFCDC9; }

	.light-highlight { color: var(--cream); font-weight: 500; }

	/* --- Luxury Button Configurations --- */
	.btn-filled.banner-btn {
		position: relative;
		padding: 1.1rem 2.5rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		align-self: center;   
		margin: 0 auto;       
		width: max-content;   
		overflow: hidden;
		z-index: 4;
		pointer-events: auto; 
		border-radius: 0;
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-filled.banner-btn span {
		position: relative;
		z-index: 5;
	}

	.btn-filled.banner-btn::before {
		content: '';
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: -1;
	}

	.light-btn {
		border: 1px solid var(--cream);
		color: var(--cream);
		background: transparent;
	}
	.light-btn::before { background-color: var(--cream); }
	.light-btn:hover { color: #8D4150; border-color: var(--cream); }
	.light-btn:hover::before { transform: scaleX(1); }

	@media (max-width: 820px) {
		.clarity-call-banner-system { padding: 4.5rem 2rem; }
		.banner-inner-frame { inset: 12px; }
	}
</style>
