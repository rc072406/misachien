---
interface Props {
	// none atm
}
---

<section class="clarity-call-banner-system" id="interactive-banner">
	<div class="banner-inner-frame"></div>
	
	<div class="clarity-content ripple-target">
		<span class="kicker light-text">Exclusive Invitation</span>
		<h2 class="serif-italic light-text">Ready to recondition your unconscious framework?</h2>
		<p class="light-text">If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="light-highlight">Clarity Call</strong> to map out your blind spots.</p>
		<a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="btn-filled banner-btn light-btn"><span>Book Your Clarity Call</span></a>
	</div>

	<svg class="liquid-filter-svg" aria-hidden="true">
		<defs>
			<filter id="luxury-water-ripple" x="-20%" y="-20%" width="140%" height="140%">
				<feTurbulence 
					type="fractalNoise" 
					baseFrequency="0.015 0.015" 
					numOctaves="3" 
					result="noise" 
					seed="5" />
				<feDisplacementMap 
					in="SourceGraphic" 
					in2="noise" 
					scale="0" 
					xChannelSelector="R" 
					yChannelSelector="G" 
					result="displacement" />
			</filter>
		</defs>
	</svg>
</section>

<script>
	import { gsap } from 'gsap';

	const banner = document.getElementById('interactive-banner');
	const displacementMap = document.querySelector('#luxury-water-ripple feDisplacementMap');
	const turbulence = document.querySelector('#luxury-water-ripple feTurbulence');

	if (banner && displacementMap && turbulence) {
		
		
		const rippleState = {
			scale: 0,
			baseFreqX: 0.015,
			baseFreqY: 0.015
		};

		let lastMouseX = 0;
		let lastMouseY = 0;
		let mouseVelocity = 0;
		let animationFrameId = null;
		let isHovered = false;

		
		function updateFilter() {
			displacementMap.setAttribute('scale', rippleState.scale.toString());
			turbulence.setAttribute('baseFrequency', `${rippleState.baseFreqX} ${rippleState.baseFreqY}`);
		}

		
		function liquidLifeLoop() {
			if (isHovered) {
				rippleState.baseFreqX += 0.00005;
				rippleState.baseFreqY += 0.00003;
				updateFilter();
			}
			animationFrameId = requestAnimationFrame(liquidLifeLoop);
		}

		banner.addEventListener('mouseenter', (e) => {
			isHovered = true;
			lastMouseX = e.clientX;
			lastMouseY = e.clientY;
			
		
			cancelAnimationFrame(animationFrameId);
			liquidLifeLoop();
		});

		banner.addEventListener('mousemove', (e) => {
			if (!isHovered) return;

		
			const deltaX = e.clientX - lastMouseX;
			const deltaY = e.clientY - lastMouseY;
			mouseVelocity = Math.sqrt(deltaX * deltaX + deltaY * deltaY);

			lastMouseX = e.clientX;
			lastMouseY = e.clientY;

			
			const targetScale = Math.min(mouseVelocity * 1.5, 45); 

			
			gsap.to(rippleState, {
				scale: targetScale,
				duration: 0.3,
				ease: 'power2.out',
				onUpdate: updateFilter,
				overwrite: 'auto'
			});

			
			gsap.to(rippleState, {
				scale: 8, 
				duration: 1.4,
				delay: 0.1,
				ease: 'power3.out',
				onUpdate: updateFilter
			});
		});

		banner.addEventListener('mouseleave', () => {
			isHovered = false;
			cancelAnimationFrame(animationFrameId);

			gsap.to(rippleState, {
				scale: 0,
				duration: 1.2,
				ease: 'power3.inOut',
				onUpdate: updateFilter,
				overwrite: 'auto'
			});
		});
	}
</script>

<style>
	.clarity-call-banner-system {
		--coral: #E77860;
		--coral-light: #F0937D;
		--burgundy: #59363A;
		--white: #FFFFFF;
		--cream: #FEF4EF;

		position: relative;
		width: 100%;
		overflow: hidden;
		box-sizing: border-box;
		padding: 6rem 3rem;
		
	
		background: 
			url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='grain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23grain)' opacity='0.03'/%3E%3C/svg%3E"),
			linear-gradient(135deg, #4B2737 0%, #8D4150 50%, #DF7A62 100%);
		

		filter: url(#luxury-water-ripple);
		will-change: filter;
	}

	.banner-inner-frame {
		position: absolute;
		inset: 16px;
		pointer-events: none;
		border: 1px solid rgba(254, 244, 239, 0.08);
		z-index: 3;
	}

	.clarity-content {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
		position: relative;
		z-index: 2;
	}

	.kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
		margin-bottom: -0.5rem;
	}

	.light-text { 
		color: var(--white); 
		max-width: 600px;
	}

	h2 {
		font-size: clamp(2rem, 3.5vw, 2.6rem);
		line-height: 1.25;
		font-weight: 400;
	}
	h2.light-text { color: var(--cream); }

	p {
		font-size: clamp(1rem, 1.5vw, 1.1rem);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		font-weight: 300;
	}
	p.light-text { color: #DFCDC9; }

	.light-highlight { color: var(--cream); font-weight: 500; }

	
	.btn-filled.banner-btn {
		position: relative;
		padding: 1.1rem 2.5rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 600;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		align-self: center;   
		margin: 0 auto;       
		width: max-content;   
		overflow: hidden;
		z-index: 4;
		pointer-events: auto; 
		border-radius: 0;
		transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-filled.banner-btn span {
		position: relative;
		z-index: 5;
	}

	.btn-filled.banner-btn::before {
		content: '';
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: -1;
	}

	.light-btn {
		border: 1px solid var(--cream);
		color: var(--cream);
		background: transparent;
	}
	.light-btn::before { background-color: var(--cream); }
	.light-btn:hover { color: #8D4150; border-color: var(--cream); }
	.light-btn:hover::before { transform: scaleX(1); }

	.liquid-filter-svg {
		position: absolute;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	@media (max-width: 820px) {
		.clarity-call-banner-system { padding: 4.5rem 2rem; }
		.banner-inner-frame { inset: 12px; }
	}
</style>
