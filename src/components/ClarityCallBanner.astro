---
interface Props {
	// none atm
}
---

<section class="clarity-call-banner-system" id="interactive-banner">
	<div class="banner-layer base-layer">
		<div class="banner-inner-frame"></div>
		<div class="clarity-content">
			<span class="kicker dark-text">Exclusive Invitation</span>
			<h2 class="serif-italic dark-text">Ready to recondition your unconscious framework?</h2>
			<p class="dark-text">If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="dark-highlight">Clarity Call</strong> to map out your blind spots.</p>
			<a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="btn-filled banner-btn dark-btn"><span>Book Your Clarity Call</span></a>
		</div>
	</div>

	<div class="banner-layer liquid-layer">
		<div class="banner-inner-frame "></div>
		<div class="clarity-content reveal-on-scroll">
			<span class="kicker light-text">Exclusive Invitation</span>
			<h2 class="serif-italic light-text">Ready to recondition your unconscious framework?</h2>
			<p class="light-text">If you are ready to stop grinding harder and start operating from pure clarity, let's talk. Secure a complimentary, invigorating <strong class="light-highlight">Clarity Call</strong> to map out your blind spots.</p>
			<a href="https://calendly.com/misachien/clarity-call?month=2026-07" target="_blank" class="btn-filled banner-btn light-btn"><span>Book Your Clarity Call</span></a>
		</div>
	</div>

	<svg xmlns="http://www.w3.org/2000/svg" class="liquid-mask-svg" aria-hidden="true">
		<defs>
			<clipPath id="liquid-clip-path" clipPathUnits="objectBoundingBox">
				<path id="liquid-clip-element" d="M 0 0 C 0.25 0, 0.75 0, 1 0 L 1 1 L 0 1 Z" />
			</clipPath>
		</defs>
	</svg>
</section>

<script>
	import { gsap } from 'gsap';

	const banner = document.getElementById('interactive-banner');
	const clipElement = document.getElementById('liquid-clip-element');

	if (banner && clipElement) {
	
		const liquidState = {
			yLeft: 0,
			yCtrl1: 0,
			yCtrl2: 0,
			yRight: 0
		};

		function renderLiquidPath() {
		
			const d = `M 0 ${liquidState.yLeft} C 0.33 ${liquidState.yCtrl1}, 0.66 ${liquidState.yCtrl2}, 1 ${liquidState.yRight} L 1 1 L 0 1 Z`;
			clipElement.setAttribute('d', d);
		}

		banner.addEventListener('mouseenter', () => {
			gsap.killTweensOf(liquidState);

			
			gsap.to(liquidState, { 
                yLeft: 1, 
                duration: 0.9, 
                ease: 'sine.inOut', 
                onUpdate: renderLiquidPath 
            });
			gsap.to(liquidState, { 
                yRight: 1, 
                duration: 1.1, 
                ease: 'sine.inOut' 
            });

		
			gsap.to(liquidState, { 
                yCtrl1: 1, 
                duration: 1.4, 
                ease: 'elastic.out(1.4, 0.6)' 
            });
            
			
			gsap.to(liquidState, { 
                yCtrl2: 1, 
                duration: 1.6, 
                delay: 0.1, 
                ease: 'elastic.out(1.1, 0.4)' 
            });
		});

		banner.addEventListener('mouseleave', () => {
			gsap.killTweensOf(liquidState);

			
			gsap.to(liquidState, { 
                yLeft: 0, 
                duration: 0.9, 
                ease: 'sine.inOut', 
                onUpdate: renderLiquidPath 
            });
			gsap.to(liquidState, { 
                yRight: 0, 
                duration: 1.1, 
                ease: 'sine.inOut' 
            });

			
			gsap.to(liquidState, { 
                yCtrl1: 0, 
                duration: 1.4, 
                ease: 'elastic.out(1.4, 0.6)' 
            });
            
			
			gsap.to(liquidState, { 
                yCtrl2: 0, 
                duration: 1.6, 
                delay: 0.1, 
                ease: 'elastic.out(1.1, 0.4)' 
            });
		});
	}
</script>
<style>
	
	.clarity-call-banner-system {
		--coral: #E77860;
		--coral-light: #F0937D;
		--burgundy: #59363A;
		--white: #FFFFFF;
		--cream: #FEF4EF;
        margin-top: 0;
		position: relative;
		width: 100%;
		background-color: var(--white); 
		overflow: hidden;
		box-sizing: border-box;
	}


	.banner-layer {
		width: 100%;
		padding: 6rem 3rem;
		box-sizing: border-box;
	}

	.base-layer {
		position: relative;
		z-index: 1;
		background-color: var(--white);
	}

	.liquid-layer {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none; 
		

		background: 
			url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='grain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23grain)' opacity='0.04'/%3E%3C/svg%3E"),
			linear-gradient(to right, var(--coral) 0%, var(--coral-light) 100%);
		

		clip-path: url(#liquid-clip-path);
	}


	.banner-inner-frame {
		position: absolute;
		inset: 16px;
		pointer-events: none;
		z-index: 3;
	}


	.clarity-content {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
	}

	
	.kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
		margin-bottom: -0.5rem;
	}
	.dark-text { 
color: var(--burgundy); 
max-width: 600px;
}
	.light-text { 
color: var(--white); 
max-width: 600px;
}

	h2 {
		font-size: clamp(2rem, 3.5vw, 2.6rem);
		line-height: 1.25;
		font-weight: 400;
	}
	h2.dark-text { color: var(--burgundy); }
	h2.light-text { color: var(--cream); }

	p {
		font-size: clamp(1rem, 1.5vw, 1.1rem);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		font-weight: 300;
	}
	p.dark-text { color: rgba(89, 54, 58, 0.8); }
	p.light-text { color: #DFCDC9; }

	.dark-highlight { color: var(--coral); font-weight: 600; }
	.light-highlight { color: var(--cream); font-weight: 500; }

	/* --- Button Configurations --- */
.btn-filled.banner-btn {
	position: relative;
	padding: 1.1rem 2.5rem;
	font-size: 0.75rem;
	text-transform: uppercase;
	letter-spacing: 2px;
	font-weight: 600;
	display: inline-flex;
	justify-content: center;
	align-items: center;
	

	align-self: center;   
	margin: 0 auto;       
	width: max-content;   
	

	overflow: hidden;
	z-index: 4;
	pointer-events: auto; 
	border-radius: 0;
	transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

	.btn-filled.banner-btn span {
		position: relative;
		z-index: 5;
	}

	.btn-filled.banner-btn::before {
		content: '';
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: -1;
	}

	
	.light-btn {
		border: 1px solid var(--cream);
		color: var(--cream);
		background: transparent;
	}
	.light-btn::before { background-color: var(--cream); }
	.light-btn:hover { color: var(--coral); border-color: var(--cream); }
	.light-btn:hover::before { transform: scaleX(1); }


	.dark-btn {
		border: 1px solid var(--burgundy);
		color: var(--burgundy);
		background: transparent;
	}
	.dark-btn::before { background-color: var(--burgundy); }
	.dark-btn:hover { color: var(--white); border-color: var(--burgundy); }
	.dark-btn:hover::before { transform: scaleX(1); }


	.liquid-mask-svg {
		position: absolute;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	@media (max-width: 820px) {
		.clarity-call-banner-system { 
         margin-top: 0; 
  
		 }
		.banner-layer { padding: 4.5rem 2rem; }
		.banner-inner-frame { inset: 12px; }
	}
</style>
