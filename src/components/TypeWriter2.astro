<script type="module" define:vars={{}}>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	let scrollCtx;

	function buildHorizontalLayout() {
		if (scrollCtx) scrollCtx.revert();

		scrollCtx = gsap.context(() => {
			const section = document.querySelector('.dashboard-section');
			const track = document.querySelector('.horizontal-scroll-track');
			if (!section || !track) return;

			if (window.innerWidth > 768) {
				let scrollWidth = track.scrollWidth;
				let totalMove = scrollWidth - window.innerWidth;

				gsap.to(track, {
					x: -totalMove,
					ease: 'none',
					scrollTrigger: {
						trigger: section,
						pin: true,
						scrub: 0.1,
						start: 'top top',
						end: () => `+=${totalMove}`,
						invalidateOnRefresh: true,
						pinSpacing: true 
					}
				});
			}
		});
	}

	function init() {
		buildHorizontalLayout();
		ScrollTrigger.refresh();
	}

	// Initialize when DOM is ready
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}

	// Handle Astro page navigation
	document.addEventListener('astro:page-load', init);
	
	// Handle window resize
	let resizeTimeout;
	window.addEventListener('resize', () => {
		clearTimeout(resizeTimeout);
		resizeTimeout = setTimeout(() => {
			buildHorizontalLayout();
			ScrollTrigger.refresh();
		}, 150);
	});
</script>

