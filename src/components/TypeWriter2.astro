		font-size: 5.5rem;
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -3px;
		margin: 0;
		color: #59363A;
	}

	.editorial-descriptor {
		font-size: 1.1rem;
		line-height: 1.6;
		font-weight: 300;
		max-width: 440px;
		margin: 2rem 0 auto 0;
		color: #59363A;
		opacity: 0.85;
	}

	.scroll-indicator-arrow {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: #59363A;
		opacity: 0.6;
	}

