		</div>

		<div class="source-citation-footer">
			<p>Incidence of $1M firms tracked over 5 initial years of business matrix framework.</p>
			<p>Source Data Synthesized via: <a href="https://www.jpmorganchase.com/institute/all-topics/business-growth-and-entrepreneurship/1-million-annual-revenues-as-a-small-business-milestone" target="_blank" rel="noopener noreferrer">JPMorgan Chase Institute</a> & The U.S. Census Bureau Annual Business Survey</p>
		</div>

	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	function runDynamicPillars(paneId: string) {
		const targetPane = document.getElementById(paneId);
		if (!targetPane) return;

		const pillars = targetPane.querySelectorAll('.bar-pillar');
		
		pillars.forEach((pillar) => {
			const element = pillar as HTMLElement;
			const targetPct = parseFloat(element.getAttribute('data-height') || '0');
			
			gsap.fromTo(element, 
				{ height: '0%' },
				{ 
					height: `${targetPct}%`, 
					duration: 1.6, 
					ease: 'power4.out',
					overwrite: 'auto'
				}
			);
		});

		gsap.fromTo(targetPane.querySelectorAll('.pillar-value'),
			{ opacity: 0, y: 10 },
			{ opacity: 1, y: 0, duration: 0.6, delay: 0.8, stagger: 0.05, overwrite: 'auto' }
		);
	}

	function setupDashboardSystem() {
		ScrollTrigger.getAll().forEach(t => t.kill());

		const tabButtons = document.querySelectorAll('.tab-btn');
		const panes = document.querySelectorAll('.chart-pane');

		tabButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetMetric = btn.getAttribute('data-metric');
				
				tabButtons.forEach(b => b.classList.remove('active'));
				panes.forEach(p => p.classList.remove('active'));

				btn.classList.add('active');
				const activePane = document.getElementById(`${targetMetric}-pane`);
				if (activePane) {
					activePane.classList.add('active');
					runDynamicPillars(`${targetMetric}-pane`);
				}
			});
		});

		ScrollTrigger.create({
			trigger: '.dashboard-container',
			start: 'top bottom-=100',
			onEnter: () => {
				runDynamicPillars('gender-pane');
			},
			once: true
		});
	}

	function init() {
		setupDashboardSystem();
	}

	document.addEventListener('DOMContentLoaded', init);
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.typewriter-section {
		width: 100%;
		background-color: #FEF4EF;
		padding: 7rem 1.5rem;
		box-sizing: border-box;
		font-family: 'Poppins', sans-serif;
		display: flex;
		justify-content: center;
		align-items: center;
		overflow: hidden;
	}

	.typewriter-container {
		width: 100%;
		max-width: 1100px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.quote-wrapper {
		max-width: 850px;
		margin-bottom: 3rem;
	}

	.section-kicker {
		display: block;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 3px;
		font-weight: 600;
		color: var(--burgundy, #59363A);
		opacity: 0.6;
		margin-bottom: 1.5rem;
	}

	.quote-text {
		font-size: 1.75rem;
		font-weight: 300;
		line-height: 1.5;
		color: var(--burgundy, #59363A);
		letter-spacing: -0.5px;
	}

	.quote-author {
		display: block;
		margin-top: 1.25rem;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-weight: 500;
		color: var(--coral, #D67A6B);
	}

	.section-divider {
		width: 40px;
		border: none;
		border-top: 1px solid rgba(89, 54, 58, 0.15);
		margin-bottom: 3rem;
	}

	.interactive-display {
		width: 100%;
		max-width: 800px;
		margin-bottom: 4rem;
	}

	.statement-heading {
		font-family: 'Tenor Sans', sans-serif;
		font-size: 2.5rem;
		font-weight: 400;
		line-height: 1.3;
		color: var(--burgundy, #59363A);
		letter-spacing: -0.5px;
		margin-bottom: 1.5rem;
	}

	.narrative-subtext {
		font-size: 1.1rem;
		line-height: 1.7;
		color: var(--burgundy, #59363A);
		opacity: 0.85;
		font-weight: 300;
	}

	.dashboard-container {
		width: 100%;
		max-width: 1000px;
		background: rgba(255, 255, 255, 0.45);
		border: 1px solid rgba(89, 54, 58, 0.08);
		border-radius: 6px;
		padding: 3.5rem 2.5rem;
		box-sizing: border-box;
		backdrop-filter: blur(10px);
		box-shadow: 0 30px 60px rgba(89, 54, 58, 0.03);
	}

	.filter-tabs {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-bottom: 4.5rem;
		border-bottom: 1px solid rgba(89, 54, 58, 0.08);
		padding-bottom: 1.5rem;
	}

	.tab-btn {
		background: none;
		border: none;
		font-family: 'Tenor Sans', sans-serif;
		font-size: 1.05rem;
		color: var(--burgundy, #59363A);
		opacity: 0.4;
		cursor: pointer;
		padding: 0.5rem 1rem;
		position: relative;
		transition: opacity 0.4s ease;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.tab-btn:hover {
		opacity: 0.8;
	}

	.tab-btn.active {
		opacity: 1;
		font-weight: 500;
	}

	.tab-btn.active::after {
		content: '';
		position: absolute;
		bottom: -1.5rem;
		left: 0;
		width: 100%;
		height: 2px;
		background-color: var(--coral, #E77860);
	}

	.visualization-viewframe {
		position: relative;
		width: 100%;
		height: 380px;
	}

	.chart-pane {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		opacity: 0;
		pointer-events: none;
		visibility: hidden;
		transition: opacity 0.4s ease, visibility 0.4s ease;
	}

	.chart-pane.active {
		opacity: 1;
		pointer-events: auto;
		visibility: visible;
	}

	.chart-grid {
		width: 100%;
		height: 280px;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 1.5rem;
		align-items: flex-end;
		border-bottom: 1px solid rgba(89, 54, 58, 0.15);
		padding-bottom: 0.5rem;
	}

	.tier-column {
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 100%;
		justify-content: flex-end;
	}

	.bar-group-wrapper {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}

	.bar-track {
		display: flex;
		align-items: flex-end;
		gap: 10px;
		height: 100%;
		width: auto;
	}

	.bar-pillar {
		width: 24px;
		height: 0%;
		border-radius: 3px 3px 0 0;
		position: relative;
		display: flex;
		justify-content: center;
		transition: background-color 0.3s ease;
	}

	.pillar-value {
		position: absolute;
		top: -24px;
		font-family: 'Tenor Sans', sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--burgundy, #59363A);
		white-space: nowrap;
		opacity: 0;
	}

	.female-bar { background-color: rgba(231, 120, 96, 0.85); }
	.male-bar { background-color: rgba(89, 54, 58, 0.35); }

	.multi-track .bar-pillar {
		width: 14px;
		gap: 4px;
	}

	.asian-bar { background-color: rgba(231, 120, 96, 0.9); }
	.white-bar { background-color: rgba(89, 54, 58, 0.5); }
	.hispanic-bar { background-color: rgba(214, 122, 107, 0.5); }
	.black-bar { background-color: rgba(89, 54, 58, 0.18); }

	.tier-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: var(--burgundy, #59363A);
		opacity: 0.6;
		margin-top: 1rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.legend-box {
		display: flex;
		justify-content: center;
		gap: 2rem;
		margin-top: 2.5rem;
	}

	.legend-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--burgundy, #59363A);
		opacity: 0.7;
		font-weight: 500;
	}

	.swatch {
		width: 12px;
		height: 12px;
		border-radius: 2px;
		display: inline-block;
	}

	.female-swatch { background-color: rgba(231, 120, 96, 0.85); }
	.male-swatch { background-color: rgba(89, 54, 58, 0.35); }
	.asian-swatch { background-color: rgba(231, 120, 96, 0.9); }
	.white-swatch { background-color: rgba(89, 54, 58, 0.5); }
	.hispanic-swatch { background-color: rgba(214, 122, 107, 0.5); }
	.black-swatch { background-color: rgba(89, 54, 58, 0.18); }

	.source-citation-footer {
		width: 100%;
		margin-top: 4.5rem;
		text-align: center;
		border-top: 1px dashed rgba(89, 54, 58, 0.1);
		padding-top: 2rem;
	}

	.source-citation-footer p {
		font-size: 0.7rem;
		color: var(--burgundy, #59363A);
		opacity: 0.4;
		letter-spacing: 0.5px;
		line-height: 1.6;
		font-weight: 300;
	}

	.source-citation-footer a {
		text-decoration: underline;
		color: inherit;
	}

	@media (max-width: 860px) {
		.chart-grid {
			gap: 0.5rem;
		}
		.bar-track {
			gap: 4px;
		}
		.multi-track .bar-pillar {
			width: 8px;
			gap: 2px;
		}
		.tier-label {
			font-size: 0.65rem;
		}
	}

	@media (max-width: 768px) {
		.typewriter-section {
			padding: 5rem 1rem;
		}

		.quote-text {
			font-size: 1.35rem;
			line-height: 1.6;
		}

		.statement-heading {
			font-size: 1.85rem;
		}

		.dashboard-container {
			padding: 2rem 1rem;
		}

		.filter-tabs {
			margin-bottom: 3.5rem;
			gap: 0.5rem;
		}

		.tab-btn {
			font-size: 0.85rem;
			padding: 0.5rem 0.25rem;
		}

		.visualization-viewframe {
			height: 440px;
		}

		.chart-grid {
			grid-template-columns: 1fr;
			height: auto;
			border-bottom: none;
			gap: 1.75rem;
			align-items: center;
		}

		.tier-column {
			flex-direction: row-reverse;
			justify-content: space-between;
			align-items: center;
			width: 100%;
			border-bottom: 1px solid rgba(89, 54, 58, 0.08);
			padding-bottom: 0.75rem;
		}

		.bar-group-wrapper {
			height: 32px;
			width: 60%;
			justify-content: flex-start;
		}

		.bar-track {
			width: 100%;
			height: 100%;
			flex-direction: row;
			align-items: center;
			justify-content: flex-start;
		}

		.bar-pillar {
			height: 100% !important;
			width: 0%;
			border-radius: 0 2px 2px 0;
		}

		.multi-track .bar-pillar {
			height: 6px !important;
			width: 0%;
		}

		.pillar-value {
			top: 50%;
			transform: translateY(-50%);
			right: -45px;
			left: auto;
			font-size: 0.75rem;
		}

		.tier-label {
			margin-top: 0;
			font-size: 0.7rem;
			width: 35%;
