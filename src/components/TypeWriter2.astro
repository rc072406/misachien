<section class="dashboard-section" data-theme="light">
	<div class="pin-container">
		<div class="horizontal-scroll-track">
			
			<div class="intro-panel">
				<span class="panel-index">01. Overview</span>
				<h2 class="main-editorial-title">Scaling to<br />$1 Million</h2>
				<p class="editorial-descriptor">
					A comprehensive structural assessment of small business scaling milestones over their first five years of operation, mapped across initial revenue tiers and gender architecture.
				</p>
				<div class="scroll-indicator-arrow">
					<span>Scroll to explore data</span>
					<div class="arrow-line"></div>
				</div>
			</div>

			<div class="divider-panel">
				<span class="panel-index">02. Gender Equity</span>
				<h3 class="section-context-title">The Gender<br />Gap Matrix</h3>
				<p class="editorial-descriptor">
					Across identical initial capitalizations, female-owned firms systematically demonstrate lower conversion rates to the million-dollar threshold, closing the variance only at the highest entry tier.
				</p>
			</div>

			<div class="data-card">
				<span class="card-tier">&lt; $100K Initial Revenue</span>
				<div class="metric-block">
					<div class="metric-row highlight-accent">
						<span class="huge-stat">0.6%</span>
						<span class="stat-label">Female Owned</span>
					</div>
					<div class="metric-row">
						<span class="huge-stat">1.4%</span>
						<span class="stat-label">Male Owned</span>
					</div>
				</div>
				<div class="comparison-bar-visual">
					<div class="visual-fill dynamic-fill-accent" style="width: 42.8%;"></div>
				</div>
			</div>

			<div class="data-card">
				<span class="card-tier">$100K – $249K Initial</span>
				<div class="metric-block">
					<div class="metric-row highlight-accent">
						<span class="huge-stat">2.8%</span>
						<span class="stat-label">Female Owned</span>
					</div>
					<div class="metric-row">
						<span class="huge-stat">4.4%</span>
						<span class="stat-label">Male Owned</span>
					</div>
				</div>
				<div class="comparison-bar-visual">
					<div class="visual-fill dynamic-fill-accent" style="width: 63.6%;"></div>
				</div>
			</div>

			<div class="data-card">
				<span class="card-tier">$250K – $499K Initial</span>
				<div class="metric-block">
					<div class="metric-row highlight-accent">
						<span class="huge-stat">10.0%</span>
						<span class="stat-label">Female Owned</span>
					</div>
					<div class="metric-row">
						<span class="huge-stat">13.0%</span>
						<span class="stat-label">Male Owned</span>
					</div>
				</div>
				<div class="comparison-bar-visual">
					<div class="visual-fill dynamic-fill-accent" style="width: 76.9%;"></div>
				</div>
			</div>

			<div class="data-card">
				<span class="card-tier">$500K – $749K Initial</span>
				<div class="metric-block">
					<div class="metric-row highlight-accent">
						<span class="huge-stat">28.0%</span>
						<span class="stat-label">Female Owned</span>
					</div>
					<div class="metric-row">
						<span class="huge-stat">31.0%</span>
						<span class="stat-label">Male Owned</span>
					</div>
				</div>
				<div class="comparison-bar-visual">
					<div class="visual-fill dynamic-fill-accent" style="width: 90.3%;"></div>
				</div>
			</div>

			<div class="data-card target-parity-card">
				<span class="card-tier">$750K – $999K Initial</span>
				<div class="metric-block">
					<div class="metric-row neon-accent">
						<span class="huge-stat">52.0%</span>
						<span class="stat-label">Female Owned</span>
					</div>
					<div class="metric-row neon-accent">
						<span class="huge-stat">52.0%</span>
						<span class="stat-label">Male Owned</span>
					</div>
				</div>
				<div class="parity-badge">Statistical Parity Achieved</div>
			</div>

			<div class="misa-breakthrough-panel">
				<span class="panel-index">Realized Defiance</span>
				<h3 class="breakthrough-title">Misa Faced<br />These Odds.</h3>
				<p class="breakthrough-body">
					She conquered the hidden architectural scripts of scarcity, scaling past the systematic noise to join the small margin of high earners.
				</p>
				<div class="breakthrough-callout">
					<span>She can help you break the ceiling too.</span>
				</div>
			</div>

			<div class="conclusion-panel">
				<span class="panel-index">03. Source Data</span>
				<h4 class="citation-header">Methodology & Attribution</h4>
				<p class="citation-body">
					Data synthesized from the comprehensive study tracking firm revenues across initial cycles conducted via the JPMorgan Chase Institute. Matrix models isolate operations with verified banking profiles completing structural milestones.
				</p>
				<a href="https://www.jpmorganchase.com/institute/all-topics/business-growth-and-entrepreneurship/1-million-annual-revenues-as-a-small-business-milestone" target="_blank" rel="noopener noreferrer" class="jpm-link">
					View Original Study
				</a>
			</div>

		</div>
	</div>
</section>
<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);


	let horizontalScrollTrigger;

	function buildHorizontalLayout() {
	
		if (horizontalScrollTrigger) {
			horizontalScrollTrigger.kill(true);
		}

		const section = document.querySelector('.dashboard-section');
		const pinContainer = document.querySelector('.pin-container');
		const track = document.querySelector('.horizontal-scroll-track');
		if (!section || !track || !pinContainer) return;

		gsap.set(track, { clearProps: "transform" });

		let scrollWidth = track.getBoundingClientRect().width;
		let totalMove = scrollWidth - window.innerWidth;

		horizontalScrollTrigger = ScrollTrigger.create({
			trigger: section,
			pin: pinContainer, 
			pinSpacing: true,  
			scrub: 0.1,
			start: 'top top',
			end: () => `+=${totalMove}`,
			invalidateOnRefresh: true,
			anticipatePin: 1, 
			animation: gsap.to(track, {
				x: () => -totalMove,
				ease: 'none'
			})
		});
	}

	function init() {
		buildHorizontalLayout();
	
		ScrollTrigger.refresh();
	}

	document.addEventListener('DOMContentLoaded', init);
	document.addEventListener('astro:page-load', init);


	document.addEventListener('astro:before-swap', () => {
		if (horizontalScrollTrigger) {
			horizontalScrollTrigger.kill(true);
		}
	});
	
	let resizeTimeout;
	window.addEventListener('resize', () => {
		clearTimeout(resizeTimeout);
		resizeTimeout = setTimeout(() => {
			buildHorizontalLayout();
			ScrollTrigger.refresh();
		}, 100);
	});
</script>
<style>
	.dashboard-section {
		position: relative;
		width: 100%;
		background-color: #FEF4EF;
		overflow: hidden;
		font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
		display: block;
		clear: both;
		z-index: 1;                
		isolation: isolate;         
		box-sizing: border-box;
	}

	.pin-container {
		width: 100%;
		height: 100vh;
		display: flex;
		align-items: center;
		position: relative;
	}

	.horizontal-scroll-track {
		display: flex;
		flex-wrap: nowrap; 
		height: 100vh;
		width: max-content;
		align-items: center;
		padding: 0 4rem;
		box-sizing: border-box;
		will-change: transform;
	}

