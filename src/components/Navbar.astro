  </a>
  
  <a href={`${import.meta.env.BASE_URL}/work`} class="nav-item">
    <span class="nav-text" data-text="Work">Work</span>
  </a>
  
  <a href={`${import.meta.env.BASE_URL}/coaching`} class="nav-item">
    <span class="nav-text" data-text="Coaching">Coaching</span>
  </a>

<a href={`${import.meta.env.BASE_URL}/quiz`} class="nav-item">
    <span class="nav-text" data-text="Scarcity Mindset Quiz">Scarcity Mindset Quiz</span>
  </a>
  
  <a href={`${import.meta.env.BASE_URL}/contact`} class="nav-button nav-button--mobile">
    <span>Get In Touch</span>
  </a>
</div>

<a href={`${import.meta.env.BASE_URL}/contact`} class="nav-button nav-button--desktop">
  <span>Get In Touch</span>
</a>
  
  <button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<script>
  const navbar = document.querySelector('.navbar');
  const menuToggle = document.querySelector('.menu-toggle');
  let lastScrollY = window.scrollY;

  menuToggle?.addEventListener('click', () => {
    const isOpen = navbar?.classList.toggle('navbar--open');
    
   
    menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  window.addEventListener('scroll', () => {
    if (navbar?.classList.contains('navbar--open')) return;
    
    if (window.scrollY < 50) {
      navbar?.classList.remove('navbar--hidden');
      return;
    }

    if (window.scrollY > lastScrollY) {
      navbar?.classList.add('navbar--hidden');
    } else {
      navbar?.classList.remove('navbar--hidden');
    }
    
    lastScrollY = window.scrollY;
  });

  const sections = document.querySelectorAll('[data-theme]');
  
  const themeObserver = new IntersectionObserver((entries) => {
   
    if (navbar?.classList.contains('navbar--open')) return;

    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const theme = entry.target.getAttribute('data-theme');
        
        navbar?.classList.remove('navbar--start', 'navbar--light', 'navbar--dark');
        
        if (theme === 'start') {
          navbar?.classList.add('navbar--start');
        } else if (theme === 'light') {
          navbar?.classList.add('navbar--light');
        } else {
          navbar?.classList.add('navbar--dark');
        }
      }
    });
  }, {
    rootMargin: '0px 0px -90% 0px'
  });

  sections.forEach(section => themeObserver.observe(section));
// ---  ACTIVE LINK LOGIC ---
  const currentPath = window.location.pathname;
  const navItems = document.querySelectorAll('.nav-item');

  navItems.forEach(item => {
    const href = item.getAttribute('href');
    

    if (currentPath === href || (href !== '/' && currentPath.startsWith(href))) {
      item.classList.add('is-active');
    } else {
      item.classList.remove('is-active');
    }
  });
</script>

