---
import forbesLogo from '../../public/images/forbes.webp';
import incLogo from '../../public/images/incmagazine.webp';
import bloombergLogo from '../../public/images/bloomberg.webp';
import NYTLogo from '../../public/images/nytimes.webp';

const staticNotes = [
  { src: forbesLogo.src, alt: "Forbes Logo", class: "static-logo-forbes", defaultColor: "#FEF08A", rotate: "-3deg" },
  { src: incLogo.src, alt: "Inc. Magazine Logo", class: "static-logo-inc", defaultColor: "#FFCFDF", rotate: "2deg" },
  { src: bloombergLogo.src, alt: "Bloomberg Logo", class: "static-logo-bloomberg", defaultColor: "#D1FAE5", rotate: "-2deg" },
  { src: NYTLogo.src, alt: "The New York Times Logo", class: "static-logo-nyt", defaultColor: "#E0F2FE", rotate: "3deg" },
];

const colorThemes = [
  { id: 'yellow', label: 'YELLOW', bg: '#FEF08A' },
  { id: 'pink', label: 'PINK', bg: '#FFCFDF' },
  { id: 'teal', label: 'TEAL', bg: '#D1FAE5' },
  { id: 'blue', label: 'BLUE', bg: '#E0F2FE' },
];
---

<section class="notebook-section">
  <div class="notebook-workspace">
    
    <div class="static-brand-container" id="notesGrid">
      {staticNotes.map((note) => (
        <div 
          class="static-brand-note" 
          style={`--static-note-default: ${note.defaultColor}; --static-note-rotate: ${note.rotate};`}
        >
          <div class="static-brand-note-inner">
            <div class="static-brand-content">
              <img src={note.src} alt={note.alt} class={`static-brand-img ${note.class}`} loading="eager" />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="notebook-tabs" id="tabsContainer">
      {colorThemes.map((theme) => (
        <button 
          class={`tab-btn tab-${theme.id}`} 
          data-color={theme.bg}
          aria-label={`Switch to ${theme.label} theme`}
        >
          <span>{theme.label}</span>
        </button>
      ))}
      <button class="tab-btn tab-reset" id="resetBtn" aria-label="Reset colors">
        <span>RESET</span>
      </button>
    </div>

  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.tab-btn:not(#resetBtn)');
  const resetBtn = document.getElementById('resetBtn');
  const grid = document.getElementById('notesGrid');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const selectedColor = tab.getAttribute('data-color');
      if (grid && selectedColor) {
        grid.style.setProperty('--static-note-override', selectedColor);
        
      
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('is-active'));
        tab.classList.add('is-active');
      }
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (grid) {
      grid.style.removeProperty('--static-note-override');
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('is-active'));
    }
  });
</script>

<style>

  .notebook-section {
    background-color: #FAF8F5;
    background-image: 
      linear-gradient(90deg, transparent 79px, #FF8A8A 79px, #FF8A8A 81px, transparent 81px),
      linear-gradient(#E2EBFE 0.15rem, transparent 0.15rem); 
    background-size: 100% 100%, 100% 2.5rem;
    padding: 6rem 4rem 6rem 8rem; 
    width: 100%;
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    border-top: 1px solid #EFEBE4;
    border-bottom: 1px solid #EFEBE4;
  }

  .notebook-workspace {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    position: relative;
  }

  .static-brand-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    width: calc(100% - 60px); 
  }


  .static-brand-note {
    background-color: var(--static-note-override, var(--static-note-default));
    aspect-ratio: 1 / 1;
    position: relative;
    transform: rotate(var(--static-note-rotate)) scale(1);
    box-sizing: border-box;
    transition: 
      background-color 0.4s ease,
      transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
      box-shadow 0.4s ease;
    
    box-shadow: 
      2px 6px 12px rgba(0, 0, 0, 0.05), 
      0 12px 24px -8px rgba(0, 0, 0, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .static-brand-note-inner {
    width: 100%;
    height: 100%;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .static-brand-content {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .static-brand-img {
    height: auto;
    max-height: 40%; 
    width: auto;
    display: block;
    object-fit: contain;
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }

  .static-brand-note:hover {
    transform: rotate(0deg) scale(1.08);
    box-shadow: 
      0 25px 30px -5px rgba(0, 0, 0, 0.1), 
      0 12px 15px -5px rgba(0, 0, 0, 0.05);
    z-index: 50; 
  }

  .static-brand-note:hover .static-brand-img {
    opacity: 1;
  }

 
  .notebook-tabs {
    position: absolute;
    right: -4rem; 
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    margin-top: 20px; 
  }

  .tab-btn {
    border: 1px solid rgba(0, 0, 0, 0.09);
    border-left: none;
    border-radius: 0 8px 14px 0; 
    width: 46px;
    height: 85px;
    cursor: pointer;
    font-size: 0.65rem;
    font-weight: 700;
    color: #4A4A4A;
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: -22px; 
    

    z-index: 20;
    box-shadow: 
      2px 4px 6px rgba(0, 0, 0, 0.04),
      inset 2px 0 3px rgba(255, 255, 255, 0.3);
    transition: 
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), 
      box-shadow 0.25s ease,
      background-color 0.2s ease;
  }


  .tab-btn span {
    writing-mode: vertical-rl;
    text-transform: uppercase;
  }


  .tab-btn::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: rgba(0, 0, 0, 0.05);
  }

  .tab-yellow { background-color: #FEF08A; z-index: 25; }
  .tab-pink   { background-color: #FFCFDF; z-index: 24; }
  .tab-teal   { background-color: #D1FAE5; z-index: 23; }
  .tab-blue   { background-color: #E0F2FE; z-index: 22; }
  .tab-reset  { 
    background-color: #FFFFFF; 
    border: 1px solid #E2E8F0; 
    border-left: none; 
    margin-bottom: 0; 
    z-index: 21;
  }


  .tab-btn.is-active {
    transform: translateX(10px);
    z-index: 40 !important; 
    box-shadow: 
      5px 8px 16px rgba(0, 0, 0, 0.15),
      inset 2px 0 4px rgba(255, 255, 255, 0.5);
    border-color: rgba(0, 0, 0, 0.15);
  }


  .tab-btn:hover:not(.is-active) {
    transform: translateX(5px);
    z-index: 39 !important; 
    box-shadow: 
      3px 6px 10px rgba(0, 0, 0, 0.08),
      inset 2px 0 3px rgba(255, 255, 255, 0.4);
  }
  
  .tab-btn:active {
    transform: translateX(2px);
  }


  .static-logo-forbes { width: 105px; }
  .static-logo-inc { width: 60px; }
  .static-logo-bloomberg { width: 115px; }
  .static-logo-nyt { width: 135px; }

  @media (max-width: 1024px) {
    .static-brand-container { gap: 1.5rem; }
  }

  @media (max-width: 768px) {
    .notebook-section {
    
      padding: 4rem 1rem 4rem 3.5rem;
      background-size: 100% 100%, 100% 2rem;
    }

    .notebook-workspace {
  
      justify-content: flex-start;
      width: 100%;
    }

    .static-brand-container {
      grid-template-columns: repeat(2, 1fr);
   
      gap: 1rem; 
      max-width: 280px; 
      width: calc(100% - 45px);
    }

    .notebook-tabs {

      right: -1rem;
    }

    .tab-btn {
      width: 32px;
      height: 60px;
      font-size: 0.5rem;
      margin-bottom: -14px;
    }

    .tab-btn.is-active {
      transform: translateX(4px);
    }

    .static-brand-note {
      transform: rotate(calc(var(--static-note-rotate) * 0.7)) scale(1); 
    }

    .static-brand-note-inner { 
      padding: 1rem; 
    }

    .static-brand-note:hover { 
      transform: rotate(0deg) scale(1.05); 
    }

 
    .static-logo-forbes { width: 75px; }
    .static-logo-inc { width: 42px; }
    .static-logo-bloomberg { width: 85px; }
    .static-logo-nyt { width: 90px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .static-brand-note, .tab-btn {
      transition: none;
      transform: none !important;
    }
  }
</style>
