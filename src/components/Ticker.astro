---
import forbesLogo from '../../public/images/forbes.webp';
import incLogo from '../../public/images/incmagazine.webp';
import bloombergLogo from '../../public/images/bloomberg.webp';
import NYTLogo from '../../public/images/nytimes.webp';

const staticNotes = [
  { src: forbesLogo.src, alt: "Forbes Logo", class: "static-logo-forbes" },
  { src: incLogo.src, alt: "Inc. Magazine Logo", class: "static-logo-inc" },
  { src: bloombergLogo.src, alt: "Bloomberg Logo", class: "static-logo-bloomberg" },
  { src: NYTLogo.src, alt: "The New York Times Logo", class: "static-logo-nyt" },
];
---

<section class="press-editorial-section" data-theme="light">
  <div class="press-container">
    <span class="press-kicker">As Featured In</span>
    
    <div class="press-grid">
      {staticNotes.map((logo) => (
        <div class="press-item">
          <div class="press-content">
            <img 
              src={logo.src} 
              alt={logo.alt} 
              class={`press-img ${logo.class}`} 
              loading="eager" 
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .press-editorial-section {
    background-color: #FFFFFF; 
    padding: 5rem 4rem;
    width: 100%;
    position: relative;
    box-sizing: border-box;
    border-top: 1px solid #EAE5E0; 
    border-bottom: 1px solid #EAE5E0;
  }

  .press-container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .press-kicker {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #8C7E6D;
  }

  .press-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
    align-items: center;
    justify-items: center;
  }

  .press-item {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .press-content {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .press-img {
    height: auto;
    width: auto;
    display: block;
    object-fit: contain;
    
    
    filter: grayscale(100%) brightness(0); 
    opacity: 0.35;
    transition: opacity 0.3s ease;
  }

  
  .press-item:hover .press-img {
    opacity: 0.85;
  }


.static-logo-forbes { width: 150px; }     
.static-logo-inc { width: 90px; }         
.static-logo-bloomberg { width: 165px; }  
.static-logo-nyt { width: 190px; }
  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .press-editorial-section {
      padding: 4rem 2rem;
    }
    
    .press-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    .press-item {
      padding: 1rem;
    }
  }

  @media (max-width: 480px) {
    .press-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .static-logo-forbes { width: 105px; }
    .static-logo-inc { width: 60px; }
    .static-logo-bloomberg { width: 115px; }
    .static-logo-nyt { width: 135px; }
  }
</style>
