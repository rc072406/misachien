---
import forbesLogo from '../../public/images/forbes.webp';
import incLogo from '../../public/images/incmagazine.webp';
import bloombergLogo from '../../public/images/bloomberg.webp';
import NYTLogo from '../../public/images/nytimes.webp';

const staticNotes = [
  { src: forbesLogo.src, alt: "Forbes Logo", class: "static-logo-forbes", color: "#FEF08A", rotate: "-3deg" },
  { src: incLogo.src, alt: "Inc. Magazine Logo", class: "static-logo-inc", color: "#FFCFDF", rotate: "2deg" },
  { src: bloombergLogo.src, alt: "Bloomberg Logo", class: "static-logo-bloomberg", color: "#D1FAE5", rotate: "-2deg" },
  { src: NYTLogo.src, alt: "The New York Times Logo", class: "static-logo-nyt", color: "#E0F2FE", rotate: "3deg" },
];
---

<section class="static-brand-section">
  <div class="static-brand-container">
    {staticNotes.map((note) => (
      <div class="static-brand-note" style={`--static-note-color: ${note.color}; --static-note-rotate: ${note.rotate};`}>
        <div class="static-brand-note-inner">
          <div class="static-brand-content">
            <img src={note.src} alt={note.alt} class={`static-brand-img ${note.class}`} loading="eager" />
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .static-brand-section {
    background-color: #FAF8F5;
    padding: 4rem 2rem; 
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    border-top: 1px solid #EFEBE4;
    border-bottom: 1px solid #EFEBE4;
  }

  .static-brand-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    max-width: 1200px; 
    width: 100%;
  }

  .static-brand-note {
    background-color: var(--static-note-color);
    aspect-ratio: 1 / 1;
    position: relative;
    transform: rotate(var(--static-note-rotate)) scale(1);
    box-sizing: border-box;
    
    box-shadow: 
      0 4px 6px -1px rgba(0, 0, 0, 0.05), 
      0 10px 20px -5px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    
    transition: 
      transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
      box-shadow 0.4s ease;
  }

  .static-brand-note-inner {
    width: 100%;
    height: 100%;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .static-brand-content {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .static-brand-img {
    height: auto;
    max-height: 40%; 
    width: auto;
    display: block;
    object-fit: contain;
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }

  .static-brand-note:hover {
    transform: rotate(0deg) scale(1.08);
    box-shadow: 
      0 20px 25px -5px rgba(0, 0, 0, 0.12), 
      0 10px 10px -5px rgba(0, 0, 0, 0.06);
    z-index: 10;
  }

  .static-brand-note:hover .static-brand-img {
    opacity: 1;
  }

  .static-logo-forbes { width: 105px; }
  .static-logo-inc { width: 60px; }
  .static-logo-bloomberg { width: 115px; }
  .static-logo-nyt { width: 135px; }

 
  @media (max-width: 1024px) {
    .static-brand-container {
      gap: 1.5rem;
    }
  }

  
  @media (max-width: 768px) {
    .static-brand-section {
      padding: 2.5rem 0; 
    }

    .static-brand-container {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 1rem 1.5rem 2rem 1.5rem; 
      gap: 1.25rem;
    }


    .static-brand-container::-webkit-scrollbar {
      display: none;
    }
    .static-brand-container {
      -ms-overflow-style: none;  
      scrollbar-width: none;  
    }

    .static-brand-note {
      flex: 0 0 140px; /* Forces them to stay as mini squares next to each other */
      scroll-snap-align: center;
      transform: rotate(calc(var(--static-note-rotate) * 0.6)) scale(1); 
    }

    .static-brand-note-inner {
      padding: 1rem; 
    }

    .static-brand-note:hover {
      transform: rotate(0deg) scale(1.04);
    }
    
 
    .static-logo-forbes { width: 75px; }
    .static-logo-inc { width: 45px; }
    .static-logo-bloomberg { width: 85px; }
    .static-logo-nyt { width: 95px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .static-brand-note {
      transition: none;
      transform: none !important;
    }
    .static-brand-note:hover {
      transform: none !important;
    }
  }
</style>
