---
interface Props {
	title: string;
}
import '../styles/global.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Misa Chien | Elevated Digital Presence" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">
	</head>
	<body>
		<nav class="navbar">
			<a href="#" class="logo">Misa Chien</a>
			<div class="nav-links">
				<a href="#section-one" class="nav-item">Lorem</a>
				<a href="#section-two" class="nav-item">Ipsum</a>
				<a href="#section-three" class="nav-item">Dolor</a>
			</div>
			<a href="#" class="nav-button">Sit Amet</a>
		</nav>

		<slot />

		<footer class="footer">
			<div class="footer-container">
				<div class="footer-brand">
					<h3 class="logo">Misa Chien</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor.</p>
				</div>
				<div class="footer-group">
					<h4>Lorem Ipsum</h4>
					<ul>
						<li><a href="#">Consectetur</a></li>
						<li><a href="#">Adipiscing Elit</a></li>
						<li><a href="#">Sed Do Eiusmod</a></li>
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>

