---
interface Props {
	title: string;
}
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Misa Chien | Elevated Digital Presence" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=GF+Didot&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">
	</head>
	<body>
	<Navbar />

		<slot />

		<footer class="footer reveal-on-scroll" >
			<div class="footer-container">
				<div class="footer-brand">
					<h3 class="logo">Misa Chien.</h3>
					<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor.</p>
				</div>
				<div class="footer-group">
					<h4>Lorem Ipsum</h4>
					<ul>
						<li><a href="#">Consectetur</a></li>
						<li><a href="#">Adipiscing Elit</a></li>
						<li><a href="#">Sed Do Eiusmod</a></li>
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>
<script>
	import { initScrollReveal } from '../scripts/scroll-reveal.js';


	initScrollReveal();
	
	
	document.addEventListener('astro:page-load', () => {
		initScrollReveal();
	});
</script>

