---
interface Props {
	title: string;
}
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Misa Chien | Mindset Coach" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Tenor+Sans&family=GF+Didot&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">
	</head>
	<body>
	<Navbar />

		<div class="main-content-wrapper">
			<slot />
		</div>

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <h3 class="logo">Misa <em>Chien.</em></h3>
      <p>The authentic leader who is known for inspiring others, and helps people feel less alone and more connected through positivity and transparency.</p>
    </div>
    <div class="footer-group">
      <h4>Let's Connect</h4>
      <ul>
        <li><a href="https://www.instagram.com/misa_chien/" target="_blank">Instagram</a></li>
        <li><a href="https://www.linkedin.com/in/misachien" target="_blank">Linkedin</a></li>
        <li><a href="https://substack.com/@misachien" target="_blank">Substack</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p class="copyright">© 2026 Misa Chien. All Rights Reserved.</p>
  </div>
</footer>
	</body>
</html>
<script>
	import { initScrollReveal } from '../scripts/scroll-reveal.js';


	initScrollReveal();
	
	
	document.addEventListener('astro:page-load', () => {
		initScrollReveal();
	});
</script>

